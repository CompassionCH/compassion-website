<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="event_compassion_public" model="ir.rule">
    <field name="name">Event website: Access Compassion event</field>
    <field name="model_id" ref="model_crm_event_compassion" />
    <field name="domain_force">[('website_published', '=', True)]</field>
    <field
      name="groups"
      eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"
    />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>
  <record id="event_registration_portal_own" model="ir.rule">
    <field name="name">Event website: own registrations</field>
    <field name="model_id" ref="model_event_registration" />
    <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>
  <!-- Portal users read their own flights and tasks. Every change goes
       through /my/events/form/..., which checks the owner (T3572). -->
  <record id="event_flight_portal_own" model="ir.rule">
    <field name="name">Event website: own flights</field>
    <field name="model_id" ref="model_event_flight" />
    <field
      name="domain_force"
    >[('registration_id.partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>
  <record id="event_registration_task_portal_own" model="ir.rule">
    <field name="name">Event website: own registration tasks</field>
    <field name="model_id" ref="model_event_registration_task_rel" />
    <field
      name="domain_force"
    >[('registration_id.partner_id', '=', user.partner_id.id)]</field>
    <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>
</odoo>
