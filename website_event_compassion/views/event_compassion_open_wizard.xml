<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Add text for donation receipts -->
  <record id="view_open_event_wizard" model="ir.ui.view">
    <field name="name">crm.event.compassion.open.wizard.form</field>
    <field name="model">crm.event.compassion.open.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="registration_fee" />
          <field
            name="product_id"
            invisible="registration_fee == 0"
            required="registration_fee &gt; 0"
          />
        </group>
        <group>
          <field name="fundraising" />
          <field
            name="donation_product_id"
            invisible="not fundraising"
            required="fundraising"
          />
          <field name="participants_amount_objective" invisible="not fundraising" />
          <field name="custom_amount_objective" invisible="not fundraising" />
          <field name="sponsorship_donation_value" invisible="not fundraising" />
        </group>
        <group>
          <field name="seats_min" />
          <field name="seats_max" />
        </group>
        <footer>
          <button
            name="open_event"
            string="Open registrations"
            class="oe_highlight"
            type="object"
          />
        </footer>
      </form>
    </field>
  </record>
</odoo>
