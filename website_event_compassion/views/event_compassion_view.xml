<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Add text for donation receipts -->
  <record id="view_muskathlon_event_website" model="ir.ui.view">
    <field name="name">crm.event.compassion.website.config.form</field>
    <field name="model">crm.event.compassion</field>
    <field name="inherit_id" ref="crm_compassion.view_events_form" />
    <field name="arch" type="xml">
      <header>
        <button
          name="open_registrations"
          string="Open registrations"
          class="oe_highlight"
          type="object"
          invisible="(not event_type_id or odoo_event_id)"
        />
      </header>
      <xpath expr="//sheet/div[1]" position="after">
        <field name="picture_1" widget="image" class="w-25" />
      </xpath>
      <div name="button_box" position="inside">
        <button
          name="open_participants"
          type="object"
          class="oe_stat_button oe_event_attendee_button"
          icon="fa-users"
          title="Participants"
          string="Participants"
          invisible="not odoo_event_id"
        />
        <button
          name="manage_event_registration"
          type="object"
          class="oe_stat_button"
          icon="fa-edit"
          string="Registration process"
          invisible="not odoo_event_id"
        />
        <field name="website_published" widget="website_redirect_button" />
      </div>
      <field name="type" position="before">
        <field name="website_id" groups="website.group_website_designer" />
        <field name="event_type_id" />
        <field name="is_trip" invisible="1" />
        <field name="trip_type_id" invisible="not is_trip" required="is_trip" />
      </field>
      <notebook>
        <page string="Trips" name="trip_communication" invisible="not is_trip">
          <div class="text-muted mb-3">
            These texts are pulled into the trip communication rules. Fill them in
            every language the participants use.
          </div>
          <separator string="Welcome sentence" />
          <field name="trip_welcome_text" nolabel="1" />
          <separator string="Recommended flights" />
          <field name="trip_flight_info" nolabel="1" />
          <separator string="Vaccination information" />
          <field name="trip_vaccination_info" nolabel="1" />
          <separator string="Visa information" />
          <field name="trip_visa_info" nolabel="1" />
        </page>
      </notebook>
    </field>
  </record>
  <!-- Let the Events team find and group trips, which the legacy Type cannot do -->
  <record id="view_event_filter_trip" model="ir.ui.view">
    <field name="name">crm.event.compassion.select.trip</field>
    <field name="model">crm.event.compassion</field>
    <field name="inherit_id" ref="crm_compassion.view_event_filter" />
    <field name="arch" type="xml">
      <field name="type" position="after">
        <field name="trip_type_id" />
      </field>
      <field name="user_id" position="after">
        <filter
          string="Trips"
          name="trips"
          domain="[('event_type_id.is_trip', '=', True)]"
        />
      </field>
      <filter name="type" position="after">
        <filter
          string="Type of Trip"
          name="group_trip_type"
          domain="[]"
          context="{'group_by': 'trip_type_id'}"
        />
      </filter>
    </field>
  </record>
  <record id="view_events_tree_trip" model="ir.ui.view">
    <field name="name">crm.event.compassion.list.trip</field>
    <field name="model">crm.event.compassion</field>
    <field name="inherit_id" ref="crm_compassion.view_events_tree" />
    <field name="arch" type="xml">
      <field name="type" position="after">
        <field name="trip_type_id" optional="hide" />
      </field>
    </field>
  </record>
  <!-- Move events into the Events App and rename the menu for better clarity between Compassion Events and Odoo Events -->
  <menuitem
    id="crm_compassion.menu_events_compassion"
    parent="event.event_main_menu"
    sequence="0"
    action="crm_compassion.action_events_compassion"
  />
  <menuitem
    id="event.menu_event_event"
    name="Registrations"
    action="event.action_event_view"
    parent="event.event_main_menu"
  />
  <record model="ir.actions.act_window" id="event.action_event_view">
    <field name="name">Registrations</field>
  </record>
</odoo>
