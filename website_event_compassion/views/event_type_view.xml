<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="event_type_form" model="ir.ui.view">
    <field name="name">event.type.form</field>
    <field name="model">event.type</field>
    <field name="inherit_id" ref="event.view_event_type_form" />
    <field name="arch" type="xml">
      <div class="oe_title" position="after">
        <group>
          <field name="compassion_event_type" />
        </group>
      </div>
      <field name="event_type_mail_ids" position="before">
        <group>
          <field name="medical_survey_id" />
          <field name="feedback_survey_id" />
        </group>
        <!--                <div class="o_setting_right_pane"/>-->
      </field>
      <xpath
        expr="//field[@name='event_type_mail_ids']//field[@name='template_ref']"
        position="attributes"
      >
        <attribute name="required">notification_type == 'mail'</attribute>
        <attribute name="invisible">notification_type != 'mail'</attribute>
      </xpath>
      <xpath
        expr="//field[@name='event_type_mail_ids']//field[@name='template_ref']"
        position="after"
      >
        <field
          name="communication_id"
          required="notification_type == 'communication'"
          invisible="notification_type != 'communication'"
        />
      </xpath>
      <xpath
        expr="//field[@name='event_type_mail_ids']//field[@name='interval_type']"
        position="after"
      >
        <field
          name="stage_id"
          domain="['|', ('event_type_ids', '=', id), ('event_type_ids', '=', False)]"
          required="interval_type == 'after_stage'"
        />
      </xpath>
      <xpath expr="/form/sheet" position="after">
        <chatter />
      </xpath>
    </field>
  </record>
</odoo>
