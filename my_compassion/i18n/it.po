#. module: my_compassion
#: model:mail.template,body_html:my_compassion.mail_details_reminder
msgid ""
"<div>\n"
"          <t t-set=\"sponsorship\" t-value=\"object.get_objects()[:1]\"/>\n"
"        </div>\n"
"        <p>\n"
"    Hello,\n"
"</p>\n"
"        <p>\n"
"    Thank you for your sponsorship! We still need to know who to thank: your name and phone number are all that is missing.\n"
"</p>\n"
"        <p>\n"
"    It takes a minute - just click the button below.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"sponsorship._my2_details_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Complete my details\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    The link works once, and only for a couple of weeks. If it has stopped working, or if you have already given us your details, you can safely ignore this email.\n"
"</p>\n"
"        <p>\n"
"    Thank you for standing with your sponsored child!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"sponsorship\" t-value=\"object.get_objects()[:1]\"/>\n"
"        </div>\n"
"        <p>\n"
"    Ciao,\n"
"</p>\n"
"        <p>\n"
"    Grazie per il tuo sostegno! Non sappiamo ancora chi ringraziare: mancano solo il tuo nome e il tuo numero di telefono.\n"
"</p>\n"
"        <p>\n"
"    Ci vuole solo un minuto - basta cliccare sul pulsante qui sotto.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"sponsorship._my2_details_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Completa i miei dati\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Il link funziona una sola volta, e solo per un paio di settimane. Se ha smesso di funzionare, o se ci hai già comunicato i tuoi dati, puoi tranquillamente ignorare questa email.\n"
"</p>\n"
"        <p>\n"
"    Grazie per essere accanto al bambino che sostieni!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

