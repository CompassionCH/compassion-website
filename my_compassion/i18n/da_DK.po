#: model_terms:ir.ui.view,arch_db:my_compassion.my2_update_card_done_page
msgid ""
"Your card was NOT updated. No amount\n"
"                  has been charged."
msgstr "Dit kort blev IKKE opdateret. Der er ikke trukket noget beløb."

#. module: my_compassion
#: model_terms:ir.ui.view,arch_db:my_compassion.my2_update_card_done_page
