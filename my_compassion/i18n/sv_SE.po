#. module: my_compassion
#: model:mail.template,body_html:my_compassion.signup_confirmation_set_password_email
msgid ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    You have recently created an account on MyCompassion.\n"
"</p>\n"
"        <p>\n"
"    To activate your account, please click the button below and set a password (minimum eight characters).\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"object.partner_id._get_signup_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Activate my account\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    If you did not expect this, you can safely ignore this email.\n"
"</p>\n"
"        <p>\n"
"    Best regards\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"partner\" t-value=\"object.partner_id\"/>\n"
"        </div>\n"
"        <p>\n"
"          <t t-out=\"partner.salutation\"/>\n"
"        </p>\n"
"        <p>\n"
"    Du har nyligen skapat ett konto på MyCompassion.\n"
"</p>\n"
"        <p>\n"
"    Klicka på knappen nedan för att aktivera ditt konto och välj ett lösenord (minst åtta tecken).\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"object.partner_id._get_signup_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Aktivera mitt konto\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Om du inte väntade dig detta kan du lugnt ignorera det här mejlet.\n"
"</p>\n"
"        <p>\n"
"    Vänliga hälsningar\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

#. module: my_compassion
#: model:mail.template,body_html:my_compassion.mail_details_reminder
msgid ""
"<div>\n"
"          <t t-set=\"sponsorship\" t-value=\"object.get_objects()[:1]\"/>\n"
"        </div>\n"
"        <p>\n"
"    Hello,\n"
"</p>\n"
"        <p>\n"
"    Thank you for your sponsorship! We still need to know who to thank: your name and phone number are all that is missing.\n"
"</p>\n"
"        <p>\n"
"    It takes a minute - just click the button below.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"sponsorship._my2_details_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Complete my details\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    The link works once, and only for a couple of weeks. If it has stopped working, or if you have already given us your details, you can safely ignore this email.\n"
"</p>\n"
"        <p>\n"
"    Thank you for standing with your sponsored child!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "
msgstr ""
"<div>\n"
"          <t t-set=\"sponsorship\" t-value=\"object.get_objects()[:1]\"/>\n"
"        </div>\n"
"        <p>\n"
"    Hej,\n"
"</p>\n"
"        <p>\n"
"    Tack för ditt fadderskap! Vi vet fortfarande inte vem vi ska tacka: allt som saknas är ditt namn och telefonnummer.\n"
"</p>\n"
"        <p>\n"
"    Det tar bara en minut - klicka bara på knappen nedan.\n"
"</p>\n"
"        <div style=\"margin:20px auto; text-align: center;\">\n"
"          <a t-att-href=\"sponsorship._my2_details_url()\" style=\"padding: 12px 18px; font-size: 12px;      line-height: 18px; color: #FFFFFF; border-color:#0054A6; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #0054A6; border: 1px solid #0054A6; border-radius:3px\" title=\"\">\n"
"        Fyll i mina uppgifter\n"
"    </a>\n"
"        </div>\n"
"        <p>\n"
"    Länken fungerar en gång, och bara i ett par veckor. Om den har slutat fungera, eller om du redan har lämnat dina uppgifter till oss, kan du tryggt ignorera det här mejlet.\n"
"</p>\n"
"        <p>\n"
"    Tack för att du står vid ditt fadderbarns sida!\n"
"</p>\n"
"        <p>\n"
"          <t t-out=\"object.user_id.signature\"/>\n"
"        </p>\n"
"      "

