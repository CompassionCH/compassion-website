<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-name="my_compassion.toast_notification_component">
    <div t-attf-class="toast-notification {{ type }}">
      <div class="toast-notification-header">
        <div class="toast-notification-title">
          <t t-if="type === 'success'">
            <i class="icon fa fa-check-circle-o" aria-hidden="true" />
          </t>
          <t t-if="type === 'danger'">
            <i class="icon fa fa-times-circle-o" aria-hidden="true" />
          </t>
          <t t-if="type === 'info'">
            <i class="icon fa fa-info-circle" />
          </t>
          <strong t-out="title" />
        </div>
      </div>
      <div class="toast-notification-content">
        <span t-out="message" />
      </div>
    </div>
  </t>
</templates>
