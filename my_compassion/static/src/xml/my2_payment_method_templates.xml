<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
        Card component for a single payment method.
        Injected data:
        - icon: ID of the payment method icon image.
        - ref_number: Reference number or last 4 digits of the card.
        - label: Display name of the payment method.
        - type: Type of the payment method
        - expire_date: Expiration date of the payment method (if applicable).
        - brand: Brand of the payment method (if applicable).
        - is_card: Boolean indicating if the payment method is a card.
        - mode_id: Unique identifier for the payment method mode.
        - selected: Boolean indicating if this payment method is currently selected.
        - group_id: ID of the associated contract group (if applicable).
    -->
    <t t-name="my_compassion.PaymentMethodCard">
        <div
                t-attf-class="payment-method-card d-flex align-items-center p-3 mb-2 border
         rounded cursor-pointer position-relative bg-white transition-all
          #{selected ? 'selected border-core-blue bg-light-blue' : 'border-gray-200 hover-shadow-sm'}"
                onclick="$(this).find('input[type=radio]').prop('checked', true).trigger('change');"
        >
            <!--Hidden Radio Input (Functional but invisible)-->
            <div class="d-none">
                <input
                        type="radio"
                        name="payment_method_selection"
                        t-att-id="'pm_' + (type || 'token') + '_' + (mode_id || group_id)"
                        t-att-group-id="group_id || undefined"
                        t-att-checked="selected ? 'checked' : undefined"
                />
            </div>
            <!-- Icon -->
            <div
                    class="icon-wrapper mr-3 d-flex align-items-center justify-content-center bg-white"
                    style="width: 50px; height: 32px;"
            >
                <t t-if="icon">
                    <img
                            t-attf-src="/web/image?model=payment.icon&amp;id=#{icon}&amp;field=image"
                            class="img-fluid"
                            style="max-height: 100%; max-width: 100%; object-fit: contain;"
                            alt="Icon"
                            onerror="this.style.display='none'"
                    />
                </t>
                <t t-elif="is_card">
                    <!-- Fallback generic card icon if no specific icon is found -->
                    <i class="fa fa-credit-card text-muted fa-2x" />
                </t>
            </div>
            <!-- Info -->
            <div class="flex-grow-1">
                <div class="font-weight-bold text-dark-blue leading-tight">
                    <t t-esc="label" />
                </div>
                <!-- Subtitle Logic: Ref Number or Expire Date or Brand -->
                <div class="small text-muted mt-1">
                    <t t-if="ref_number">
                        <span class="mr-1">
                            <t t-if="is_card">Card: </t>
                            <t t-else="">Ref: </t>
                            <t t-esc="ref_number" />
                        </span>
                    </t>
                    <t t-if="is_card and expire_date">
                        <span class="ml-2 border-left pl-2">
                            Exp: <t t-esc="expire_date" />
                        </span>
                    </t>
                </div>
            </div>
            <!-- Checkmark for Selected State -->
            <t t-if="is_card">
                <button
                        type="button"
                        class="btn btn-sm btn-danger btn-debug-charge ml-2"
                        t-att-data-group-id="group_id"
                        title="Test Charge 1.00"
                >
                    <i class="fa fa-bolt"/> Test
                </button>
            </t>
            <t t-if="selected">
                <i class="fa fa-check-circle text-core-blue ml-3" />
            </t>


        </div>
    </t>
    <!-- Loading Template -->
    <t t-name="my_compassion.PaymentMethodLoading">
        <div class="text-center p-4">
            <i class="fa fa-circle-o-notch fa-spin fa-2x text-core-blue mb-2" />
            <p class="text-muted small">Loading payment methods...</p>
        </div>
    </t>
    <!--
        Accordion component for updating or switching payment methods.
        Contains two sections:
        1. Update Current Details (expanded by default)
        2. Switch Payment Method (collapsed by default)
        The switch payment method section will be populated dynamically via JS.
    -->
    <t t-name="my_compassion.PaymentMethodUpdateAccordion">
        <div id="payment_method_accordion" class="accordion">
            <!-- Section 1: Update Details -->
            <div class="border-bottom mb-2">
                <div class="card-header bg-white border-0 p-0" id="headingForm">
                    <h5 class="mb-0">
                        <button
                                class="btn btn-link btn-block text-left text-dark-blue font-weight-bold d-flex justify-content-between align-items-center text-decoration-none"
                                type="button"
                                data-toggle="collapse"
                                data-target="#collapseForm"
                                aria-expanded="true"
                                aria-controls="collapseForm"
                        >
                            <span>Update Current Details</span>
                            <i class="fa fa-chevron-down small oe_accordion_arrow" />
                        </button>
                    </h5>
                </div>
                <div
                        id="collapseForm"
                        class="collapse show"
                        aria-labelledby="headingForm"
                        data-parent="#payment_method_accordion"
                >
                    <div class="pt-3 pl-1 pr-1">
                        <!-- Calls the form template with current scope's data (group_info) -->
                        <t t-call="my_compassion.PaymentMethodUpdateForm" />
                    </div>
                </div>
            </div>
            <!-- Section 2: Switch Method -->
            <div class="border-bottom">
                <div class="card-header bg-white border-0 p-0" id="headingList">
                    <h5 class="mb-0">
                        <button
                                class="btn btn-link btn-block text-left text-dark-blue font-weight-bold d-flex justify-content-between align-items-center text-decoration-none collapsed"
                                type="button"
                                data-toggle="collapse"
                                data-target="#collapseList"
                                aria-expanded="false"
                                aria-controls="collapseList"
                        >
                            <span>Switch Payment Method</span>
                            <i class="fa fa-chevron-down small oe_accordion_arrow" />
                        </button>
                    </h5>
                </div>
                <div
                        id="collapseList"
                        class="collapse"
                        aria-labelledby="headingList"
                        data-parent="#payment_method_accordion"
                >
                    <div class="pt-3" id="payment_methods_switch_container" />
                </div>
            </div>
        </div>
    </t>

    <t t-name="my_compassion.FormFieldComponent">
        <div t-attf-class="form-field-container mb-3 #{top_class || ''}">
            <t t-if="label">
                <label t-att-for="name" class="text-core-blue body-small bold mb-1">
                    <t t-esc="label" />
                </label>
            </t>
            <!-- Slot content is simulated by passing value/placeholder -->
            <input
                    type="text"
                    t-att-name="name"
                    t-att-id="name"
                    t-attf-class="form-control #{input_class || ''}"
                    t-att-value="value"
                    t-att-placeholder="placeholder || ''"
                    t-att-disabled="disabled"
            />
            <t t-if="invalid_hint">
                <div class="invalid-hint text-mid-orange tiny-text mb-1 d-none">
                    <t t-esc="invalid_hint" />
                </div>
            </t>
        </div>
    </t>
    <!--
        Payment Method Update Form
        Injected data :
        - ref_number: Reference number or last 4 digits of the card.
    -->
    <t t-name="my_compassion.PaymentMethodUpdateForm">
        <div class="payment-update-form text-left">
            <!-- Fallback for non-card methods (like LSV, BVR reference) -->
            <t t-call="my_compassion.FormFieldComponent">
                <t t-set="label">
                    <t t-if="is_card">Card Number</t>
                    <t t-else="">Reference Number</t>
                </t>
                <t t-set="name">ref_number</t>
                <t t-set="value" t-value="ref_number" />
                <t t-set="disabled" t-value="is_card ? 'disabled' : undefined"/>
            </t>

            <t t-if="is_card">
                <p class="text-muted small mt-n2 mb-3">
                    To change your card details, please switch to a new payment method below.
                </p>
            </t>
        </div>
    </t>
</templates>
