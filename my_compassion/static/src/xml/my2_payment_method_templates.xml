<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!--
        Card component for a single payment method.
        Injected data:
        - icon: ID of the payment method icon image.
        - ref_number: Reference number or last 4 digits of the card.
        - label: Display name of the payment method.
        - type: Type of the payment method.
        - expire_date: Expiration date of the payment method (if applicable).
        - brand: Brand of the card (if applicable).
        - is_card (Boolean): Flag indicating if the payment method is a card.
        - group_id: The group ID associated with this payment method.
        - mode_id: The mode ID associated with this payment method.
        - selected (Boolean): A flag indicating if this specific payment method is currently selected.
    -->
    <t t-name="my_compassion.PaymentMethodList">
        <div class="payment-methods-list">
            <t t-foreach="methods" t-as="method_item">
                <t t-call="my_compassion.PaymentMethodCard">
                    <t t-set="method" t-value="method_item"/>
                    <t t-set="selected" t-value="method_item.group_id == current_group_id"/>
                </t>
            </t>
        </div>
    </t>

    <t t-name="my_compassion.PaymentMethodCard">
        <div
            t-attf-class="payment-method-card d-flex align-items-center p-3 mb-2 border
         rounded cursor-pointer position-relative bg-white transition-all
          #{selected ? 'selected border-core-blue bg-light-blue' : 'border-gray-200 hover-shadow-sm'}"
            onclick="$(this).find('input[type=radio]').prop('checked', true).trigger('change');"
        >
            <div class="d-none">
                <input
                    type="radio"
                    name="payment_method_selection"
                    t-att-id="'pm_' + (method.type || 'token') + '_' + (method.mode_id || method.group_id)"
                    t-att-group-id="method.group_id || undefined"
                    t-att-checked="selected ? 'checked' : undefined"
                />
            </div>

            <div
                class="icon-wrapper mr-3 d-flex align-items-center justify-content-center bg-white"
                style="width: 50px; height: 32px;"
            >
                <t t-if="method.icon">
                    <img
                        t-attf-src="/web/image?model=payment.icon&amp;id=#{method.icon}&amp;field=image"
                        class="img-fluid"
                        style="max-height: 100%; max-width: 100%; object-fit: contain;"
                        alt="Icon"
                        onerror="this.style.display='none'"
                    />
                </t>
                <t t-elif="method.is_card">
                    <i class="fa fa-credit-card text-muted fa-2x" />
                </t>
            </div>

            <div class="flex-grow-1">
                <div class="font-weight-bold text-dark-blue leading-tight">
                    <t t-esc="method.label" />
                </div>
                <div class="small text-muted mt-1">
                    <t t-if="method.ref_number">
                        <span class="mr-1">
                            <t t-if="method.is_card">Card:</t>
                            <t t-else="">Ref:</t>
                            <t t-esc="method.ref_number" />
                        </span>
                    </t>
                    <t t-if="method.is_card and method.expire_date">
                        <span class="ml-2 border-left pl-2">
                            Exp:
                            <t t-esc="method.expire_date" />
                        </span>
                    </t>
                </div>
            </div>

            <t t-if="selected">
                <i class="fa fa-check-circle text-core-blue ml-3" />
            </t>
        </div>
    </t>

    <t t-name="my_compassion.PaymentMethodLoading">
        <div class="text-center p-4">
            <i class="fa fa-circle-o-notch fa-spin fa-2x text-core-blue mb-2" />
            <p class="text-muted small">Loading payment methods...</p>
        </div>
    </t>

    <t t-name="my_compassion.PaymentMethodUpdateAccordion">
        <div id="payment_method_switch_wrapper">
            <div class="pt-2" id="payment_methods_switch_container" />
        </div>
    </t>

    <t t-name="my_compassion.FormFieldComponent">
        </t>

</templates>