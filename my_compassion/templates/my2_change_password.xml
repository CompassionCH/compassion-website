<odoo>
    <template id="my2_change_password_fullpage" inherit_id="portal.portal_my_security"
              website_id="my_compassion.my2_website">
        <xpath expr="t" position="replace">
            <t t-call="website.layout">
                <div class="container col-lg-6 mx-auto">

                    <!-- Change password -->
                    <form action="/my/security" method="post"
                          class="oe_reset_password_form">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="op" value="password"/>

                        <div class="mt-4 text-center text-core-blue body-large bold">
                            Change password</div>

                        <!-- Success/Error -->
                        <div class="alert alert-success" role="alert"
                             t-if="success and success.get('password')">
                            Password Updated Successfully!
                        </div>
                        <div class="alert alert-danger" role="alert"
                             t-if="get_error(errors, 'password.old')">
                            <t t-esc="get_error(errors, 'password.old')"/>
                        </div>
                        <div class="alert alert-danger" role="alert"
                             t-if="get_error(errors, 'password.new1')">
                            <t t-esc="get_error(errors, 'password.new1')"/>
                        </div>
                        <div class="alert alert-danger" role="alert"
                             t-if="get_error(errors, 'password.new2')">
                            <t t-esc="get_error(errors, 'password.new2')"/>
                        </div>


                        <!-- Current password -->
                        <t t-call="theme_compassion_2025.FormFieldComponent">
                            <t t-set="top_class" t-value="'mt-3'"/>
                            <t t-set="label" t-value="'Current password'"/>
                            <input type="password" name="old"
                                   class="form-control form-control-sm"
                                   id="current" required="required"
                                   autocomplete="current-password"/>
                        </t>

                        <!-- New password -->
                        <t t-call="theme_compassion_2025.FormFieldComponent">
                            <t t-set="top_class" t-value="'mt-3'"/>
                            <t t-set="label" t-value="'New password'"/>
                            <input type="password" name="new1"
                                   class="form-control form-control-sm"
                                   id="new" required="required"
                                   autocomplete="new-password"/>
                        </t>

                        <!-- Confirm new password -->
                        <t t-call="theme_compassion_2025.FormFieldComponent">
                            <t t-set="top_class" t-value="'mt-3'"/>
                            <t t-set="label" t-value="'Verify new password'"/>
                            <input type="password" name="new2"
                                   class="form-control form-control-sm"
                                   id="new2" required="required"
                                   autocomplete="new-password"/>
                        </t>

                        <!-- Change password button -->
                        <div class="mt-3 d-flex flex-column align-items-stretch">
                            <button type="submit" class="btn p-0">
                                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                    <t t-set="variant" t-value="'compact'"/>
                                    <t t-set="variation" t-value="'filled'"/>
                                    <t t-set="radius" t-value="'small'"/>
                                    <t t-set="label" t-value="'Change password'"/>
                                    <t t-set="color" t-value="'core-blue'"/>
                                    <t t-set="icon_color" t-value="'pure-white'"/>
                                    <t t-set="text_color" t-value="'pure-white'"/>
                                </t>
                            </button>
                        </div>
                    </form>

                    <!-- Two Factor Authentication -->
                    <t t-if="request.env.user.has_group('base.group_user')">
                        <div class="row justify-content-center">
                            <div class="col-lg-3">
                                <div class="text-center text-core-blue body-large bold">
                                    Two
                                    Factor Authentication
                                </div>

                                <t t-if="not user_id.totp_enabled">
                                    <div class="alert alert-info text-center mt-2">
                                        Two-factor authentication is not enabled.
                                    </div>
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div class="mt-3 d-flex flex-column align-items-stretch">
                                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                            <t t-set="id"
                                               t-value="'auth_totp_portal_enable'"/>
                                            <t t-set="variant" t-value="'compact'"/>
                                            <t t-set="variation"
                                               t-value="'filled'"/>
                                            <t t-set="radius" t-value="'small'"/>
                                            <t t-set="label"
                                               t-value="'Enable 2FA'"/>
                                            <t t-set="color" t-value="'core-blue'"/>
                                            <t t-set="icon_color"
                                               t-value="'pure-white'"/>
                                            <t t-set="text_color"
                                               t-value="'pure-white'"/>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <p class="mt-2 text-center alert alert-success">
                                        2FA is enabled.
                                    </p>
                                    <input type="hidden" name="csrf_token"
                                           t-att-value="request.csrf_token()"/>
                                    <div class="mt-3 d-flex flex-column align-items-stretch">
                                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                            <t t-set="id"
                                               t-value="'auth_totp_portal_disable'"/>
                                            <t t-set="variant" t-value="'compact'"/>
                                            <t t-set="variation"
                                               t-value="'filled'"/>
                                            <t t-set="radius" t-value="'small'"/>
                                            <t t-set="label"
                                               t-value="'Disable 2FA'"/>
                                            <t t-set="color" t-value="'core-blue'"/>
                                            <t t-set="icon_color"
                                               t-value="'pure-white'"/>
                                            <t t-set="text_color"
                                               t-value="'pure-white'"/>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
