<odoo>
    <template id="my2_button_styles"
              inherit_id="portal.portal_my_security"
              website_id="my_compassion.my2_website">

        <!-- Change password form fields -->
        <xpath expr="//div[contains(@class, 'form-group') and .//input[@id='current']]"
               position="replace">
            <div class="col-lg-8" >
            <t t-call="theme_compassion_2025.FormFieldComponent">
                <t t-set="label" t-value="'Current password'"/>
                <t t-set="input_id" t-value="'current'"/>
                <t t-set="invalid_hint" t-value="get_error(errors, 'password.old')"/>
                <input type="password"
                       t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.old') else '' }}"
                       id="current" name="old"
                       autocomplete="current-password" required="required"/>
            </t>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'form-group') and .//input[@id='new']]"
               position="replace">
            <div class="col-lg-8" >
            <t t-call="theme_compassion_2025.FormFieldComponent">
                <t t-set="label" t-value="'New Password'"/>
                <t t-set="input_id" t-value="'new'"/>
                <t t-set="invalid_hint" t-value="get_error(errors, 'password.new1')"/>
                <input type="password"
                       t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.new1') else '' }}"
                       id="new" name="new1"
                       autocomplete="new-password" required="required"/>
            </t>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'form-group') and .//input[@id='new2']]"
               position="replace">
            <div class="col-lg-8" >
            <t t-call="theme_compassion_2025.FormFieldComponent">
                <t t-set="label" t-value="'Verify New Password'"/>
                <t t-set="input_id" t-value="'new2'"/>
                <t t-set="invalid_hint" t-value="get_error(errors, 'password.new2')"/>
                <input type="password"
                       t-attf-class="form-control form-control-sm {{ 'is-invalid' if get_error(errors, 'password.new2') else '' }}"
                       id="new2" name="new2"
                       autocomplete="new-password" required="required"/>
            </t>
            </div>
        </xpath>

        <!-- Change password button -->
        <xpath expr="//form[@class='oe_reset_password_form']//button[@type='submit']"
               position="replace">
            <div class="col-lg-8" >
            <button type="submit" class="btn p-0">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'compact'"/>
                    <t t-set="variation" t-value="'filled'"/>
                    <t t-set="radius" t-value="'small'"/>
                    <t t-set="label" t-value="'Change password'"/>
                    <t t-set="color" t-value="'core-blue'"/>
                    <t t-set="icon_color" t-value="'pure-white'"/>
                    <t t-set="text_color" t-value="'pure-white'"/>
                </t>
            </button>
            </div>
        </xpath>

        <!-- Enable 2FA button -->
        <xpath expr="//button[@id='auth_totp_portal_enable']" position="replace">
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="id" t-value="'auth_totp_portal_enable'"/>
                <t t-set="type" t-value="'button'"/>
                <t t-set="variant" t-value="'compact'"/>
                <t t-set="variation" t-value="'filled'"/>
                <t t-set="radius" t-value="'small'"/>
                <t t-set="label" t-value="'Enable 2FA'"/>
                <t t-set="color" t-value="'core-blue'"/>
                <t t-set="icon_color" t-value="'pure-white'"/>
                <t t-set="text_color" t-value="'pure-white'"/>
            </t>
        </xpath>


        <!-- Disable 2FA button -->
        <xpath expr="//button[@id='auth_totp_portal_disable']" position="replace">
            <button type="button" id="auth_totp_portal_disable" class="btn p-0">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="id" t-value="'auth_totp_portal_enable'"/>
                    <t t-set="type" t-value="'button'"/>
                    <t t-set="variant" t-value="'compact'"/>
                    <t t-set="variation" t-value="'filled'"/>
                    <t t-set="radius" t-value="'small'"/>
                    <t t-set="label" t-value="'Disable 2FA'"/>
                    <t t-set="color" t-value="'core-blue'"/>
                    <t t-set="icon_color" t-value="'pure-white'"/>
                    <t t-set="text_color" t-value="'pure-white'"/>
                </t>
            </button>
        </xpath>

    </template>
</odoo>
