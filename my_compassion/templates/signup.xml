<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="signup_sponsor"
    inherit_id="auth_signup.fields"
    name="Signup Password Controls"
    website_id="website.default_website"
  >
    <xpath expr="//input[@name='password']" position="inside">
      <i
        class="fa fa-eye"
        id="eye_password"
        style="position: absolute; right: 10px; top: 67%; cursor: pointer;"
      />
    </xpath>
    <xpath expr="//input[@name='confirm_password']" position="inside">
      <i
        class="fa fa-eye"
        id="eye_confirm_password"
        style="position: absolute; right: 10px; top: 61%;cursor: pointer;"
      />
    </xpath>
  </template>
  <template
    id="signup_consent"
    inherit_id="auth_signup.fields"
    name="Signup Privacy Policy"
    priority="50"
  >
    <xpath expr="." position="inside">
      <div t-if="signup_consent_required" class="mt-3 d-flex">
        <t
          t-set="my2_consent_style"
          t-value="website == request.env.ref('my_compassion.my2_website')"
        />
        <input
          type="checkbox"
          value="accepted"
          id="privacy_policy"
          name="privacy_policy"
          t-att-class="'mx-2' if my2_consent_style else 's_website_form_input form-check-input me-2'"
          required="required"
        />
        <label
          t-att-class="'mb-0 tiny-text' if my2_consent_style else 'form-check-label'"
          for="privacy_policy"
        >
          <t t-call="my_compassion.acceptance_full" />
        </label>
      </div>
    </xpath>
  </template>
</odoo>
