<?xml version="1.0" encoding="utf-8" ?>
<!--
    Description:

     Injected data:
    - modal_type: Type of modal to display (update, add, change).
    - payment_methods: List of available payment methods to choose from (in case of 'change' and 'update' modals).

-->
<odoo>
    <template id="my2_payment_method_selector" name="Payment Method Selector Component">
        <div class="modal fade"
             t-att-id="'payment_method_selector_modal_' + modal_type"
             t-att-data-modal-type="modal_type"
             t-att-data-payment-methods="json.dumps(payment_methods) if payment_methods else None"
             tabindex="-1"
             role="dialog"
             aria-hidden="true"
        >

            <div class="modal-dialog modal-dialog-centered" role="document">

                <div class="modal-content border-0">
                    <div class="p-0 m-0">
                        <h3 class="text-center text-core-blue pb-2 pt-3">
                            <t t-if="modal_type == 'update'">
                                Update Payment Method
                            </t>
                            <t t-elif="modal_type == 'add'">
                                Add Payment Method
                            </t>
                            <t t-elif="modal_type == 'change'">
                                Change Payment Method
                            </t>
                        </h3>

                        <div class="pl-4 pr-4 pt-3">
                            <form id="payment_method_form">
                                <input type="hidden" name="contract_group_id" id="selected_contract_group_id"/>
                                <div>
                                    <t t-if="modal_type == 'update'">
                                        <p class="text-center text-muted mb-3">
                                            Update your payment method details below.
                                        </p>
                                    </t>
                                    <t t-elif="modal_type == 'add'">
                                        <p class="text-center text-muted mb-3">
                                            Add a new payment method to your account.
                                        </p>
                                    </t>
                                    <t t-elif="modal_type == 'change'">
                                        <p class="text-center text-muted mb-3"
                                           id="modal_description"
                                        >
                                            Select a new payment method from the options below.
                                        </p>
                                    </t>
                                </div>
                            </form>

                            <t t-if="modal_type == 'change' or modal_type == 'update'">
                                <!-- Container for Dynamic Cards -->
                                <div id="modal_container" class="mb-3">
                                    <!-- JS will inject templates here -->
                                </div>

                            </t>
                            <div class="modal-footer border-top-0">
                                <a href="#" data-dismiss="modal">
                                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                        <t t-set="variant" t-value="'compact'"/>
                                        <t t-set="variation" t-value="'hollow'"/>
                                        <t t-set="label" t-value="'Cancel'"/>
                                        <t t-set="color" t-value="'core-blue'"/>
                                        <t t-set="text_color" t-value="'core-blue'"/>
                                    </t>
                                </a>

                                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                    <t t-set="variant" t-value="'compact'"/>
                                    <t t-set="variation" t-value="'filled'"/>
                                    <t t-set="label" t-value="'Save Changes'"/>
                                    <t t-set="color" t-value="'core-blue'"/>
                                    <t t-set="text_color" t-value="'white'"/>
                                    <t t-set="id" t-value="'btn_save_payment_method'"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>