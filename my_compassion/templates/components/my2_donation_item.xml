<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Donation Item

    Description:
    An item representing a donation/sponsorship the user will pay, has paid or is paying for.

    Button:                                                                                  Default:
    - icon (string): The button icon.                                                        [none]
    - pictogram (string): The button pictogram.                                              [none]
    - label (string): The button label.                                                      [none]
    - color (string): The button color.                                                      [dark-blue]
    - action (string): Either 'link' or 'event'.                                             [none]
    - href (string) [only if action='link']: The url of the link.                            ['']
    - custom_event (string) [only if action='event']: The custom event name.                 [{}]
    - detail (dict) [only if action='event']: A custom object to set as the event detail.    [{}]

    Props:                                                                                   Default:
    - name (string): Item name.                                                              -required-
    - image (string): Item image src.                                                        -required-
    - price (float): Item price.                                                             -required-
    - currency_name (str): Currency name                                                     -required-
    - primary_button (dict): Primary button with custom action (see Button).                 [none]
    - recipient (string): Item recipient.                                                    [none]
    - subtext (string): Text under name and recipient.                                       [none]
    - title_color (string): Color of the title.                                              [dark-blue]
    - accent_color (string): Color of the left border accent.                                [dark-blue]
    - price_color (string): Color of the price.                                              [dark-blue]
    - recipient_color (string): Color of the recipient.                                      [dark-blue]
    - bg_color (string): Background color.                                                   [high-blue]
    - monthly (bool): Whether the price is paid monthly (with abbreviation).                 [False]
    - monthly_noabbr (bool): Whether the price is paid monthly (no abbreviation).            [False]
    - secondary_buttons (list[dict]): Secondary buttons with custom actions (see Button).    [none]
    - top_class (string): Classes to add to the top element of the item.                     [none]
-->
<odoo>
    <!-- DONATION ITEM BUTTON -->
    <template id="DonationItemButton" name="Donation Item Button">
        <t t-set="color" t-value="button.get('color') or 'dark-blue'" />
        <t t-if="button.get('action') == 'link'" t-set="onclick" t-valuef="location.href='#{button.get('href')}'" />
        <t
            t-elif="button.get('action') == 'event'"
            t-set="onclick"
            t-valuef="this.dispatchEvent(new CustomEvent('#{button.get('custom_event')}', {bubbles: true, detail: #{button.get('detail')}}))"
        />
        <div t-attf-class="action-button #{button_top_class}" t-att-onclick="onclick">
            <i t-if="button.get('icon')" t-attf-class="tiny-text icon-#{button.get('icon')} text-#{color}" />
            <i
                t-if="button.get('pictogram')"
                t-attf-class="tiny-text pictogram-#{button.get('pictogram')} text-#{color}"
            />
            <span t-if="button.get('label')" t-attf-class="tiny-text bold text-#{color}">
                <t t-esc="button.get('label')" />
            </span>
        </div>
    </template>
    <!-- DONATION ITEM COMPONENT -->
    <template id="DonationItemComponent" name="Donation Item Component">
        <!-- Default property values -->
        <t t-set="title_color" t-value="title_color or 'dark-blue'" />
        <t t-set="accent_color" t-value="accent_color or 'dark-blue'" />
        <t t-set="price_color" t-value="price_color or 'dark-blue'" />
        <t t-set="recipient_color" t-value="recipient_color or 'dark-blue'" />
        <t t-set="subtext_color" t-value="subtext_color or 'dark-blue'" />
        <t t-set="bg_color" t-value="bg_color or 'high-blue'" />
        <t t-set="monthly" t-value="monthly == True" />
        <t t-set="monthly_noabbr" t-value="monthly_noabbr == True" />
        <t t-set="secondary_buttons" t-value="secondary_buttons or []" />
        <!-- Estimate component minimum width -->
        <t t-set="min_width" t-valuef="#{300 + 24 * len(secondary_buttons)}px" />
        <!--Small image on the card  -->
        <t t-set="small_thumbnail_content">
            <div
                class="thumbnail responsive-sm mr-3 flex-shrink-0 rounded-lg"
                t-attf-style="--image_url: url('#{image}');"
            />
        </t>
        <div
            t-attf-class="donation-item-container p-2 d-flex rounded-lg bg-#{bg_color} border-#{accent_color} #{top_class}"
            t-attf-style="min-width: #{min_width}"
        >
            <div
                class="thumbnail responsive-lg mr-3 flex-shrink-0 rounded-lg"
                t-attf-style="--image_url: url('#{image}');"
            />
            <t t-if="not primary_button" t-raw="small_thumbnail_content" />
            <div class="w-100 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-start">
                    <t t-if="primary_button" t-raw="small_thumbnail_content" />
                    <div class="flex-grow-1 d-flex flex-column">
                        <div t-attf-class="text-#{title_color} body-large bold">
                            <t t-esc="name" />
                        </div>
                        <div t-if="recipient" t-attf-class="text-#{recipient_color} body-small bold">
                            To
                            <t t-esc="recipient" />
                        </div>
                        <div t-if="subtext" t-attf-class="text-#{subtext_color} body-small bold">
                            <t t-esc="subtext" />
                        </div>
                    </div>
                    <t t-foreach="secondary_buttons" t-as="button">
                        <t t-call="my_compassion.DonationItemButton">
                            <t t-set="button_top_class" t-value="'ml-2'" />
                        </t>
                    </t>
                </div>
                <div t-attf-class="mt-2 d-flex justify-content-#{'between' if primary_button else 'end'}">
                    <t t-if="primary_button" t-call="my_compassion.DonationItemButton">
                        <t t-set="button" t-value="primary_button" />
                    </t>
                    <div t-attf-class="text-#{price_color} ">
                        <t t-esc="currency_name" />
                        <t t-if="price % 1 == 0" t-set="price" t-value="'{0}.-'.format(int(price))" />
                        <t t-else="" t-set="price" t-value="'{0:.2f}'.format(price)" />
                        <t t-if="monthly" t-set="monthly">/mo.</t>
                        <t t-elif="monthly_noabbr">
                            <t t-set="monthly"> /month</t>
                        </t>
                        <t t-else="" t-set="monthly"></t>
                        <t t-esc="price + monthly" />
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
