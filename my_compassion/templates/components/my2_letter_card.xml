<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Letter Card

    Description:
    Displays a letter in a card format with an envelope icon on the left and letter details on the right.
    Includes buttons to view or download the letter.

    Props:
    - letter (record): The related letter object.
-->
<odoo>
  <template id="my2_letter_card_component" name="Letter Card Component">
    <t t-set="child" t-value="letter.child_id" />
    <t
      t-set="is_from_supporter"
      t-value="letter.direction == 'Supporter To Beneficiary'"
    />
    <div
      t-attf-class="position-relative d-flex shadow rounded-4 h-100 {{'bg-high-green' if is_from_supporter else 'bg-high-blue'}}"
    >
      <!-- Icon at the left -->
      <div>
        <div
          id="envelope-{{ letter.uuid }}"
          t-attf-class="ms-2 mt-4 my2-envelope {{ 'already-read' if letter.email_read else '' }} {{ 'envelope--green' if is_from_supporter else 'envelope--blue' }}"
          t-attf-href="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf"
          t-att-data-letter-id="letter.id"
          t-att-data-letter-read="letter.email_read"
          t-att-data-letter-uuid="letter.uuid"
          data-bs-target="_blank"
        >
          <div class="env-body" />
          <div class="env-letter">
            <!-- Letter preview.
                 Read letters carry the preview in data-src; my2_child_letters.js
                 promotes it to src via IntersectionObserver only when the card nears
                 the viewport, so a page of read letters doesn't fire N heavy
                 /b2s_image PDF requests at once
                 Unread letters get their iframe injected on envelope click. -->
            <div class="iframe-container">
              <t t-if="letter.email_read">
                <iframe
                  t-attf-data-src="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf"
                  type="application/pdf"
                  loading="lazy"
                />
              </t>
            </div>
          </div>
          <div class="env-pocket" />
          <div class="env-flap" />
        </div>
      </div>
      <!-- Text block at the right -->
      <div class="flex-grow-1 d-flex flex-column ms-2 me-2 mb-2 mt-4">
        <!-- Top row: Title (left) and Dropdown (right) -->
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div class="h5 text-off-black">
            <t t-if="not is_from_supporter">
              <span>From</span>
              <t t-out="child.preferred_name" />
            </t>
            <t t-else="">
              <span>To</span>
              <t t-out="child.preferred_name" />
            </t>
          </div>
          <!-- Dots button & dropdown menu -->
          <div class="dropdown">
            <button
              t-attf-class="btn btn-link p-0 border-0 {{'text-low-green' if is_from_supporter else 'text-low-blue'}}"
              type="button"
              t-att-id="'dropdownMenuButton' + str(letter.id)"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              <span class="icon-dots-vertical" />
            </button>
            <div
              class="dropdown-menu border-low-black"
              t-att-aria-labelledby="'dropdownMenuButton' + str(letter.id)"
            >
              <a
                class="dropdown-item d-flex align-items-center pt-0 pb-0 ps-3 pe-3"
                t-attf-href="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf"
                t-att-target="'_blank'"
                rel="noopener noreferrer"
              >
                                Preview
                                <i class="icon-eye ms-auto" />
                            </a>
              <div class="dropdown-divider border-low-black" />
              <a
                class="dropdown-item d-flex align-items-center pt-0 pb-0 ps-3 pe-3"
                t-attf-href="/b2s_image?id={{letter.uuid}}"
                t-attf-download="{{letter.name}}"
              >
                                Download
                                <i class="icon-download01 ms-auto" />
                            </a>
              <div class="dropdown-divider border-low-black" />
              <a
                class="dropdown-item d-flex align-items-center pt-0 pb-0 ps-3 pe-3"
                t-attf-href="/my2/children/letters/new{{ '?child_id=' + str(child.id)}}"
              >
                                Reply
                                <i class="icon-pencil02 ms-auto" />
                            </a>
              <div class="dropdown-divider border-low-black" />
              <a
                class="dropdown-item d-flex align-items-center pt-0 pb-0 ps-3 pe-3 js_share_letter"
                href="javascript:void(0);"
                t-att-data-share-url="request.httprequest.url_root + 'b2s_image?id=%s&amp;disposition=inline&amp;file_type=pdf' % letter.uuid"
                t-attf-data-share-title="Letter from #{child.preferred_name}"
                t-attf-data-share-text="Check out this letter from #{child.preferred_name}!"
                role="button"
              >
                                Share
                                <i class="icon-share06 ms-auto" />
                            </a>
            </div>
          </div>
        </div>
        <!-- Letter date -->
        <div class="mt-auto align-self-end tiny-text text-low-grey">
          <span
            t-field="letter.create_date"
            t-options='{"widget": "date","format": "dd MMM. yyyy"}'
          />
        </div>
      </div>
    </div>
  </template>
</odoo>
