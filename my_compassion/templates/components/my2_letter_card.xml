<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Letter Card

    Description:
    Displays a letter in a card format with an envelope icon on the left and letter details on the right.
    Includes buttons to view or download the letter.

    Props:
    - letter (record): The related letter object.
    - child (record): The child associated with the letter.
-->


<odoo>
    <template id="my2_letter_card_component" name="Letter Card Component">
        <link rel="stylesheet" href="/my_compassion/static/src/css/letter_card.css"/>
        <div class="position-relative d-flex shadow-sm rounded-4  h-100">

            <!-- Icon at the left -->
            <div class="envelope">
                <div id="envelope-{{ letter.uuid }}"
                     t-attf-class="ml-2 mt-4 my2-envelope {{ 'envelope--blue' if letter.direction != 'Supporter To Beneficiary' else 'envelope--green' }}"
                     t-attf-href="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf">
                    <div class="env-body"></div>
                    <div class="env-letter">
                        <!-- Letter preview -->
                        <iframe t-attf-src="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf"
                                type="application/pdf">
                        </iframe>
                    </div>
                    <div class="env-pocket"></div>
                    <div class="env-flap"></div>
                </div>
            </div>

            <!-- Text block at the right -->
            <div class="flex-grow-1 d-flex flex-column ml-2 mr-2 mb-2 mt-4">

                <!-- Top row: Title (left) and Dropdown (right) -->
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <t t-set="label"
                       t-value="'From ' + child.preferred_name if letter.direction != 'Supporter To Beneficiary' else 'To ' + child.preferred_name"/>
                    <t t-set="color_class"
                       t-value="'text-core-blue' if letter.direction != 'Supporter To Beneficiary' else ''"/>

                    <div t-attf-class="h5 #{color_class}">
                        <t t-esc="label"/>
                    </div>

                    <!-- Dots button & dropdown menu -->
                    <div class="dropdown">
                        <button class="btn btn-link p-0 border-0" type="button"
                                id="'dropdownMenuButton' + letter.id"
                                data-toggle="dropdown"
                                aria-expanded="false">
                            <span class="icon-dots-vertical"></span>
                        </button>

                        <div class="dropdown-menu border-low-black"
                             aria-labelledby="'dropdownMenuButton' + letter.id">
                            <a class="dropdown-item d-flex align-items-center pt-0 pb-0 pl-3 pr-3"
                               t-attf-href="/b2s_image?id={{letter.uuid}}&amp;disposition=inline&amp;file_type=pdf">
                                Preview
                                <i class="icon-eye ml-auto"></i>
                            </a>
                            <div class="dropdown-divider border-low-black"></div>
                            <a class="dropdown-item d-flex align-items-center pt-0 pb-0 pl-3 pr-3"
                               t-attf-href="/b2s_image?id={{letter.uuid}}"
                               t-attf-download="{{letter.name}}">
                                Download
                                <i class="icon-download01 ml-auto"></i>
                            </a>
                            <div class="dropdown-divider border-low-black"></div>
                            <a class="dropdown-item d-flex align-items-center pt-0 pb-0 pl-3 pr-3"
                               href="#">Reply
                                <i class="icon-pencil02 ml-auto"></i>
                            </a>
                            <div class="dropdown-divider border-low-black"></div>
                            <a class="dropdown-item d-flex align-items-center pt-0 pb-0 pl-3 pr-3"
                               href="#">Share
                                <i class="icon-share06 ml-auto"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Letter date -->
                <div class="mt-auto align-self-end tiny-text text-mid-grey">
                    <span t-field="letter.create_date"
                          t-options='{"widget": "date","format": "dd MMM. yyyy"}'/>
                </div>
            </div>
        </div>
    </template>
</odoo>
