<?xml version="1.0" encoding="utf-8" ?>
<!--
    Description:
    Displays a child's profile in a clickable card format. The card contains a picture on the left
    and the child’s information on the right. Clicking the card redirects to the child’s timeline page.
    If the related sponsorship is terminated, the card will have a different style.

    Props:
    - sponsorship (record): The sponsorship related object.
-->
<odoo>
    <template id="my2_children_card_component" name="Children Card Component">
        <link
      rel="stylesheet"
      href="/my_compassion/static/src/css/children_card.css"
    />
        <div
      t-att-class="'children-card w-100 children-card-terminated' if sponsorship.state == 'terminated' else 'children-card w-100'"
    >
            <div class="children-card-body">
                <a t-attf-href="/my2/children/{{sponsorship.child_id.id}}">
                    <div class="row align-items-center">
                        <!-- Card Image Section (Left) -->
                        <div
              class="col-4 text-center children-card-image-section"
            >
                            <img
                class="img-circle img-responsive"
                t-attf-src="/web/image/compassion.child/{{sponsorship.child_id.id}}/portrait"
                alt="Child image"
              />
                        </div>
                        <!-- Card Text Section (Right) -->
                        <div class="col-8 children-card-text-section h-100">
                            <div class="text-right">
                                <p class="children-card-status"><i
                    class="fa fa-envelope-o"
                  />
                                    New letter available!</p>
                            </div>
                            <p class="children-card-title">
                                <t t-esc="sponsorship.preferred_name" />
                            </p>
                            <p class="children-card-age">
                                <t t-esc="sponsorship.child_age" /> years old
                            </p>
                            <p class="children-card-country">
                                <t
                  t-esc="sponsorship.child_id.field_office_id.name"
                />
                            </p>
                            <p class="children-card-local-id">
                                <t t-esc="sponsorship.child_id.local_id" />
                            </p>
                            <div class="text-right">
                                <p class="children-card-last-contact">
                                    <t t-if="sponsorship.state == 'terminated'">
                                        Terminated
                                    </t>
                                    <t t-else="">
                                        Last contact on 13.01.25
                                    </t>
                                </p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </template>
</odoo>
