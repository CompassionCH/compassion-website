<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Children Profile

    Description:
    Displays a child’s profile with a picture on the left and information on the right.

    Props:
    - compassion_child (record): The child related object.
-->
<odoo>
    <template id="my2_children_profile_component" name="Children Profile Component">
        <link rel="stylesheet"
              href="/my_compassion/static/src/css/child_profile.css"/>

        <!-- Portrait -->
        <div class="child-details-container">
            <t t-call="theme_compassion_2025.PortraitComponent">
                <t t-set="title" t-value="compassion_child.preferred_name"/>
                <t t-set="src" t-value="'/web/image/compassion.child/' + str(compassion_child.id) + '/portrait'"/>
                <t t-set="alt" t-value="'Portrait of ' + compassion_child.preferred_name"/>
                <t t-set="size" t-value="'large'"/>
            </t>
        </div>

        <!-- Action buttons -->
        <div class="child-action-buttons">
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'compact'"/>
                <t t-set="variation" t-value="'hollow'"/>
                <t t-set="label" t-value="'Write a letter'"/>
                <t t-set="color" t-value="'core-blue'"/>
                <t t-set="text_color" t-value="'core-blue'"/>
            </t>
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'compact'"/>
                <t t-set="variation" t-value="'hollow'"/>
                <t t-set="label" t-value="'Give a gift'"/>
                <t t-set="color" t-value="'core-blue'"/>
                <t t-set="text_color" t-value="'core-blue'"/>
            </t>
        </div>

        <!-- Child personal information -->
        <div class="child-personal-information">
            <div class="child-info-item d-flex align-items-center">
                <div class="icon-frame bg-core-blue mr-2">
                    <i class="icon-calendar-heart02 text-pure-white m-2"></i>
                </div>
                <!-- TODO: Handle language changes for birthday -->
                <p class="child-info-text">My birthday is <span><t t-esc="compassion_child.birthdate.strftime('%d %B')"/></span></p>
            </div>
            <div></div>
            <div></div>
        </div>

        <!-- Child related information title -->

        <!-- Child related information (family, project and country) -->

        <!-- Partner and child timeline title -->

        <!-- Partner and child timeline component -->

        <div class="children-profile w-100">
            <div class="children-profile-body">
                <div class="row align-items-center">
                    <!-- Profile Image Section (Left) -->
                    <div class="col-4 text-center children-profile-image-section">
                        <img
                                class="img-circle img-responsive"
                                t-attf-src="/web/image/compassion.child/{{compassion_child.id}}/portrait"
                                alt="Child image"
                        />
                    </div>
                    <!-- Profile Text Section (Right) -->
                    <div class="col-8 children-profile-text-section h-100">
                        <p class="children-profile-title">
                            <t t-esc="compassion_child.preferred_name"/>
                        </p>
                        <p class="children-profile-country">
                            <t t-esc="compassion_child.field_office_id.name"/>
                        </p>
                        <p class="children-profile-age">
                            <t t-esc="compassion_child.age"/> years old
                        </p>
                        <div class="text-right">
                            <p class="children-profile-local-id">
                                <t t-esc="compassion_child.local_id"/>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
