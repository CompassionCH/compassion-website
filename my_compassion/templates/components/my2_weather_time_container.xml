<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child center Weather and Time Component

    Description:
    This component is used to display the current time of the child's center and its current weather.

    Used in route:
    - /my2/children/<model("compassion.child"):child>/

    Check page:
    - compassion_website.my_compassion2_child_timeline

    Injected data:
    - records: list of items to display in the component, each item should have:
        - timezone (string): timezone of the center.
        - current_temperature (float): current temperature of the center.
        - weather_status (string): status of the weather eg: "clear", "rain"...
        - project_name (string): name of the project the center belongs to.
        - church_name (string): name of the local church associated with the center.
        - city_country (string): represents where the center is located in the following format city,country.

-->


<!--map info container containing the meteo info, time and location -->

<odoo>
    <template id="WeatherTimeContainer" name="Weather and Time Container">
        <div class="map-info-container bg-white pb-3 mt-3 rounded shadow-sm">

            <t t-if="project_name and church_name">
                <div class="bg-mid-yellow d-flex justify-content-center align-items-center py-2 px-3">
                    <p class="text-mid-green mb-0 text-center" style="font-size: 0.875rem;">
                        <t t-esc="project_name"/>, <t t-esc="church_name"/>
                    </p>
                </div>
            </t>

            <p t-if="city_country" class="text-mid-green text-center mb-2 pt-2">
                <t t-esc="city_country"/>
            </p>



            <div class="text-mid-grey d-flex justify-content-center pt-1">
                <span id="current_time" class="mr-3"></span>

                <span class="mr-3 border-left border-mid-green"></span>

                <div class="text-primary-grey d-flex align-items-center">

                    <span class="mr-1" id="current_temperature"></span>
                </div>


            </div>

        </div>
    </template>
</odoo>