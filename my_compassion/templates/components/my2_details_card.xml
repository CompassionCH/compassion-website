<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Details Card

    Description:
    Displays a styled card with a title and raw HTML content.

    Props:
    - card_title (string): The title displayed at the top of the card.
    - content (raw HTML): The main content inside the card body.
-->
<odoo>
    <template id="my2_details_card_component" name="Details Card Component">
        <link rel="stylesheet" href="/my_compassion/static/src/css/details_card.css"/>
        <div class="details-card w-100">
            <div class="details-card-body">
                <div class="row align-items-center">
                    <div class="col-12 h-100">
                        <p class="details-card-title">
                            <t t-esc="card_title"/>
                        </p>
                        <t t-raw="content"/>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
