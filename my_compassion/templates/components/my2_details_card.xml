<?xml version="1.0" encoding="utf-8" ?>
<!--
    This component represents the details card design
-->
<odoo>
    <template id="my2_details_card_component" name="Details Card Component">
        <link rel="stylesheet" href="/my_compassion/static/src/css/details_card.css"/>
        <div class="details-card w-100">
            <div class="details-card-body">
                    <div class="row align-items-center">
                        <div class="col-12 h-100">
                            <p class="details-card-title">
                                <t t-esc="card_title"/>
                            </p>
                            <p>
                                <t t-esc="compassion_child.birthdate"/>
                            </p>
                            <p>
                                <t t-esc="compassion_child.hobby_ids[0].name"/>
                            </p>
                            <p>
                                <t t-esc="compassion_child.education_level"/>
                            </p>
                        </div>
                    </div>
            </div>
        </div>
    </template>
</odoo>
