<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Checkout

    Description:
    Embeds the standard payment form for the current gift package order. The
    form lists the compatible enabled payment providers (PostFinance on the
    Swiss website) and starts the transaction; offsite providers then redirect
    to their payment gateway.

    Context:
    The caller's rendering context must carry the payment form values built by
    the gift-package controller (providers, payment methods, amount, currency,
    transaction_route, landing_route, access_token...).

    Props:                                                                          Default:
    - top_class (string): Classes to add to the top element of the component.       [none]
-->
<odoo>
  <!-- CHECKOUT COMPONENT -->
  <template id="CheckoutComponent" name="Checkout Component">
    <div t-attf-class="mt-3 clearfix #{top_class}">
      <t t-set="top_class" t-value="''" />
      <t t-call="payment.form" />
    </div>
  </template>
</odoo>
