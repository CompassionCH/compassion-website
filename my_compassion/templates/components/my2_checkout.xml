<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Checkout

    Description:
    A checkout button which redirects the user to the payment gateway of PostFinance.

    Notes:
    This component works around the payment_postfinance_flex module and depends on a few hacks. The module is meant
    to integrate with Odoo's shopping system by registering as a payment_acquirer and injecting its payment methods
    as radio buttons into the form in /shop/payment. Since we want the Postfinance portal itself to handle the payment
    method selection but want to interfere with the module as little as possible, we create the same form as in
    /shop/payment containing a single (hidden) pre-checked radio button with the postfinance-method-id data attribute
    set to 'false'. This causes the module to initiate a transaction without a valid payment method, making the gateway
    display its payment method selection page. The value of 'false' specifically bypasses the module's validation checks
    while still resulting in our desired behavior, but note that this is most likely not intended by the module.

    Props:                                                                          Default:
    - acquirer (payment.acquirer): The postfinance payment acquirer.                -required-
    - label (string): Button label.                                                 ['Proceed to checkout']
    - variant (string): Button variant.                                             ['default']
    - variation (string): Button variation.                                         ['filled']
    - icon (string): Button icon.                                                   [none]
    - color (string): Button color.                                                 ['dark-blue']
    - icon_color (string): Button icon color.                                       ['pure-white']
    - text_color (string): Button text color.                                       ['pure-white']
    - top_class (string): Classes to add to the top element of the component.       [none]
-->
<odoo>
    <!-- CHECKOUT COMPONENT -->
    <template id="CheckoutComponent" name="Checkout Component">
        <!-- Default property values -->
        <t t-set="label" t-value="label or 'Proceed to checkout'" />
        <t t-set="variant" t-value="variant or 'default'" />
        <t t-set="variation" t-value="variation or 'filled'" />
        <t t-set="color" t-value="color or 'dark-blue'" />
        <t t-set="icon_color" t-value="icon_color or 'pure-white'" />
        <t t-set="text_color" t-value="text_color or 'pure-white'" />
        <!-- Component definition -->
        <form method="post" t-attf-class="o_payment_form mt-3 clearfix #{top_class}">
            <t t-set="top_class" t-value="''" />
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
            <input type="hidden" name="prepare_tx_url" t-att-value="'/shop/payment/transaction/'" />
            <input
                type="radio"
                t-att-data-acquirer-id="acquirer.id"
                t-att-data-form-payment="true"
                t-att-data-provider="'postfinance'"
                t-att-data-postfinance-method-id="'false'"
                t-att-data-postfinance-space-id="acquirer.postfinance_api_spaceid"
                t-att-data-postfinance-trans_interface="'OFFSITE'"
                t-att-data-postfinance-one_click_mode="'ALLOW'"
                name="pm_id"
                t-attf-value="'postfinance'"
                checked=""
                class="d-none"
            />
            <div class="w-100 d-flex flex-column align-items-stretch">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="id" t-value="'o_payment_form_pay'" />
                </t>
            </div>
        </form>
    </template>
</odoo>
