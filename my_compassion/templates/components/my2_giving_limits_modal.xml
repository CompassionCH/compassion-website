<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Giving Limits Modal

    Description:
    A modal to explain what the giving limits are.

    Props:                                                                                       Default:
    - limits (list[gift.threshold.settings]): The price limits for different donations types.    -required-
    - modal_id (string): The id of the modal element.                                            ['giving-limits-modal']
-->
<odoo>
    <!-- GIVING LIMITS MODAL COMPONENT -->
    <template id="GivingLimitsModalComponent" name="Giving Limits Modal Component">
        <!-- Default property values -->
        <t t-set="modal_id" t-value="modal_id or 'giving-limits-modal'" />
        <!-- Include stylesheet -->
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_giving_limits_modal.css" />
        <div
            class="modal fade giving-limits-modal"
            t-att-id="modal_id"
            tabindex="-1"
            role="dialog"
            aria-labelledby="help-modal-title"
            aria-hidden="true"
        >
            <div class="modal-dialog" role="document">
                <div class="modal-content border-0">
                    <div class="modal-header border-0 bg-low-blue d-flex align-items-center justify-content-center">
                        <h5 class="modal-title text-pure-white">
                            Giving limits
                            <button
                                type="button"
                                class="mr-3 icon-x-circle text-pure-white"
                                data-dismiss="modal"
                                aria-label="Close"
                            />
                        </h5>
                    </div>
                    <div class="modal-body bg-light-blue tiny-text text-center">
                        We want to ensure your gifts really do benefit children, families and communities in the
                        long-term, which is why we put limits on the amount  that can be sent.
                    </div>
                    <div class="modal-body">
                        <div class="tiny-text">
                            Ultimately, we want to enable communities to support themselves. The last thing we want
                            is to encourage a culture of dependency on gifts. Also, we don't want to overwhelm
                            families or single them out for special treatment, which is why we have limits in place.
                        </div>
                        <div class="my-4">
                            <t t-call="my_compassion.GivingLimitsTableComponent" />
                        </div>
                        <div class="tiny-text">
                            If you'd like to make a large donation to support the work of  Compassion, please get in
                            touch with us directly and we can suggest how  your donation can make the greatest
                            impact.
                        </div>
                        <div class="mt-4 tiny-text">
                            <i class="mr-1 icon-phone body-small" />
                            <a href="tel:+41244342124" class="text-low-black">+41 (0)24 434 21 24</a>
                            (Mo-Fri: 9.00-14.00)
                        </div>
                        <div class="mt-2 tiny-text">
                            <i class="mr-1 icon-mail01 body-small" />
                            <a t-attf-href="mailto:#{request.env.company.email}" class="text-low-black">
                                <t t-esc="request.env.company.email" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>
