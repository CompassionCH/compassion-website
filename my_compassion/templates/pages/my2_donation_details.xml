<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Donation Details Page

    Description:
    This page displays details about a donation type and allows users to choose an amount to donate.

    Used in route:
    - /my2/donation-details

    Injected data:
    - product ('product.template' record): The donation product.
-->
<odoo>
    <!-- DONATION DETAILS PAGE -->
    <template id="my2_donation_details_page" name="Donation Details Page">
        <!-- Include js and stylesheet -->
        <script type="text/javascript" src="/my_compassion/static/src/js/my2_donation_details.js" />
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_donation_details.css" />
        <t t-call="website.layout">
            <!-- HEADER -->
            <div class="content-column">
                <div
                    class="donation-details-header p-5 w-100 d-flex flex-column align-items-center"
                    t-attf-style="--image_url: url('/web/image/#{product._name}/#{product.id}/my_compassion_image');"
                >
                    <h2 class="text-center text-pure-white">
                        <t t-esc="product.my_compassion_name" />
                    </h2>
                    <div class="mt-2 bg-pure-white" />
                    <i t-attf-class="pictogram-#{product.my_compassion_pictogram} mt-3 text-pure-white" />
                </div>
            </div>
            <div class="container">
                <form class="my2_donation_details_form" t-attf-action="/my2/donation-details/submit" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                    <input type="hidden" name="product_id" t-att-value="product.id" />
                    <div class="content-column">
                        <div class="px-3 d-flex flex-column align-items-center">
                            <!-- DESCRIPTION -->
                            <div class="mt-4 body-small bold text-center" t-field="product.my_compassion_description" />
                            <!-- IMPACT STATEMENT -->
                            <div
                                t-if="product.my_compassion_show_impact_statement"
                                class="donation-impact-statement mt-3 row"
                            >
                                <!-- BEFORE -->
                                <div class="col-12 col-lg-6">
                                    <div class="mt-3 ml-4 body-standard text-mid-brown">The reality...</div>
                                    <t t-foreach="product.my_compassion_impact_before_ids" t-as="line">
                                        <div class="mt-2 d-flex">
                                            <i class="mr-2 icon-alert-circle text-mid-brown flex-shrink-0" />
                                            <t t-esc="line.description" />
                                        </div>
                                    </t>
                                </div>
                                <!-- AFTER -->
                                <div class="col-12 col-lg-6">
                                    <div class="mt-3 ml-4 body-standard text-mid-green">With your help we can...</div>
                                    <t t-foreach="product.my_compassion_impact_after_ids" t-as="line">
                                        <div class="mt-2 d-flex">
                                            <i class="mr-2 icon-check-heart text-mid-green flex-shrink-0" />
                                            <t t-esc="line.description" />
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <!-- INFORMATION -->
                            <div t-if="product.my_compassion_show_info" class="mt-3 d-flex flex-column">
                                <t t-call="theme_compassion_2025.TitleComponent">
                                    <t t-set="title_content" t-value="'How does it work?'" />
                                    <t t-set="color" t-value="'core-blue'" />
                                    <t t-set="show_underline" t-value="True" />
                                    <t t-set="underline_color" t-value="'low-yellow'" />
                                </t>
                                <t t-foreach="product.my_compassion_info_ids" t-as="line">
                                    <div class="mt-2 body-large text-mid-brown">
                                        <t t-esc="line.title" />
                                    </div>
                                    <div class="mt-2 mb-2 body-small" t-field="line.text" />
                                </t>
                            </div>
                            <!-- TESTIMONY -->
                            <div t-if="product.my_compassion_show_testimony" class="mt-3 d-flex flex-column">
                                <t t-call="theme_compassion_2025.TitleComponent">
                                    <t t-set="title_content" t-value="'Testimony'" />
                                    <t t-set="color" t-value="'core-blue'" />
                                    <t t-set="show_underline" t-value="True" />
                                    <t t-set="underline_color" t-value="'low-yellow'" />
                                </t>
                                <div class="mt-2 body-large text-mid-brown">
                                    <t t-esc="product.my_compassion_testimony_title" />
                                </div>
                                <div class="mt-2 body-small" t-field="product.my_compassion_testimony_text" />
                            </div>
                            <!-- DONATE -->
                            <div class="donation-inputs-container mt-3 w-100 d-flex flex-column">
                                <t t-call="theme_compassion_2025.TitleComponent">
                                    <t t-set="title_content" t-value="'Donate'" />
                                    <t t-set="color" t-value="'core-blue'" />
                                    <t t-set="show_underline" t-value="True" />
                                    <t t-set="underline_color" t-value="'low-yellow'" />
                                </t>
                                <!-- DONATION FREQUENCY -->
                                <t t-call="theme_compassion_2025.ToggleButtonComponent">
                                    <t t-set="name" t-value="'frequency'" />
                                    <t
                                        t-set="options"
                                        t-value="[
                                        ('one_time', 'One Time'),
                                        ('monthly', 'Monthly'),
                                    ]"
                                    />
                                    <t t-set="top_class" t-value="'mt-3 align-self-center'" />
                                </t>
                                <t t-call="theme_compassion_2025.FormFieldComponent">
                                    <t t-set="top_class" t-value="'mt-4 w-100'" />
                                    <t t-set="label" t-value="'Suggested amounts'" />
                                    <div class="mt-1 d-flex justify-content-between">
                                        <div class="donation-suggested-amount flex-grow-1">
                                            <input
                                                id="suggested-low"
                                                type="radio"
                                                name="suggested_amount"
                                                value="low"
                                                checked=""
                                            />
                                            <label class="mb-0 w-100" for="suggested-low">
                                                <t
                                                    t-set="price"
                                                    t-value="product.my_compassion_donation_quantity_low * product.list_price"
                                                />
                                                CHF
                                                <t t-if="price % 1 == 0" t-esc="int(price)" />
                                                <t t-else="" t-esc="'{0:.2f}'.format(price)" />
                                            </label>
                                        </div>
                                        <div class="donation-suggested-amount mx-3 flex-grow-1">
                                            <input
                                                id="suggested-medium"
                                                type="radio"
                                                name="suggested_amount"
                                                value="medium"
                                            />
                                            <label class="mb-0 w-100" for="suggested-medium">
                                                <t
                                                    t-set="price"
                                                    t-value="product.my_compassion_donation_quantity_medium * product.list_price"
                                                />
                                                CHF
                                                <t t-if="price % 1 == 0" t-esc="int(price)" />
                                                <t t-else="" t-esc="'{0:.2f}'.format(price)" />
                                            </label>
                                        </div>
                                        <div class="donation-suggested-amount flex-grow-1">
                                            <input
                                                id="suggested-high"
                                                type="radio"
                                                name="suggested_amount"
                                                value="high"
                                            />
                                            <label class="mb-0 w-100" for="suggested-high">
                                                <t
                                                    t-set="price"
                                                    t-value="product.my_compassion_donation_quantity_high * product.list_price"
                                                />
                                                CHF
                                                <t t-if="price % 1 == 0" t-esc="int(price)" />
                                                <t t-else="" t-esc="'{0:.2f}'.format(price)" />
                                            </label>
                                        </div>
                                    </div>
                                </t>
                                <t t-call="theme_compassion_2025.FormFieldComponent">
                                    <t t-set="top_class" t-value="'mt-3 w-100'" />
                                    <t t-set="label" t-value="'Or enter your own amount'" />
                                    <t t-set="invalid_hint" t-value="'Please enter a valid amount.'" />
                                    <div class="donation-suggested-amount">
                                        <input
                                            id="suggested-custom"
                                            type="radio"
                                            name="suggested_amount"
                                            value="custom"
                                        />
                                        <label class="mb-0 w-100" for="suggested-custom">Custom amount</label>
                                    </div>
                                    <input
                                        id="custom-amount"
                                        type="text"
                                        name="custom_amount"
                                        placeholder="CHF"
                                        class="form-control mt-2"
                                        hidden=""
                                    />
                                </t>
                                <div class="btn-submit align-self-stretch my-4 d-flex flex-column align-items-stretch">
                                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                        <t t-set="variant" t-value="'default'" />
                                        <t t-set="variation" t-value="'filled'" />
                                        <t t-set="label" t-value="'Add &amp; check out'" />
                                        <t t-set="color" t-value="'mid-green'" />
                                        <t t-set="text_color" t-value="'pure-white'" />
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>
</odoo>
