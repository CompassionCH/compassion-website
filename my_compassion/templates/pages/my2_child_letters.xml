<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Letters Page

    Description:
    This page displays all the letters associated with a sponsored child.
    The letters are displayed in a card format. It is rendered from frontend. (See my2_letters_filter.js)

    Used in route:
    - /my2/children/<int:child_id>/letters

    Injected data:
    - compassion_child (record): The related child object.
-->
<odoo>
    <template id="my2_child_letters_page" name="My Compassion 2 Child Letters Page">

        <!-- Stylesheet -->
        <link rel="stylesheet" href="/my_compassion/static/src/css/letter_filter.css"/>

        <!-- Base layout -->
        <t t-call="website.layout">
            <div class="container">

                <!-- Breadcrumb -->
                <t t-call="my_compassion.my2_breadcrumbs"/>

                <!-- Child profile -->
                <div class="row mb-2">
                    <div class="col-12">
                        <t t-call="my_compassion.my2_children_profile_component">
                            <t t-set="compassion_child" t-value="compassion_child"/>
                        </t>
                    </div>
                </div>

                <!-- Date Picker -->
                <div class="date-picker-container">
                    <div class="date-range-picker row mb-3 d-flex justify-content-center">

                        <!-- Start Date -->
                        <div class="start-date col-xs-auto col-6 d-flex justify-content-center">
                            <div>
                                <h6>Start Date <i class="fa fa-calendar"/></h6>
                                <select class="start-month"/>
                                <select class="start-year"/>
                            </div>
                        </div>

                        <!-- End Date -->
                        <div class="end-date col-xs-auto col-6 d-flex justify-content-center">
                            <div>
                                <h6>End Date <i class="fa fa-calendar"/></h6>
                                <select class="end-month"/>
                                <select class="end-year"/>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Filter Buttons -->
                <div class="row mb-4">
                    <div class="letter-filter">
                        <button
                            type="button"
                            id="filter-to"
                            class="btn-compassion btn-compassion-white inactive"
                            data-direction="Beneficiary To Supporter">
                            <span>Received</span>
                        </button>
                        <button
                            type="button"
                            id="filter-from"
                            class="btn-compassion btn-compassion-white inactive"
                            data-direction="Supporter To Beneficiary">
                            <span>Sent</span>
                        </button>
                    </div>
                </div>

                <!-- Sort Order Toggle -->
                <div class="row mb-5">
                    <div class="letter-filter">
                        <button id="toggle-date-order" class="btn btn-compassion">
                            Newest First
                        </button>
                    </div>
                </div>

                <!-- Letters Container -->
                <div class="my2-letters-container" t-att-data-child-id="compassion_child.id"/>
            </div>
        </t>

        <!-- Scripts -->
        <!-- Load owl.js and custom JS files -->
        <script type="text/javascript" src="/my_compassion/static/src/js/my2_letters_card.js"/>
        <script type="text/javascript" src="/my_compassion/static/src/js/my2_letters_filter.js"/>
    </template>
</odoo>
