<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Letters Page

    Description:
    This page displays all the letters associated with a sponsored child.

    Used in route:
    - /my2/children/<int:child_id>/letters

    Injected data:
    - compassion_child (record): The related child object.
    - letters (array of 'correspondence' records): The related sponsorship letters.
-->
<odoo>
    <template id="my_compassion_assets" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <!-- CSS -->
            <link rel="stylesheet" href="/my_compassion/static/src/css/global.css"/>
            <script type="text/javascript" src="/my_compassion/static/src/js/my2_letters_filter.js"/>
        </xpath>
    </template>
    <template
    id="my2_child_letters_page"
    name="My Compassion 2 Child Letters Page"
  >
        <t t-call-assets="my_compassion.my_compassion_assets" t-js="true"/>
        <link
      rel="stylesheet"
      href="/my_compassion/static/src/css/template_image.css"
    />
        <link
      rel="stylesheet"
      href="/my_compassion/static/src/css/letter_filter.css"
    />

        <t t-call="website.layout">
            <t t-call-assets="website.assets_frontend" t-js="true"/>
            <div class="container">
                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumbs" />
                <div class="row mb-2">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t
              t-call="my_compassion.my2_children_profile_component"
            >
                            <!-- The data we are passing to the children_profile_component -->
                            <t
                t-set="compassion_child"
                t-value="compassion_child"
              />
                        </t>
                    </div>
                </div>

                <!-- Filter Toggle Buttons -->
                <div class="row mb-3">
                    <div class="col-6 text-center">
                        <button type="button" id="filter-from" class="btn-compassion btn-compassion-white inactive" data-direction="supporter_to_beneficiary">
                            <span>Supporter to Beneficiary</span>
                        </button>
                    </div>
                    <div class="col-6 text-center">
                        <button type="button" id="filter-to" class="btn-compassion btn-compassion-white inactive" data-direction="beneficiary_to_supporter">
                            <span>Beneficiary to Supporter</span>
                        </button>
                    </div>
                </div>
                <!-- Order of the letters -->
                <div class="row mb-4">
                    <button id="toggle-date-order" class="btn btn-compassion">
                        Newest First
                    </button>
                </div>
                <!-- Letters List -->
                <!-- Important: Add data-child-id attribute here -->
                <div class="my2-letters-container" t-att-data-child-id="compassion_child.id">
                    <t t-foreach="letters" t-as="letter">
                        <div class="my2-letters-container" t-att-data-child-id="compassion_child.id">
                            <t t-if="letters">
                                <t t-foreach="letters" t-as="letter">
                                    <!-- Your existing letter structure -->
                                </t>
                            </t>
                            <t t-else="">
                                <div class="text-center p-3">
                                    <p>No letters available</p>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
