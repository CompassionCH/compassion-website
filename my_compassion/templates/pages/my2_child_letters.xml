<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Letters Page

    Description:
    This page displays all the letters associated with a sponsored child.

    Used in route:
    - /my2/children/<int:child_id>/letters

    Injected data:
    - compassion_child (record): The related child object.
    - letters (array of 'correspondence' records): The related sponsorship letters.
-->
<odoo>
    <template id="my2_child_letters_page" name="My Compassion 2 Child Letters Page">
        <link rel="stylesheet" href="/my_compassion/static/src/css/child_letters.css"/>
        <t t-call="website.layout">
            <div class="container">
                <!-- Title -->
                <div class="mb-4">
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content" t-value="'Your inbox'"/>
                        <t t-set="color" t-value="'core-blue'"/>
                        <t t-set="underline_color" t-value="'low-yellow'"/>
                        <t t-set="show_underline" t-value="True"/>
                        <t t-set="title_size" t-value="'md'"/>
                    </t>
                </div>

                <!-- Button for opening the filter panel -->
                <div class="text-center mb-3">
                    <a data-toggle="modal" data-target="#filterModal">
                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                            <t t-set="variation" t-value="'hollow'"/>
                            <t t-set="color" t-value="'low-black'"/>
                            <t t-set="icon_color" t-value="'low-black'"/>
                            <t t-set="variant" t-value="'default'"/>
                            <t t-set="icon" t-value="'icon-filter-lines'"/>
                        </t>
                    </a>
                </div>

                <!-- Modal -->
                <div class="modal fade" id="filterModal" tabindex="-1" role="dialog"
                     aria-labelledby="filterModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-sm" role="document">
                        <div class="modal-content border-0">
                            <div class="text-center p-0 m-0">
                                <h2 class="text-pure-white bg-core-blue pb-2 pt-3">
                                    Filter letters
                                </h2>
                                <!-- Modal buttons -->
                                <div class="pl-5 pr-5 pt-3">
                                    <!-- Modal dropdown buttons (dates) -->
                                    <script>
                                        document.addEventListener('DOMContentLoaded',
                                        function () {
                                        document.querySelectorAll('.dropdown-menu
                                        .dropdown-item').forEach(function (item) {
                                        item.addEventListener('click', function () {
                                        const parentDropdown =
                                        this.closest('.dropdown');
                                        const toggleBtn =
                                        parentDropdown.querySelector('.dropdown-toggle');
                                        toggleBtn.textContent = this.textContent;
                                        });
                                        });
                                        });
                                    </script>

                                    <h3 class="text-core-blue">
                                        From
                                    </h3>
                                    <div class="justify-content-between d-flex w-100 pb-2">
                                        <!-- Month Dropdown -->
                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle bg-pure-white border-core-blue"
                                                    type="button" data-toggle="dropdown"
                                                    aria-expanded="false"
                                                    id="monthDropdown">
                                                Month |
                                            </button>
                                            <ul class="dropdown-menu"
                                                aria-labelledby="monthDropdown">
                                                <li><a class="dropdown-item" href="#">
                                                    January</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    February</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    March</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    April</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    May</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    June</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    July</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    August</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    September</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    October</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    November</a></li>
                                                <li><a class="dropdown-item" href="#">
                                                    December</a></li>
                                            </ul>
                                        </div>

                                        <!-- Year Dropdown -->
                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle bg-pure-white border-core-blue"
                                                    type="button" data-toggle="dropdown"
                                                    aria-expanded="false"
                                                    id="yearDropdown">
                                                Year |
                                            </button>
                                            <ul class="dropdown-menu"
                                                aria-labelledby="yearDropdown">
                                                <t t-foreach="range(2025, 2015, -1)"
                                                   t-as="year">
                                                    <li>
                                                        <a class="dropdown-item"
                                                           href="#"><t
                                                                t-esc="year"/></a>
                                                    </li>
                                                </t>
                                            </ul>
                                        </div>
                                    </div>

                                    <h3 class="text-core-blue">
                                        To
                                    </h3>

                                    <div class="justify-content-between d-flex w-100 pb-4">
                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle bg-pure-white border-core-blue"
                                                    type="button" data-toggle="dropdown"
                                                    aria-expanded="false">
                                                September |
                                            </button>
                                            <div class="dropdown-menu">
                                                <a class="dropdown-item" href="#">
                                                    Action</a>
                                                <a class="dropdown-item" href="#">
                                                    Another action</a>
                                                <a class="dropdown-item" href="#">
                                                    Something else here</a>
                                            </div>
                                        </div>

                                        <div class="dropdown">
                                            <button class="btn dropdown-toggle bg-pure-white border-core-blue"
                                                    type="button" data-toggle="dropdown"
                                                    aria-expanded="false">
                                                Year |
                                            </button>
                                            <div class="dropdown-menu">
                                                <a class="dropdown-item" href="#">
                                                    Action</a>
                                                <a class="dropdown-item" href="#">
                                                    Another action</a>
                                                <a class="dropdown-item" href="#">
                                                    Something else here</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-5">
                                    <!-- Modal radio buttons -->
                                    <div class="btn-group btn-group-toggle justify-content-between d-flex w-100 pb-3"
                                         data-toggle="buttons">
                                        <label class="btn btn-secondary btn-custom-toggle text-low-blue bg-pure-white border-low-blue border-left-pill">
                                            <input type="radio"
                                                   checked="checked"></input>
                                            Received
                                        </label>
                                        <label class="btn btn-secondary btn-custom-toggle text-low-blue bg-pure-white border-low-blue border-right-pill">
                                            <input type="radio"></input>
                                            Sent
                                        </label>
                                    </div>
                                    <div class="btn-group-toggle d-flex pb-3"
                                         data-toggle="buttons">
                                        <label class="btn btn-secondary w-100 text-low-blue bg-pure-white border-low-blue btn-custom-toggle border-pill active">
                                            <input type="checkbox"
                                                   checked="checked"></input>
                                            Newest first
                                        </label>
                                    </div>
                                    <!-- Modal buttons Ok & Cancel -->
                                    <div class="d-flex w-100 justify-content-between">
                                        <a data-toggle="modal"
                                           data-target="#filterModal">
                                            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                                <t t-set="variation"
                                                   t-value="'filled'"/>
                                                <t t-set="color" t-value="'mid-green'"/>
                                                <t t-set="text_color"
                                                   t-value="'pure-white'"/>
                                                <t t-set="variant" t-value="'compact'"/>
                                                <t t-set="label"
                                                   t-value="'Ok'"/>
                                            </t>
                                        </a>
                                        <a data-toggle="modal"
                                           data-target="#filterModal">
                                            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                                <t t-set="variation"
                                                   t-value="'filled'"/>
                                                <t t-set="color"
                                                   t-value="'low-orange'"/>
                                                <t t-set="text_color"
                                                   t-value="'pure-white'"/>
                                                <t t-set="variant" t-value="'compact'"/>
                                                <t t-set="label"
                                                   t-value="'Cancel'"/>
                                            </t>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Letters -->
            <div class="row">
                <t t-foreach="letters" t-as="letter">
                    <div class="col-12 col-md-6 col-lg-4 mb-3 mt-3">
                        <t t-call="my_compassion.my2_letter_card_component">
                            <t t-set="letter" t-value="letter"/>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>