<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Letters Page

    Description:
    This page displays all the letters associated with a sponsored child.

    Used in route:
    - /my2/children/<int:child_id>/letters

    Injected data:
    - compassion_child (record): The related child object.
    - letters (array of 'correspondence' records): The related sponsorship letters.
-->
<odoo>
    <template
    id="my2_child_letters_page"
    name="My Compassion 2 Child Letters Page"
  >
        <link
      rel="stylesheet"
      href="/my_compassion/static/src/css/letter_filter.css"
    />
        <t t-call="website.layout">
            <div class="container">
                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumbs" />
                <div class="row mb-2">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t
              t-call="my_compassion.my2_children_profile_component"
            >
                            <!-- The data we are passing to the children_profile_component -->
                            <t
                t-set="compassion_child"
                t-value="compassion_child"
              />
                        </t>
                    </div>
                </div>
                <div class="date-picker-container">
                    <div
            class="date-range-picker row mb-3 d-flex justify-content-center"
          >

                        <div
              class="start-date col-xs-auto col-6 d-flex justify-content-center"
            >
                            <div>
                                <h6>Start Date <i class="fa fa-calendar" /></h6>
                                    <select class="start-month" />
                                    <select class="start-year" />
                            </div>
                        </div>
                        <div
              class="end-date col-xs-auto col-6 d-flex justify-content-center"
            >
                            <div>
                                <h6>End Date <i class="fa fa-calendar" /></h6>
                                    <select class="end-month" />
                                    <select class="end-year" />
                            </div>
                        </div>

                    </div>
                </div>
                <!-- Filter Toggle Buttons -->
                <div class="row mb-4">
                    <div class="letter-filter">
                        <button
              type="button"
              id="filter-to"
              class="btn-compassion btn-compassion-white inactive"
              data-direction="beneficiary_to_supporter"
            >
                            <span>Recieved</span>
                        </button>
                        <button
              type="button"
              id="filter-from"
              class="btn-compassion btn-compassion-white inactive"
              data-direction="supporter_to_beneficiary"
            >
                            <span>Sent</span>
                        </button>
                    </div>
                </div>
                <!-- Order of the letters -->
                <div class="row mb-5">
                    <div class="letter-filter">
                        <button
              id="toggle-date-order"
              class="btn btn-compassion"
            >
                            Newest First
                        </button>
                    </div>
                </div>
                <!-- Letters List -->
                <div
          class="my2-letters-container"
          t-att-data-child-id="compassion_child.id"
        >
                </div>
            </div>
        </t>
        <!-- Include Custom Javascript -->
        <script
      type="text/javascript"
      src="/my_compassion/static/src/js/my2_letters_filter.js"
    >
        </script>
        <script
      type="text/javascript"
      src="/my_compassion/static/src/js/my2_date_picker.js"
    >
        </script>
    </template>
</odoo>
