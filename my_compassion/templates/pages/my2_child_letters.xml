<?xml version="1.0" encoding="utf-8" ?>
<!-- TODO DOC -->
<odoo>
    <template id="my2_child_letters_page" name="My Compassion 2 Child Letters Page">
        <t t-call="website.layout">
            <div class="container">
                <div class="row mb-2">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t t-call="my_compassion.my2_children_profile_component">
                            <!-- The data we are passing to the children_profile_component -->
                            <t t-set="compassion_child" t-value="compassion_child"/>
                        </t>
                    </div>
                </div>

                <!-- Here will be the filters -->
                <div class="row mb-3">
                    <div class="col-6 text-center">
                        <button type="button"
                                class="btn-compassion btn-compassion-white">
                            <span>
                                Filter From
                            </span>
                        </button>
                    </div>
                    <div class="col-6 text-center">
                        <button type="button"
                                class="btn-compassion btn-compassion-white">
                            <span>
                                Filter To
                            </span>
                        </button>
                    </div>
                </div>

                <!-- Here will be the letters -->
                <div class="row mb-2">
                    <div class="col-12">
                        Letters card
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>