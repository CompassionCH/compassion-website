<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Gift Package Page

    Description:
    This page displays the content of the user's gift package (cart).

    Used in route:
    - /my2/gift-package

    Injected data:
    - order ('sales.order' record): The user's current order (cart content).
-->
<odoo>
    <!-- HELP MODAL TABLE COLUMN -->
    <template id="my2_gift_package_help_table_column" name="Gift Package Help Table Column">
        <div t-attf-class="table-column d-flex flex-column #{top_class}">
            <div class="table-cell tiny-text bold bg-light-green border-0 d-flex flex-column justify-content-center">
                <t t-esc="title"/>
            </div>
            <t t-foreach="cells" t-as="cell">
                <div class="table-cell super-tiny-text d-flex flex-column justify-content-center">
                    <div>
                        <t t-raw="cell.replace('*', '&lt;span class=\'body-small text-low-pink\'&gt;*&lt;/span&gt;')"/>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <!-- GIFT PACKAGE CONTENT -->
    <template id="my2_gift_package_content" name="Gift Package Content">
        <!-- ONE-OFF GIFTS -->
        <h3 t-if="len(order.order_line) &gt;= 1" class="mt-4 text-mid-green text-center">
            One-off gifts
        </h3>

        <t t-foreach="order.order_line" t-as="line">
            <t t-call="my_compassion.DonationItemComponent">
                <t t-set="name" t-value="line.product_template_id.my_compassion_name"/>
                <t t-set="title_color" t-value="'low-black'"/>
                <t t-set="accent_color" t-value="'mid-green'"/>
                <t t-set="price_color" t-value="'low-green'"/>
                <t t-set="bg_color" t-value="'mid-eggshell'"/>
                <t t-set="price" t-value="line.price_total"/>
                <t t-set="image" t-valuef="/web/image/#{line.product_template_id._name}/#{line.product_template_id.id}/my_compassion_image"/>
                <t t-set="top_class" t-valuef="mt-3 donation-item donation-item-#{line.id}"/>
                <t t-set="primary_button" t-value="{
                    'icon': 'edit05',
                    'label': 'Edit Details',
                    'color': 'low-green',
                    'action': 'link',
                    'href': 'http://www.google.com',
                }"/>
                <t t-set="secondary_buttons" t-value="[
                    {
                        'icon': 'trash01',
                        'color': 'low-pink',
                        'action': 'event',
                        'custom_event': 'donation-item:delete',
                        'detail': {
                            'order_line_id': line.id,
                        },
                    },
                ]"/>
            </t>
        </t>

        <!-- EMPTY CART -->
        <div t-if="len(order.order_line) == 0"
             class="mt-5 w-100 text-mid-grey text-center body-large bold">
            Your gift package is empty
        </div>

        <!-- TOTAL AMOUNT -->
        <div t-if="len(order.order_line) &gt;= 1"
             class="mt-4 px-3 pt-3 pb-2 w-100 rounded-lg bg-light-green d-flex justify-content-between">
            <div class="text-mid-green body-large bold">
                Total amount
            </div>
            <div class="text-dark-blue body-large bold">
                <t t-set="amount" t-value="order.amount_total"/>
                CHF
                <t t-if="amount % 1 == 0" t-esc="int(amount)" />
                <t t-else="" t-esc="'{0:.2f}'.format(amount)" />
            </div>
        </div>

        <!-- ADD GIFT & PAYMENT -->
        <div class="gift-package-payment-container mt-4 w-100 align-self-center">
            <div class="d-flex flex-column align-items-stretch">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'compact'" />
                    <t t-set="variation" t-value="'hollow'" />
                    <t t-set="label" t-value="'Add a gift'" />
                    <t t-set="icon" t-value="'icon-plus'" />
                    <t t-set="color" t-value="'mid-green'" />
                    <t t-set="text_color" t-value="'mid-green'" />
                    <t t-set="icon_color" t-value="'mid-green'" />
                    <t t-set="href" t-value="'https://www.example.com'" />
                </t>
                <t t-if="len(order.order_line) &gt;= 1">
                    <div class="mt-3 d-flex flex-column align-items-stretch">
                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                            <t t-set="variant" t-value="'compact'" />
                            <t t-set="variation" t-value="'filled'" />
                            <t t-set="label" t-value="'Proceed to payment'" />
                            <t t-set="color" t-value="'dark-blue'" />
                            <t t-set="text_color" t-value="'pure-white'" />
                        </t>
                    </div>
                    <div class="mt-3 px-5 d-flex align-items-center">
                        <img class="px-1 col-3" src="/my_compassion/static/src/img/mastercard.png"/>
                        <img class="px-1 col-3" src="/my_compassion/static/src/img/visa.png"/>
                        <img class="px-1 col-3" src="/my_compassion/static/src/img/twint.png"/>
                        <img class="px-1 col-3" src="/my_compassion/static/src/img/post_finance.png"/>
                    </div>
                    <div class="mt-3 body-small bold text-mid-green text-center">
                        <i class="mt-n1 icon-lock03"/>
                        Secure checkout
                    </div>
                    <div class="mt-1 tiny-text text-mid-grey text-center">
                        Learn more in our
                        <a href="">Privacy Policy</a>.
                    </div>
                </t>
            </div>
        </div>
    </template>

    <!-- GIFT PACKAGE PAGE -->
    <template id="my2_gift_package_page" name="Gift Package Page">
        <!-- Include js and stylesheet -->
        <script type="text/javascript" src="/my_compassion/static/src/js/my2_gift_package.js" />
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_gift_package.css" />
        <t t-call="website.layout">
            <!-- HELP MODAL -->
            <div class="modal fade" id="help-modal" tabindex="-1" role="dialog"
                 aria-labelledby="help-modal-title" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content border-0">
                        <div class="modal-header border-0 bg-low-blue d-flex align-items-center justify-content-center">
                            <h5 class="modal-title text-pure-white" id="help-modal-title">
                                Giving limits
                                <button type="button" class="mr-3 icon-x-circle text-pure-white"
                                        data-dismiss="modal" aria-label="Close"/>
                            </h5>
                        </div>
                        <div class="modal-body bg-light-blue tiny-text text-center">
                            We want to ensure your gifts really do benefit children, families and communities in the
                            long-term, which is why we put limits on the amount  that can be sent.
                        </div>
                        <div class="modal-body">
                            <div class="tiny-text">
                                Ultimately, we want to enable communities to support themselves. The last thing we want
                                is to encourage a culture of dependency on gifts. Also, we don't want to overwhelm
                                families or single them out for special treatment, which is why we have limits in place.
                            </div>
                            <div class="d-flex flex-column my-4">
                                <!-- TABLE TITLE -->
                                <div class="p-3 table-title col-12 bg-low-green tiny-text text-center text-pure-white">
                                    Annual gift limits in Switzerland
                                </div>
                                <!-- COLUMNS -->
                                <div class="d-flex">
                                    <!-- TYPE -->
                                    <t t-call="my_compassion.my2_gift_package_help_table_column">
                                        <t t-set="top_class" t-value="'flex-grow-1'"/>
                                        <t t-set="title" t-value="'Type'"/>
                                        <t t-set="cells" t-value="[
                                            'Birthday Gift*',
                                            'General Gift*',
                                            'Family Gift',
                                            'Project Gift',
                                            'Graduation/Final Gift**',
                                        ]"/>
                                    </t>
                                    <!-- MIN -->
                                    <t t-call="my_compassion.my2_gift_package_help_table_column">
                                        <t t-set="title" t-value="'Min'"/>
                                        <t t-set="cells" t-value="[
                                            'CHF 10',
                                            'CHF 10',
                                            'CHF 25',
                                            'CHF 50',
                                            'CHF 25',
                                        ]"/>
                                    </t>
                                    <!-- MAX -->
                                    <t t-call="my_compassion.my2_gift_package_help_table_column">
                                        <t t-set="title" t-value="'Max'"/>
                                        <t t-set="cells" t-value="[
                                            'CHF 150',
                                            'CHF 150',
                                            'CHF 1\'100',
                                            'CHF 15\'000',
                                            'CHF 3\'000',
                                        ]"/>
                                    </t>
                                </div>
                                <!-- NOTES -->
                                <div class="px-3 pt-1 super-tiny-text text-low-pink">
                                   *A child gift (birthday or general) can be given twice a year with an annual total of
                                    $300.<br/>**Available in the child's final year of the program.
                                </div>
                            </div>
                            <div class="tiny-text">
                                If you'd like to make a large donation to support the work of  Compassion, please get in
                                touch with us directly and we can suggest how  your donation can make the greatest
                                impact.
                            </div>
                            <div class="mt-4 tiny-text">
                                <i class="mr-1 icon-phone body-small"/>
                                <a href="tel:+41244342124" class="text-low-black">+41 (0)24 434 21 24</a>
                                (Lu-Ven: 9.00-14.00)
                            </div>
                            <div class="mt-2 tiny-text">
                                <i class="mr-1 icon-mail01 body-small"/>
                                <a href="mailto:info@compassion.ch" class="text-low-black">info@compassion.ch</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="container">
                <div class="content-column">
                    <!-- TODO: Add form action -->
                    <form class="my2_gift_package_form" action="/my2/" method="POST">
                        <div class="px-3 mt-4 d-flex flex-column align-items-center">
                            <!-- TITLE -->
                            <t t-call="theme_compassion_2025.TitleComponent">
                                <t t-set="title_content" t-value="'Gift Package'" />
                                <t t-set="color" t-value="'core-blue'" />
                                <t t-set="show_underline" t-value="True" />
                                <t t-set="underline_color" t-value="'low-yellow'" />
                                <t t-set="icon" t-value="'gift02'" />
                            </t>

                            <!-- HELP -->
                            <button type="button" class="body-large icon-help-circle text-mid-grey"
                                    data-toggle="modal" data-target="#help-modal"/>

                            <!-- DESCRIPTION -->
                            <div class="mt-3 px-4 body-small text-center">
                                Your donations will have an everlasting impact.
                            </div>

                            <!-- GIFT PACKAGE CONTENT -->
                            <div id="gift-package-content-wrapper" class="mb-4 w-100 d-flex flex-column align-items-stretch">
                                <!-- RENDER INITIAL CONTENT -->
                                <t t-call="my_compassion.my2_gift_package_content"/>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </t>
    </template>
</odoo>