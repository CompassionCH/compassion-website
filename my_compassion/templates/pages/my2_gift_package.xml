<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Gift Package Page

    Description:
    This page displays the content of the user's gift package (cart).

    Used in route:
    - /my2/gift-package

    Injected data:
    - order ('sales.order' record): The user's current order (cart content).
    - limits ('gift.threshold.settings' records): The giving limits.
    - the payment form values (providers, payment methods, amount, currency,
      transaction_route, landing_route...) consumed by the checkout component.
-->
<odoo>
  <!-- GIFT PACKAGE CONTENT -->
  <template id="my2_gift_package_content" name="Gift Package Content">
    <!-- ONE-TIME GIFTS -->
    <t
      t-set="one_time_order_lines"
      t-value="order.order_line.filtered(lambda line: line.frequency == 'one_time')"
    />
    <h3
      t-if="one_time_order_lines"
      class="mt-5 mb-0 text-mid-green text-center"
    >One-time gifts</h3>
    <t t-foreach="one_time_order_lines" t-as="line">
      <t t-call="my_compassion.DonationItemComponent">
        <t t-set="top_class" t-valuef="mt-3 donation-item donation-item-#{line.id}" />
        <t t-set="name" t-value="line.product_template_id.my_compassion_name" />
        <t
          t-if="line.is_gift"
          t-set="recipient"
          t-value="line.gift_recipient_id.preferred_name"
        />
        <t t-set="title_color" t-value="'low-black'" />
        <t t-set="accent_color" t-value="'mid-green'" />
        <t t-set="price_color" t-value="'low-green'" />
        <t t-set="recipient_color" t-value="'low-green'" />
        <t t-set="bg_color" t-value="'mid-eggshell'" />
        <t t-set="price" t-value="line.price_total" />
        <t t-set="currency_name" t-value="line.currency_id.name" />
        <t
          t-set="image"
          t-valuef="/web/image/#{line.product_template_id._name}/#{line.product_template_id.id}/my_compassion_image"
        />
        <t t-set="_txt_Edit_Details_1">Edit Details</t>
        <t
          t-set="primary_button"
          t-value="{'icon': 'edit05', 'label': _txt_Edit_Details_1, 'color': 'low-green', 'action': 'event', 'custom_event': 'donation-item:edit', 'detail': {'order_line_id': line.id}}"
        />
        <t
          t-set="secondary_buttons"
          t-value="[
                    {
                        'icon': 'trash01',
                        'color': 'low-pink',
                        'action': 'event',
                        'custom_event': 'donation-item:delete',
                        'detail': {
                            'order_line_id': line.id,
                        },
                    },
                ]"
        />
      </t>
    </t>
    <!-- MONTHLY GIFTS -->
    <t
      t-set="monthly_order_lines"
      t-value="order.order_line.filtered(lambda line: line.frequency == 'monthly')"
    />
    <h3
      t-if="monthly_order_lines"
      class="mt-5 mb-0 text-dark-blue text-center"
    >Monthly gifts</h3>
    <t t-foreach="monthly_order_lines" t-as="line">
      <t t-call="my_compassion.DonationItemComponent">
        <t t-set="top_class" t-valuef="mt-3 donation-item donation-item-#{line.id}" />
        <t t-set="name" t-value="line.product_template_id.my_compassion_name" />
        <t
          t-if="line.is_gift"
          t-set="recipient"
          t-value="line.gift_recipient_id.preferred_name"
        />
        <t t-set="title_color" t-value="'dark-blue'" />
        <t t-set="accent_color" t-value="'dark-blue'" />
        <t t-set="price_color" t-value="'dark-blue'" />
        <t t-set="recipient_color" t-value="'dark-blue'" />
        <t t-set="bg_color" t-value="'light-blue'" />
        <t t-set="price" t-value="line.price_total" />
        <t t-set="currency_name" t-value="line.currency_id.name" />
        <t t-set="monthly" t-value="True" />
        <t
          t-set="image"
          t-valuef="/web/image/#{line.product_template_id._name}/#{line.product_template_id.id}/my_compassion_image"
        />
        <t t-set="_txt_Edit_Details">Edit Details</t>
        <t
          t-set="primary_button"
          t-value="{'icon': 'edit05', 'label': _txt_Edit_Details, 'color': 'dark-blue', 'action': 'event', 'custom_event': 'donation-item:edit', 'detail': {'order_line_id': line.id}}"
        />
        <t
          t-set="secondary_buttons"
          t-value="[
                    {
                        'icon': 'trash01',
                        'color': 'low-pink',
                        'action': 'event',
                        'custom_event': 'donation-item:delete',
                        'detail': {
                            'order_line_id': line.id,
                        },
                    },
                ]"
        />
      </t>
    </t>
    <!-- EMPTY CART -->
    <div
      t-if="len(order.order_line) == 0"
      class="mt-5 w-100 text-mid-grey text-center body-large bold"
    >
            Your Gift Basket is empty.
        </div>
    <!-- TOTAL AMOUNT -->
    <div
      t-if="len(order.order_line) &gt;= 1"
      class="mt-5 px-3 pt-3 pb-2 w-100 rounded-lg bg-light-green d-flex justify-content-between"
    >
      <div class="text-mid-green body-large bold">Total amount</div>
      <div class="text-dark-blue body-large bold">
        <t t-set="amount" t-value="order.amount_total" />
        <t t-out="order.currency_id.name" />
        <t t-if="amount % 1 == 0" t-out="int(amount)" />
        <t t-else="" t-out="'{0:.2f}'.format(amount)" />
      </div>
    </div>
  </template>
  <!-- GIFT PACKAGE DONOR FORM -->
  <!-- The email step of a visitor, before the payment form: the same two
       questions as the sponsorship fast checkout. -->
  <template id="my2_gift_package_donor_form" name="Gift Package Donor Form">
    <form
      class="my2-gift-package-donor-form mt-3 w-100"
      action="/my2/gift-package/donor"
      method="POST"
    >
      <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
      <div
        t-if="donor_error"
        class="mb-3 p-3 rounded-lg bg-low-eggshell text-mid-orange body-small"
        role="alert"
      >Please give a valid email and accept the privacy notice.</div>
      <!-- Email -->
      <t t-call="theme_compassion_2025.FormFieldComponent">
        <t t-set="top_class" t-value="'my-3'" />
        <t t-set="label">E-mail</t>
        <t t-set="input_id" t-value="'donor_email'" />
        <input
          id="donor_email"
          type="email"
          name="email"
          class="form-control"
          placeholder="you@example.com"
          t-att-value="donor_email"
          data-validate-type="email"
          required=""
        />
        <div
          class="mt-2 very-tiny-text text-mid-grey"
        >For your donation receipt. Nothing else is needed right now.</div>
      </t>
      <!-- Privacy consent -->
      <t t-call="theme_compassion_2025.FormFieldComponent">
        <t t-set="top_class" t-value="'my-3'" />
        <div class="d-flex align-items-center">
          <input
            type="checkbox"
            id="donor_privacy_consent"
            name="privacy_consent"
            class="flex-shrink-0"
            required=""
          />
          <label
            class="ms-2 mb-0 tiny-text text-mid-grey"
            for="donor_privacy_consent"
          >
                    I accept the privacy policy as described in the
                    <a
              href="/legal"
              class="tiny-text bold text-core-blue"
            >privacy notice</a>.
                </label>
        </div>
      </t>
      <div class="d-flex flex-column align-items-stretch">
        <t t-call="theme_compassion_2025.ThemedButtonComponent">
          <t t-set="variant" t-value="'compact'" />
          <t t-set="variation" t-value="'filled'" />
          <t t-set="label">Continue to payment</t>
          <t t-set="color" t-value="'mid-green'" />
          <t t-set="text_color" t-value="'pure-white'" />
        </t>
      </div>
    </form>
  </template>
  <!-- GIFT PACKAGE PAGE -->
  <template id="my2_gift_package_page" name="Gift Package Page">
    <t t-set="additional_title">Gift Basket</t>
    <t t-call="website.layout">
      <div class="container">
        <div class="single-column my2_gift_package">
          <!-- HELP MODAL -->
          <t t-call="my_compassion.GivingLimitsModalComponent">
            <t t-set="modal_id" t-value="'help-modal'" />
          </t>
          <!-- EDIT DONATION MODAL -->
          <div
            class="modal fade"
            id="edit-donation-modal"
            tabindex="-1"
            role="dialog"
            aria-labelledby="edit-donation-modal-title"
            aria-hidden="true"
          >
            <div class="modal-dialog" role="document">
              <div class="modal-content border-0">
                <div class="modal-body">
                  <button
                    type="button"
                    class="btn-close mt-3 me-3 icon-x-circle body-large text-mid-grey"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                  />
                  <div
                    id="edit-donation-form"
                    class="d-flex justify-content-center"
                    data-edit-mode="true"
                  />
                </div>
              </div>
            </div>
          </div>
          <div class="px-3 mt-4 d-flex flex-column align-items-center">
            <!-- TITLE -->
            <t t-call="theme_compassion_2025.TitleComponent">
              <t t-set="title_content">Gift Basket</t>
              <t t-set="color" t-value="'core-blue'" />
              <t t-set="show_underline" t-value="True" />
              <t t-set="underline_color" t-value="'low-yellow'" />
              <t t-set="icon" t-value="'gift02'" />
            </t>
            <!-- HELP -->
            <button
              type="button"
              class="body-large icon-help-circle text-mid-grey"
              data-bs-toggle="modal"
              data-bs-target="#help-modal"
            />
            <!-- DESCRIPTION -->
            <div class="mt-3 px-4 body-small text-center">
                            Your donations will have an everlasting impact.
                        </div>
            <!-- FAILED PAYMENT (back from the payment, see my2_gifts_thank_you_page) -->
            <div
              t-if="payment_failed"
              class="mt-3 p-3 w-100 rounded-lg bg-low-eggshell text-mid-orange body-small text-center"
              role="alert"
            >Your payment did not go through. Please try again, or use another card.</div>
            <!-- GIFT PACKAGE CONTENT -->
            <div
              id="gift-package-content-wrapper"
              class="w-100 d-flex flex-column align-items-stretch"
            >
              <!-- RENDER INITIAL CONTENT -->
              <t t-call="my_compassion.my2_gift_package_content" />
            </div>
            <!-- ADD GIFT & PAYMENT -->
            <div
              class="gift-package-payment-container mt-5 mb-4 w-100 align-self-center"
            >
              <div class="d-flex flex-column align-items-stretch">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                  <t t-set="variant" t-value="'compact'" />
                  <t t-set="variation" t-value="'hollow'" />
                  <t t-set="label">Add a gift</t>
                  <t t-set="icon" t-value="'icon-plus'" />
                  <t t-set="color" t-value="'mid-green'" />
                  <t t-set="text_color" t-value="'mid-green'" />
                  <t t-set="icon_color" t-value="'mid-green'" />
                  <t t-set="href" t-value="'/my2/gift-package/add'" />
                </t>
                <div t-if="len(order.order_line) &gt;= 1" class="empty-order-hidden">
                  <!-- A visitor first says who gives (email only) -->
                  <t t-if="donor_needed" t-call="my_compassion.my2_gift_package_donor_form" />
                  <t t-else="">
                    <div
                      t-if="donor_email"
                      class="mt-3 body-small text-low-black text-center"
                    >
                                            Your receipt goes to <span
                        class="bold"
                        t-out="donor_email"
                      />. <a
                        href="/my2/gift-package?change_donor=1"
                        class="body-small bold text-core-blue"
                      >Change</a>
                                        </div>
                    <t t-call="my_compassion.CheckoutComponent" />
                  </t>
                  <div
                    class="mt-3 px-5 d-flex align-items-center"
                    name="checkout_payment_brands"
                  >
                    <img
                      alt="Mastercard"
                      class="px-1 col-3"
                      src="/my_compassion/static/src/img/mastercard.png"
                    />
                    <img
                      alt="Visa"
                      class="px-1 col-3"
                      src="/my_compassion/static/src/img/visa.png"
                    />
                    <img
                      t-if="website._my2_offers_payment_method('blik')"
                      alt="BLIK"
                      class="px-1 col-3"
                      src="/payment/static/img/blik.png"
                    />
                  </div>
                  <div class="mt-3 body-small bold text-mid-green text-center">
                                        <i class="mt-n1 icon-lock03" />
                                        Secure checkout
                                    </div>
                  <div class="mt-1 tiny-text text-mid-grey text-center">
                                        Learn more in our
                                        <a href="/legal">Privacy Policy</a>
                                    </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>
