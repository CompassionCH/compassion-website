<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Donations Page

    Description:
    This page allows users to manage and review their donations and sponsorships.
    It provides:
      - A list of active sponsorships with monthly cost summaries.
      - A section showing open (unpaid) invoices related to sponsorships.
      - A paginated donation history with amount and beneficiary details.
      - Anchors where country layers inject their own donation documents.

    Used in routes:
    - /my2/donations/
    - /my2/donations/page/<int:invoice_page>
    - /my2/donations/history (JSON endpoint for history updates)

    Injected data:
    - active_sponsorships (recordset): Sponsorships in active state for the logged-in partner.
    - tot_cost_per_frequency (dict): Total sponsorship cost grouped by frequency and currency.
    - due_invoices (recordset): Outstanding invoices not yet paid.
    - paid_invoices_subset (recordset): Subset of paid invoices for donation history.
    - current_page (int): Current donation history page number.
    - total_pages (int): Total number of donation history pages.

    Notes:
    - Currently only the monthly payments are available but in the future this page should address also the other frequencies
-->
<odoo>
  <data>
    <template id="my2_my_donations_page" name="My Account Donations Details">
      <t t-set="additional_title">My Donations</t>
      <t t-call="website.layout">
        <div class="container">
          <div class="single-column">
            <!-- TITLE-->
            <div class="my-5">
              <t t-call="theme_compassion_2025.TitleComponent">
                <t t-set="title_content">My donations and documents</t>
                <t t-set="title_size" t-value="'md'" />
                <t t-set="color" t-value="'core-blue'" />
                <t t-set="show_underline" t-value="True" />
                <t t-set="underline_color" t-value="'low-yellow'" />
              </t>
            </div>
            <!-- MY DONATION DETAILS -->
            <div name="donations_details" />
            <!-- MY SPONSORSHIPS -->
            <div>
              <h3 class="text-dark-blue">My sponsorships</h3>
              <p>
                                You currently have
                                <span class="body-small bold">
                <t t-out="len(active_sponsorships)" />
              </span>
                                active
                                sponsorship(s) for a total of
                                <!-- Currently only the monthly payments are available
                                 but in the future this should address also the other frequencies-->
                                <t t-if="1 in tot_cost_per_frequency">
                <t t-foreach="tot_cost_per_frequency[1].items()" t-as="currency_total">
                  <span class="body-small bold">
                                            <t t-out="'%.2f' % currency_total[1]" />
                                            <t t-out="currency_total[0]" />
                                            /month.
                                        </span>
                  <t t-if="not currency_total_last">,</t>
                </t>
              </t>
              <span name="donations_sponsorships_hint" />
            </p>
              <t t-foreach="active_sponsorships" t-as="sponsorship">
                <t t-if="sponsorship">
                  <div class="mb-4">
                    <t t-call="my_compassion.SponsorshipDonationItem">
                      <t t-set="sponsorship" t-value="sponsorship" />
                    </t>
                  </div>
                </t>
              </t>
            </div>
            <!-- DUE INVOICES -->
            <div class="mb-4 mt-4">
              <h3 class="text-dark-blue">Open contributions</h3>
              <p>
                                Your latest payments may not already be taken into
                                account.
                            </p>
              <t t-if="due_invoices">
                <div class="row mb-2">
                  <div class="col text-core-blue body-small-bold">Month</div>
                  <div class="col text-core-blue body-small-bold">Child</div>
                  <div class="col text-end text-core-blue body-small-bold">Amount</div>
                </div>
                <t t-foreach="due_invoices" t-as="invoice">
                  <t
                    t-set="children"
                    t-value="invoice.invoice_line_ids.mapped('contract_id.child_id')"
                  />
                  <div class="row mb-3">
                    <div class="col">
                      <t
                        t-out="invoice.get_date('invoice_date', 'MMMM yyyy').title()"
                      />
                    </div>
                    <div class="col">
                      <t
                        t-out="children.get_list('preferred_name', 3, children.get_number())"
                      />
                    </div>
                    <div class="col text-end">
                      <t t-out="int(invoice.amount_total)" />
                      <t t-out="invoice.currency_id.display_name" />
                    </div>
                  </div>
                </t>
              </t>
              <t t-else="">
                <p class="mb-3">No due invoices.</p>
              </t>
            </div>
            <!-- DONATION HISTORY -->
            <t t-call="my_compassion.my2_donations_history_content" />
          </div>
        </div>
      </t>
    </template>
    <!-- DONATION HISTORY -->
    <template id="my2_donations_history_content" name="Donation History Content">
      <div id="donation_history_container">
        <div class="mb-4 mt-4">
          <h3 class="text-dark-blue">Donations history</h3>
          <t t-if="total_pages > 0">
            <div class="row font-weight-bold mb-2">
              <div class="col text-core-blue">Date</div>
              <div class="col text-core-blue">
                                Details of
                                donation
                            </div>
              <div class="col text-end text-core-blue">Amount</div>
            </div>
            <div id="donation_history_rows">
              <t t-foreach="paid_invoices_subset" t-as="invoice">
                <t
                  t-set="children"
                  t-value="invoice.invoice_line_ids.mapped('contract_id.child_id')"
                />
                <t
                  t-set="gift_types"
                  t-value="invoice.invoice_line_ids.get_list('gift_id.name')"
                />
                <div class="row p-2 border-bottom">
                  <div class="col">
                    <span t-out="invoice.last_payment" />
                  </div>
                  <div class="col">
                    <t
                      t-out="children.get_list('preferred_name', 3, children.get_number())"
                    />
                    <t t-if="invoice.invoice_category == 'gift'">
                      <t t-if="gift_types">
                                                :
                                                <t t-out="gift_types" />
                                            </t>
                      <t t-else="">
                                                :
                                                <t
                        t-out="invoice.invoice_line_ids.get_list('product_id.name')"
                      />
                                            </t>
                    </t>
                    <t t-if="invoice.invoice_category == 'fund'">
                                            Donation for :
                                            <t
                      t-out="invoice.invoice_line_ids.get_list('product_id.name')"
                    />
                                        </t>
                    <t t-if="invoice.invoice_category == 'sponsorship'">
                      <span>(Sponsorship)</span>
                    </t>
                  </div>
                  <div class="col text-end">
                    <span t-out="int(invoice.amount_total)" />
                    <span t-out="invoice.currency_id.display_name" />
                  </div>
                </div>
              </t>
            </div>
            <!-- Pager -->
            <div class="d-flex justify-content-center align-items-center mb-5">
              <!-- Prev -->
              <t t-if="current_page > 1">
                <a id="history_pager_prev" t-att-data-page="current_page - 1">
                  <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variation" t-value="'hollow'" />
                    <t t-set="color" t-value="'mid-blue'" />
                    <t t-set="text_color" t-value="'low-black'" />
                    <t t-set="variant" t-value="'compact'" />
                    <t t-set="label">Prev</t>
                  </t>
                </a>
              </t>
              <!-- Page indicator -->
              <span id="pageIndicator" class="p-2">
                                Page
                                <t t-out="current_page" />
                                of
                                <t t-out="total_pages" />
                            </span>
              <!-- Next -->
              <t t-if="current_page &lt; total_pages">
                <a id="history_pager_next" t-att-data-page="current_page + 1">
                  <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variation" t-value="'hollow'" />
                    <t t-set="color" t-value="'mid-blue'" />
                    <t t-set="text_color" t-value="'low-black'" />
                    <t t-set="variant" t-value="'compact'" />
                    <t t-set="label">Next</t>
                  </t>
                </a>
              </t>
            </div>
          </t>
          <t t-else="">
            <p class="mb-3">No donation history found.</p>
          </t>
        </div>
      </div>
    </template>
  </data>
</odoo>
