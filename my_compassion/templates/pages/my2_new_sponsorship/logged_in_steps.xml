<?xml version="1.0" encoding="utf-8" ?>
<!-- Part of the new-sponsorship wizard page - see my2_new_sponsorship_wizard.xml
     in this folder for the full page doc header.

     The four steps STEPS_CONFIGS lists under "logged_in" (new.sponsorship
     .wizard.STEPS_CONFIGS), used instead of the fast-checkout steps when the
     browser session was already logged in when starting a new sponsorship.
     Not equally alive: my2_new_sponsorship_wizard_payment_method is the one
     actually reachable and depended on (my_compassion_switzerland's eBill
     extension inherits it). my2_new_sponsorship_wizard_wap_options is
     reachable but has no test/extension exercising it today.
     my2_new_sponsorship_wizard_user_details and
     _communication_details are not referenced by any current STEPS_CONFIGS
     entry, public or logged_in - kept as data/templates only. -->
<odoo>
  <!-- NEW SPONSORSHIP WIZARD USER DETAILS STEP -->
  <template
    id="my2_new_sponsorship_wizard_user_details"
    name="New Sponsorship Wizard User Details Step"
  >
    <div class="mb-3 p-3 rounded-lg bg-light-blue tiny-text">
            Already have an account?
            <a
      t-att-href="login_url_redirect"
      class="tiny-text bold text-core-blue"
    >Log in</a>
        </div>
    <!-- Salutation -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Salutation</t>
      <t t-set="input_id" t-value="'title'" />
      <t t-call="theme_compassion_2025.SelectComponent">
        <t t-set="name" t-value="'title'" />
        <t t-set="id" t-value="'title'" />
        <t t-set="required" t-value="True" />
        <option value="">Please select</option>
        <t t-foreach="titles" t-as="title">
          <option t-att-selected="title.id == wizard.title.id" t-att-value="title.id">
            <t t-out="title.name" />
          </option>
        </t>
      </t>
    </t>
    <!-- Surname -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Surname</t>
      <t t-set="input_id" t-value="'lastname'" />
      <input
        id="lastname"
        type="text"
        name="lastname"
        class="form-control"
        t-att-value="wizard.lastname"
        required=""
      />
    </t>
    <!-- Firstname -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Firstname</t>
      <t t-set="input_id" t-value="'firstname'" />
      <input
        id="firstname"
        type="text"
        name="firstname"
        class="form-control"
        t-att-value="wizard.firstname"
        required=""
      />
    </t>
    <!-- Date of birth -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Date of birth</t>
      <t t-set="input_id" t-value="'birthdate'" />
      <input
        id="birthdate"
        type="date"
        name="birthdate"
        class="form-control"
        t-att-value="wizard.birthdate"
        required=""
      />
    </t>
    <!-- Email -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">E-mail</t>
      <t t-set="input_id" t-value="'email'" />
      <input
        type="email"
        name="email"
        class="form-control"
        t-att-value="wizard.email"
        data-validate-type="email"
        required=""
      />
    </t>
    <!-- Phone -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Phone number</t>
      <t t-set="input_id" t-value="'phone'" />
      <input
        id="phone"
        type="tel"
        name="phone"
        class="form-control"
        t-att-value="wizard.phone"
        data-validate-type="phone"
        required=""
      />
    </t>
    <!-- Street -->
    <div class="d-flex">
      <div class="w-100 flex-grow-1">
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'my-3'" />
          <t t-set="label">Street</t>
          <t t-set="input_id" t-value="'street'" />
          <input
            id="street"
            type="text"
            name="street"
            class="form-control"
            t-att-value="wizard.street"
            required=""
          />
        </t>
      </div>
      <div class="flex-shrink-1 ms-4">
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'my-3'" />
          <t t-set="label">N°</t>
          <t t-set="input_id" t-value="'street_number'" />
          <input
            id="street_number"
            type="text"
            name="street_number"
            class="form-control"
            t-att-value="wizard.street_number"
            required=""
          />
        </t>
      </div>
    </div>
    <!-- Locality -->
    <div class="d-flex">
      <div class="flex-shrink-1 me-4">
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'my-3'" />
          <t t-set="label">Code</t>
          <t t-set="input_id" t-value="'zip'" />
          <input
            id="zip"
            type="text"
            name="zip"
            class="form-control"
            t-att-value="wizard.zip"
            required=""
          />
        </t>
      </div>
      <div class="w-100 flex-grow-1">
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'my-3'" />
          <t t-set="label">Locality</t>
          <t t-set="input_id" t-value="'city'" />
          <input
            id="city"
            type="text"
            name="city"
            class="form-control"
            t-att-value="wizard.city"
            required=""
          />
        </t>
      </div>
    </div>
    <!-- Country -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Country</t>
      <t t-set="input_id" t-value="'country'" />
      <t t-call="theme_compassion_2025.SelectComponent">
        <t t-set="name" t-value="'country'" />
        <t t-set="id" t-value="'country'" />
        <t t-set="required" t-value="True" />
        <option value="">Please select</option>
        <t t-foreach="countries" t-as="country">
          <option
            t-att-selected="country.id == wizard.country.id"
            t-att-value="country.id"
          >
            <t t-out="country.name" />
          </option>
        </t>
      </t>
    </t>
  </template>
  <!-- NEW SPONSORSHIP WIZARD PAYMENT METHODS STEP -->
  <template
    id="my2_new_sponsorship_wizard_payment_method"
    name="New Sponsorship Wizard Payment Methods Step"
  >
    <!-- Payment method -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Payment method</t>
      <t t-set="input_id" t-value="'payment_method'" />
      <t t-call="theme_compassion_2025.SelectComponent">
        <t t-set="name" t-value="'payment_method'" />
        <!-- ID used by eBill extension in my_compassion_switzerland -->
        <t t-set="id" t-value="'payment_method'" />
        <t t-set="required" t-value="True" />
        <option value="">Please select</option>
        <t t-foreach="payment_methods" t-as="payment_method">
          <option
            t-att-selected="payment_method.id == wizard.payment_method.id"
            t-att-value="payment_method.id"
            t-att-data-payment-code="payment_method.payment_method_id.code"
          >
            <t t-out="payment_method.name" />
          </option>
        </t>
      </t>
    </t>
    <!-- Sponsorship plus -->
    <t t-call="my_compassion.my2_new_sponsorship_wizard_sponsorship_plus" />
  </template>
  <!-- NEW SPONSORSHIP WIZARD WRITE & PRAY OPTIONS STEP -->
  <template
    id="my2_new_sponsorship_wizard_wap_options"
    name="New Sponsorship Write &amp; Pray Options Step"
  >
    <t t-if="wizard.birthdate">
      <input type="hidden" name="birthdate" t-att-value="wizard.birthdate" />
    </t>
    <t t-else="">
      <div class="alert alert-info mb-3 rounded-lg body-small">
                Write&amp;Pray sponsorships are available for people under the age of 25. Please provide your date of birth.
            </div>
      <t t-call="theme_compassion_2025.FormFieldComponent">
        <t t-set="top_class" t-value="'my-3'" />
        <t t-set="label">Date of birth</t>
        <t t-set="input_id" t-value="'birthdate'" />
        <input id="birthdate" type="date" name="birthdate" required="required" />
      </t>
    </t>
    <!-- Contribute -->
    <div class="my-3">
      <div class="ms-2 mt-2 d-flex">
        <input
          type="radio"
          value="false"
          class="wap-contribute flex-shrink-0"
          name="contribute"
          id="contribute-false"
          t-att-checked="wizard.wap_contribution_amount == 0"
        />
        <label class="mx-3 mb-0 body-small flex-grow-1" for="contribute-false">
                    I agree to pray for and write to my sponsored child regularly. I understand that another person is
                    providing
                    financial support for this sponsorship, but that I am the child's official sponsor.
                </label>
      </div>
      <div class="ms-2 mt-4 d-flex">
        <input
          type="radio"
          value="true"
          class="wap-contribute flex-shrink-0"
          name="contribute"
          id="contribute-true"
          t-att-checked="wizard.wap_contribution_amount != 0"
        />
        <label class="mx-3 mb-0 body-small flex-grow-1" for="contribute-true">
                    I commit to praying for and writing to my sponsored child regularly, and I can contribute monthly
                    in the amount of:
                </label>
      </div>
      <!-- Contribution amount -->
      <div id="wap-contribution-amount">
        <t
          t-set="amounts"
          t-value="wap_suggested_amounts or [
                    { 'name': 'low', 'amount': 5 },
                    { 'name': 'medium', 'amount': 10 },
                    { 'name': 'high', 'amount': 20 },
                ]"
        />
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'mt-4 w-100'" />
          <t t-set="label">Suggested amounts</t>
          <div class="mt-1 d-flex justify-content-between">
            <t t-foreach="amounts" t-as="amount">
              <t t-if="amount_index &gt; 0" t-set="margin" t-value="'ms-3'" />
              <div t-attf-class="contribution-suggested-amount flex-grow-1 #{margin}">
                <input
                  t-attf-id="suggested-#{amount['name']}"
                  type="radio"
                  t-attf-name="suggested_amount"
                  t-att-value="amount['amount']"
                  t-att-checked="wizard.wap_contribution_amount == amount['amount'] or (amount['name'] == 'low' and wizard.wap_contribution_amount == 0)"
                  class="suggested-amount"
                />
                <label class="mb-0 w-100" t-attf-for="suggested-#{amount['name']}">
                  <t t-out="currency_name" />
                  <t t-out="amount['amount']" />
                </label>
              </div>
            </t>
          </div>
        </t>
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'mt-3 w-100'" />
          <t t-set="label">Or enter your own amount</t>
          <div class="contribution-suggested-amount">
            <input
              t-attf-id="suggested-custom"
              type="radio"
              t-attf-name="suggested_amount"
              value="custom"
              t-att-checked="wizard.wap_contribution_amount not in [amount['amount'] for amount in amounts] + [0]"
              class="suggested-amount"
            />
            <label
              class="mb-0 w-100"
              t-attf-for="suggested-custom"
            >Custom amount</label>
          </div>
        </t>
        <t t-call="theme_compassion_2025.FormFieldComponent">
          <t t-set="top_class" t-value="'custom-amount-field mt-2 w-100'" />
          <input
            type="text"
            name="custom_amount"
            data-validate-type="number"
            t-att-placeholder="currency_name"
            class="form-control"
            t-att-value="'{:g}'.format(wizard.wap_contribution_amount) if wizard.wap_contribution_amount else ''"
            required=""
          />
        </t>
      </div>
    </div>
  </template>
  <!-- NEW SPONSORSHIP WIZARD COMMUNICATION DETAILS STEP -->
  <template
    id="my2_new_sponsorship_wizard_communication_details"
    name="New Sponsorship Wizard Communication Details Step"
  >
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">Spoken languages</t>
      <div
      >For correspondence with my sponsored child, I also understand the following languages:</div>
      <t t-foreach="spoken_languages" t-as="language">
        <div class="ms-2 mt-2 d-flex align-items-center">
          <input
            type="checkbox"
            t-att-value="language.id"
            class="flex-shrink-0"
            t-attf-name="spoken_language_#{language.id}"
            t-att-id="'language_' + str(language.id)"
            t-att-checked="language in wizard.spoken_languages"
          />
          <label
            class="ms-2 mb-0 body-small"
            t-att-for="'language_' + str(language.id)"
          >
            <t t-out="language.name" />
          </label>
        </div>
      </t>
    </t>
    <!-- Lead source -->
    <t t-call="theme_compassion_2025.FormFieldComponent">
      <t t-set="top_class" t-value="'my-3'" />
      <t t-set="label">How did you hear about Compassion?</t>
      <t t-set="input_id" t-value="'lead_source'" />
      <t t-call="theme_compassion_2025.SelectComponent">
        <t t-set="name" t-value="'lead_source'" />
        <t t-set="id" t-value="'lead_source'" />
        <t t-set="required" t-value="True" />
        <option value="">Please select</option>
        <t t-foreach="lead_sources" t-as="lead_source">
          <option
            t-att-selected="lead_source.id == wizard.lead_source.id"
            t-att-value="lead_source.id"
          >
            <t t-out="lead_source.name" />
          </option>
        </t>
      </t>
    </t>
  </template>
</odoo>
