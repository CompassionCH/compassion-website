<?xml version="1.0" encoding="utf-8" ?>
<!-- TODO DOC -->
<odoo>
    <template id="my2_child_timeline_page" name="My Compassion 2 Child Timeline Page">
        <t t-call="website.layout">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <span>Child Timeline Page</span>
                    </div>
                </div>
                <div>
                    <br/>
                    DEBUG <br/>
                    <span style="color: green" t-esc="compassion_child"/>
                </div>

                <div class="row">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t t-call="my_compassion.my2_children_profile_component">
                            <!-- The data we are passing to the children_card_component -->
                            <t t-set="compassion_child" t-value="compassion_child"/>
                        </t>
                    </div>
                </div>

                <!-- Buttons (More Info, New Letter, New Gift) -->
                <div class="row">
                    <button type="button" class="btn btn-block rounded btn-primary">
                        <span class="fa font-weight-light">+</span>
                        More Info
                    </button>
                </div>
            </div>
        </t>
    </template>
</odoo>