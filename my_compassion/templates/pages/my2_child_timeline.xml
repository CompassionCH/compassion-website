<?xml version="1.0" encoding="utf-8" ?>
<!-- TODO DOC -->
<odoo>
    <template id="my2_child_timeline_page" name="My Compassion 2 Child Timeline Page">
        <t t-call="website.layout">
            <div class="container">
                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumb"/>
                <div class="row mb-2">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t t-call="my_compassion.my2_children_profile_component">
                            <!-- The data we are passing to the children_card_component -->
                            <t t-set="compassion_child" t-value="compassion_child"/>
                        </t>
                    </div>
                </div>

                <!-- Buttons (More Info, New Letter, New Gift) -->
                <div class="row mb-3">
                    <div class="col-12">
                        <a t-att-href="'/my2/children/' + str(compassion_child.id) + '/details'">
                            <button type="button"
                                    class="btn-compassion btn-compassion-blue">
                                <span class="font-weight-bold">
                                    More Info
                                </span>
                            </button>
                        </a>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-6 text-center">
                        <a t-att-href="'/my2/children/' + str(compassion_child.id) + '/letter/new'">
                            <button type="button"
                                    class="btn-compassion btn-compassion-white">
                                <span>
                                    New letter
                                </span>
                            </button>
                        </a>
                    </div>
                    <div class="col-6 text-center">
                        <button type="button"
                                class="btn-compassion btn-compassion-white">
                            <span>
                                New gift
                            </span>
                        </button>
                    </div>
                </div>
                <!-- Timeline -->
                <div class="row mb-3">
                    <div class="col-1">
                        |
                    </div>
                    <div class="col-2">
                        <i class="fa fa-gift"></i>
                    </div>
                    <div class="col-9">
                        <p>Family gift</p>
                        <p>CHF 10.-</p>
                        <p>10 September 2024</p>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>