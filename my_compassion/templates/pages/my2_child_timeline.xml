<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Timeline Page

    Description:
    This page displays a chronological timeline of key events related to a sponsored child,
    such as gifts, letters, and other sponsorship activities.

    Used in route:
    - /my2/children/<int:child_id>/

    Injected data:
    - compassion_child (record): The related child object.

    TO DO: inject a list of significant sponsorship events.
-->
<odoo>
    <template id="my2_child_timeline_page" name="My Compassion 2 Child Timeline Page">
        <link rel="stylesheet"
                      href="/my_compassion/static/src/css/child_profile.css"/>
        <t t-call="website.layout">
            <div class="container">
                <div class="content-column">
                    <div class="d-flex flex-column flex-md-row pt-4">
                        <!-- ### Portrait ### -->
                        <div class="child-details-container">
                            <t t-call="theme_compassion_2025.PortraitComponent">
                                <t t-set="title" t-value="compassion_child.preferred_name"/>
                                <t t-set="src" t-value="'/web/image/compassion.child/' + str(compassion_child.id) + '/portrait'"/>
                                <t t-set="alt" t-value="'Portrait of ' + compassion_child.preferred_name"/>
                                <t t-set="size" t-value="'large'"/>
                            </t>
                        </div>

                        <!-- Child info and buttons actions -->
                        <div class="d-flex flex-column flex-md-column-reverse">
                            <!-- ### Action buttons ### -->
                            <div class="child-action-buttons justify-content-md-start ml-md-3 pb-3 p-md-0">
                                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                    <t t-set="variant" t-value="'compact'"/>
                                    <t t-set="variation" t-value="'hollow'"/>
                                    <t t-set="label" t-value="'Write a letter'"/>
                                    <t t-set="color" t-value="'core-blue'"/>
                                    <t t-set="text_color" t-value="'core-blue'"/>
                                </t>
                                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                    <t t-set="variant" t-value="'compact'"/>
                                    <t t-set="variation" t-value="'hollow'"/>
                                    <t t-set="label" t-value="'Give a gift'"/>
                                    <t t-set="color" t-value="'core-blue'"/>
                                    <t t-set="text_color" t-value="'core-blue'"/>
                                </t>
                            </div>

                            <!-- ### Child personal information ### -->
                            <div class="child-personal-information d-flex flex-column flex-grow-1 mt-md-3 ml-md-3">
                                <div class="child-info-item d-flex align-items-center">
                                    <div class="frame bg-core-blue mr-2">
                                        <i class="icon icon-calendar-heart02 text-pure-white m-2"></i>
                                    </div>
                                    <!-- TODO: Handle language changes for birthday -->
                                    <!-- TODO: Put that in the backend -->
                                    <t t-set="day" t-value="compassion_child.birthdate.day"/>
                                    <t t-set="month" t-value="compassion_child.birthdate.strftime('%B')"/>
                                    <t t-set="suffix" t-value="'th'"/>

                                    <t t-if="day in [1, 21, 31]">
                                        <t t-set="suffix" t-value="'st'"/>
                                    </t>
                                    <t t-elif="day in [2, 22]">
                                        <t t-set="suffix" t-value="'nd'"/>
                                    </t>
                                    <t t-elif="day in [3, 23]">
                                        <t t-set="suffix" t-value="'rd'"/>
                                    </t>

                                    <p class="child-info-text">
                                        My birthday is the
                                        <span class="text-core-blue font-weight-bold"><t t-esc="day"/><t t-esc="suffix"/> <t t-esc="month"/></span>
                                    </p>
                                </div>
                                <div class="child-info-item d-flex align-items-center">
                                    <div class="frame bg-mid-green mr-2">
                                        <i class="icon icon-heart text-pure-white m-2"></i>
                                    </div>
                                    <p class="child-info-text">
                                        <span class="text-mid-green font-weight-bold">
                                            I love
                                        </span>
                                        <t t-esc="compassion_child.get_list('hobby_ids.value')"/>
                                    </p>
                                </div>
                                <div class="child-info-item d-flex align-items-center">
                                    <div class="frame bg-mid-pink mr-2">
                                        <i class="icon icon-graduation-hat02 text-pure-white m-2"></i>
                                    </div>
                                    <p class="child-info-text">
                                        I'm in
                                        <span class="text-mid-pink font-weight-bold"><t t-esc="compassion_child.translate('education_level')"/></span>
                                        <span>and my favourite subjects are</span>
                                        <t t-esc="compassion_child.get_list('subject_ids.value')"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ### Child related information (family, project and country) ### -->
                    <div class="child-related-information tabs-component">
                        <!-- Mobile Dropdown (Visible on small screens) -->
                        <div class="d-block d-md-none mb-3">
                            <select class="form-control custom-select" id="child-info-tabs-mobile">
                                <option value="#family-tab" selected="1">My Family</option>
                                <option value="#project-tab">My Project</option>
                                <option value="#country-tab">My Country</option>
                            </select>
                        </div>

                        <!-- Desktop Tabs (Visible on medium screens and up) -->
                        <ul class="nav nav-tabs d-none d-md-flex" id="child-info-tabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <a class="nav-link active"
                                   id="family-tab-link"
                                   data-toggle="tab"
                                   href="#family-tab"
                                   role="tab"
                                   aria-controls="family-tab"
                                   aria-selected="true">
                                    My Family
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link"
                                   id="project-tab-link"
                                   data-toggle="tab"
                                   href="#project-tab"
                                   role="tab"
                                   aria-controls="project-tab"
                                   aria-selected="false">
                                    My Project
                                </a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link"
                                   id="country-tab-link"
                                   data-toggle="tab"
                                   href="#country-tab"
                                   role="tab"
                                   aria-controls="country-tab"
                                   aria-selected="false">
                                    My Country
                                </a>
                            </li>
                        </ul>

                        <!-- Tab Content -->
                        <div class="tab-content pt-4" id="child-info-tabs-content">
                            <div class="tab-pane fade show active"
                                 id="family-tab"
                                 role="tabpanel"
                                 aria-labelledby="family-tab-link">
                                <h5>About my family</h5>
                            </div>
                            <div class="tab-pane fade" id="project-tab" role="tabpanel" aria-labelledby="project-tab-link">
                                <h5>About my project</h5>
                            </div>
                            <div class="tab-pane fade" id="country-tab" role="tabpanel" aria-labelledby="country-tab-link">
                                <h5>About my country</h5>
                            </div>
                        </div>
                    </div>

                    <!-- ### Partner and child timeline title ### -->
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content" t-value="'Timeline'"/>
                        <t t-set="title_size" t-value="'md'"/>
                        <t t-set="color" t-value="'core-blue'"/>
                        <t t-set="show_underline" t-value="True"/>
                        <t t-set="underline_color" t-value="'low-yellow'"/>
                        <t t-set="description" t-value="'Follow the thread of hope and
                        encouragement you’ve woven together.'"/>
                    </t>

                    <!-- ### Partner and child timeline component ### -->
                </div>
            </div>
        </t>
    </template>
</odoo>