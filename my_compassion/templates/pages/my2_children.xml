<?xml version="1.0" encoding="utf-8" ?>
<!-- TODO DOC -->
<odoo>
    <template id="my2_children_page" name="My Compassion 2 Children Page">
        <link rel="stylesheet" href="/my_compassion/static/src/css/line-divider.css"/>
        <t t-call="website.layout">
            <t t-set="child_name" t-value="'Oh no'"/>
            <div class="container">
                <div class="row">
                    <span>Your sponsorships</span>
                </div>
                <div>
                    <p>DEBUG</p>
                    <span style="color: green" t-esc="sponsorship_ids"/>
                </div>
                <t t-foreach="sponsorship_ids" t-as="sponsorship">
                    <div class="row">
                        <!-- Using card component -->
                        <t t-call="my_compassion.my2_children_card_component">
                            <!-- The data we are passing to the children_card_component -->
                            <t t-set="child_id" t-value="sponsorship.child_id.id"/>
                            <t t-set="child_local_id"
                               t-value="sponsorship.child_id.local_id"/>
                            <t t-set="child_name" t-value="sponsorship.child_name"/>
                            <t t-set="child_age" t-value="sponsorship.child_age"/>
                            <t t-set="child_country"
                               t-value="sponsorship.child_id.field_office_id.name"/>
                        </t>
                    </div>
                </t>
                <div class="row">
                    <button type="button" class="btn btn-block rounded btn-primary">
                        <span class="fa font-weight-light">+</span>
                        New Sponsorship
                    </button>
                </div>
                <div class="row">
                    <div class="line-divider-container">
                        <div class="line-divider"/>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>