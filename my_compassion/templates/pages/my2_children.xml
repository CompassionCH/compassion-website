<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Children Page

    Description:
    This page displays all sponsorships linked to the user, categorized into active and terminated sponsorships.

    Used in route:
    - /my2/children/

    Injected data:
    - sponsorship_ids (array of 'recurring_contract' records): The sponsorships associated with the user.
-->
<odoo>
    <template id="my2_children_page" name="My Compassion 2 Children Page">

        <t t-call="website.layout">
            <div class="container">

                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumbs">
                    <t t-set="breadcrumbs" t-value="breadcrumbs"/>
                </t>

                <!-- Title -->
                <t t-call="theme_compassion_2025.TitleComponent">
                    <t t-set="title_content" t-value="'Your sponsorships'"/>
                    <t t-set="title_size" t-value="'lg'"/>
                    <t t-set="color" t-value="'low-blue'"/>
                    <t t-set="underline_color" t-value="'mid-orange'"/>
                    <t t-set="show_underline" t-value="True"/>
                    <t t-set="description"
                       t-value="'Hearts grow stronger with each act of care through your sponsorship.'"/>
                </t>

                <!-- NEW SPONSORSHIP BUTTON -->
                <div class="row justify-content-center mb-3">
                    <a t-attf-href="/my2/children/new_sponsorship">
                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                            <t t-set="variation" t-value="'filled'"/>
                            <t t-set="color" t-value="'low-blue'"/>
                            <t t-set="text_color" t-value="'white'"/>
                            <t t-set="variant" t-value="'default'"/>
                            <t t-set="label" t-value="'New sponsorship'"/>
                        </t>
                    </a>
                </div>

                <!-- ACTIVE SPONSORSHIPS CHILDREN-->
                <div class="row g-4 mb-3">
                    <t t-foreach="sponsorship_ids" t-as="sponsorship">
                        <t t-if="sponsorship.state == 'active'">
                            <t t-call="my_compassion.my2_children_card_component">
                                <t t-set="sponsorship" t-value="sponsorship"/>
                            </t>
                        </t>
                    </t>
                </div>

                <!-- TODO: MAYBE ADD SOMETHING THAT SEPARATES, SUCH AS THE LINE THAT ALREADY APPEARS UNDER THE TITLE -->

                <!-- TERMINATED SPONSORSHIPS CHILDREN -->
                <div class="row g-4">
                    <t t-foreach="sponsorship_ids" t-as="sponsorship">
                        <t t-if="sponsorship.state == 'terminated'">
                            <t t-call="my_compassion.my2_children_card_component">
                                <t t-set="sponsorship" t-value="sponsorship"/>
                            </t>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>