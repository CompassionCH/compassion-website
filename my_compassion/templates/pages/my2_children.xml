<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Children Page

    Description:
    This page displays all sponsorships linked to the user, categorized into active and terminated sponsorships.

    Used in route:
    - /my2/children/

    Injected data:
    - sponsorship_ids (array of 'recurring_contract' records): The sponsorships associated with the user.
-->
<odoo>
    <template id="my2_children_page" name="My Compassion 2 Children Page">
        <link rel="stylesheet" href="/my_compassion/static/src/css/line-divider.css" />
        <t t-call="website.layout">
            <div class="container">
                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumbs">
                    <t t-set="breadcrumbs" t-value="breadcrumbs" />
                </t>
                <div class="row">
                    <div class="col-12">
                        <h1>Your sponsorships</h1>
                    </div>
                </div>
                <!-- ACTIVE SPONSORSHIPS CHILDREN-->
                <t t-foreach="sponsorship_ids" t-as="sponsorship">
                    <t t-if="sponsorship.state == 'active'">
                        <div class="row">
                            <!-- Using children_card component -->
                            <t t-call="my_compassion.my2_children_card_component">
                                <!-- The data we are passing to the children_card_component -->
                                <t t-set="sponsorship" t-value="sponsorship" />
                            </t>
                        </div>
                    </t>
                </t>
                <!-- + NEW SPONSORSHIP BUTTON & LINE DIVIDER -->
                <div class="row">
                    <div class="col-12">
                        <button type="button" class="btn btn-block rounded btn-primary">
                            <span class="fa font-weight-light">+</span>
                            New Sponsorship
                        </button>
                    </div>
                </div>
                <div class="row">
                    <div class="line-divider-container">
                        <div class="line-divider" />
                    </div>
                </div>
                <!-- TERMINATED SPONSORSHIPS CHILDREN -->
                <t t-foreach="sponsorship_ids" t-as="sponsorship">
                    <t t-if="sponsorship.state == 'terminated'">
                        <div class="row">
                            <!-- Using card component -->
                            <t t-call="my_compassion.my2_children_card_component">
                                <!-- The data we are passing to the children_card_component -->
                                <t t-set="child_sponsorship" t-value="sponsorship" />
                            </t>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>
</odoo>
