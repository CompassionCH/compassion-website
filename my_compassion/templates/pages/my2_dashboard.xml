<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Dashboard Page

    Description:
    This page displays a dashboard with quick access to useful pages.
    Depending on the user role (sponsor, donator or volunteer), the view displays different information and content.

    Used in route:
    - /my2/dashboard

    Injected data:
    - has_unread_correspondence: boolean, true if the user has unread correspondence
    - partner: the partner information as a logged-in user
-->
<odoo>
    <!-- DASHBOARD GRID ITEM -->
    <template id="DashboardGridItem" name="Dashboard grid item">
        <div class="col-sm my-3 flex-grow-0">
            <t t-raw="0" />
        </div>
    </template>
    <!-- DASHBOARD -->
    <template id="my2_dashboard_page" name="My Compassion 2 Dashboard Page">
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_dashboard.css" />
        <t t-call="website.layout">
            <div class="container">
                <!-- BANNER -->
                <div class="dashboard-banner d-none d-lg-block mt-4">
                    <div class="position-absolute m-5 pl-5 pt-2">
                        <h1 class="text-pure-white">
                            Welcome to the new
                            <br />
                            <span class="text-low-yellow">my</span>
                            Compassion
                        </h1>
                    </div>
                    <img src="/theme_compassion_2025/static/src/img/snippets/dashboard_banner.png" class="img-fluid" />
                </div>
                <!-- TITLE -->
                <div class="mt-4">
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content" t-value="'My hub'" />
                        <t t-set="color" t-value="'core-blue'" />
                        <t t-set="show_underline" t-value="true" />
                        <t t-set="underline_color" t-value="'low-yellow'" />
                        <t t-set="description" t-value="'Access your resources and ways to get involved.'" />
                    </t>
                </div>
                <!-- VIGNETTES AND ACTIONS RENDERING -->
                <div class="dashboard-grid row mb-4 justify-content-center">
                    <t t-foreach="sorted_vignettes" t-as="vignette">
                        <t t-call="{{ vignette['template'] }}" />
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- VIGNETTES AND ACTIONS DECLARATION -->

    <!-- SPONSORING VIGNETTE -->
    <template id="dashboard_sponsorship_vignette">
        <t t-call="my_compassion.DashboardGridItem">
            <t t-call="theme_compassion_2025.VignetteComponent">
                <t t-set="image" t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_11.jpg'" />
                <t t-if="partner.is_sponsor">
                    <t t-set="title" t-value="'You are sponsoring'" />
                    <t t-set="subtitle">
                        <span class="text-low-yellow" t-esc="vignette['number_sponsorships']" />
                        children
                    </t>
                    <t t-set="href" t-value="'/my2/children'" />
                </t>
                <t t-else="">
                    <t t-set="title">Become a sponsor</t>
                    <t t-set="subtitle">Change a child's life forever</t>
                    <t t-set="href" t-value="'/my2/sponsorships'" />
                </t>
                <t t-set="icon" t-value="'pictogram-child-sponsorship'" />
                <t t-set="color" t-value="'pure-white'" />
                <t t-set="bg_color" t-value="'core-blue'" />
                <t t-set="href" t-value="'/my2/children'" />
            </t>
            <t t-if="has_unread_correspondence">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="variant" t-value="'default'" />
                    <t t-set="variation" t-value="'hollow'" />
                    <t t-set="label" t-value="'A new letter has arrived!'" />
                    <t t-set="icon" t-value="'pictogram-child-focused'" />
                    <t t-set="color" t-value="'low-green'" />
                    <t t-set="icon_color" t-value="'low-green'" />
                    <t t-set="text_color" t-value="'low-green'" />
                    <t
                        t-set="href"
                        t-value="'/my2/children/letters?year_to=2025&amp;month_from=1&amp;month_to=12&amp;sort=newest&amp;unread=true&amp;page=1'"
                    />
                </t>
            </t>
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'default'" />
                <t t-set="variation" t-value="'filled'" />
                <t t-set="label" t-value="'Write a letter to a child'" />
                <t t-set="icon" t-value="'pictogram-letter-writing'" />
                <t t-set="color" t-value="'core-blue'" />
                <t t-set="icon_color" t-value="'low-yellow'" />
                <t t-set="text_color" t-value="'pure-white'" />
                <t t-set="href" t-value="'/my2/children/letters/new'" />
            </t>
        </t>
    </template>
    <!-- DONATION VIGNETTE -->
    <template id="dashboard_donations_vignette">
        <t t-call="my_compassion.DashboardGridItem">
            <t t-call="theme_compassion_2025.VignetteComponent" t-if="partner.is_donor">
                <t
                    t-set="image"
                    t-value="'/theme_compassion_2025/static/src/img/snippets/s_image_text.jpg'"
                />
                <t t-set="title" t-value="'My donations'" />
                <t t-set="icon" t-value="'pictogram-gift-donation-general'" />
                <t t-set="color" t-value="'high-brown'" />
                <t t-set="bg_color" t-value="'low-brown'" />
                <t t-set="href" t-value="'/my2/donations'" />
            </t>
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'default'" />
                <t t-set="variation" t-value="'filled'" />
                <t t-set="label" t-value="'Make a gift of compassion'" />
                <t t-set="icon" t-value="'pictogram-letter-writing'" />
                <t t-set="color" t-value="'mid-brown'" />
                <t t-set="icon_color" t-value="'high-brown'" />
                <t t-set="text_color" t-value="'pure-white'" />
                <t t-set="href" t-value="'/my2/gifts'" />
            </t>
         </t>
    </template>
    <!-- VOLUNTEER VIGNETTE -->
    <template id="dashboard_volunteering_vignette">
        <t t-call="my_compassion.DashboardGridItem">
            <t t-call="theme_compassion_2025.VignetteComponent">
                <t
                        t-set="image"
                        t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_13.jpg'"
                />
                <t t-set="title" t-value="'Volunteers'"/>
                <t t-set="subtitle" t-value="'We need letter translators!'"/>
                <t t-set="icon" t-value="'pictogram-local-empowerment-partnership'"/>
                <t t-set="color" t-value="'low-green'"/>
                <t t-set="bg_color" t-value="'high-green'"/>
                <t t-set="href" t-value="'/my2/volunteering'"/>
            </t>
            <t t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'default'"/>
                <t t-set="variation" t-value="'filled'"/>
                <t t-set="label" t-value="'Translate a letter'"/>
                <t t-set="icon" t-value="'pictogram-letter-writing'"/>
                <t t-set="color" t-value="'mid-green'"/>
                <t t-set="icon_color" t-value="'low-green'"/>
                <t t-set="text_color" t-value="'pure-white'"/>
                <t t-set="href" t-value="'https://translate.compassion.ch'"/>
            </t>
        </t>
    </template>
</odoo>
