<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Dashboard Page

    Description:
    This page displays a dashboard with quick access to useful pages.
    Depending on the user role (sponsor, donator or volunteer), the view displays different information and content.

    Used in route:
    - /my2/dashboard/

    Injected data:
    - ?
-->
<odoo>
    <template id="my2_dashboard_page" name="My Compassion 2 Dashboard Page">
        <t t-call="website.layout">
            <div class="container">
                <t t-call="theme_compassion_2025.TitleComponent">
                    <t t-set="title_content" t-value="'My Hub'"/>
                    <t t-set="color" t-value="'core-blue'"/>
                    <t t-set="show_underline" t-value="true"/>
                    <t t-set="underline_color" t-value="'low-yellow'"/>
                </t>
                <!-- DASHBOARD ITEMS -->
                <div class="row mb-4 justify-content-center">
                    <div class="col-sm my-3 flex-grow-0">
                        <t t-call="theme_compassion_2025.VignetteComponent">
                            <t t-set="image" t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_07.jpg'"/>
                            <t t-set="title" t-value="'My donations'"/>
                            <t t-set="icon" t-value="'pictogram-gift-donation-general'"/>
                            <t t-set="color" t-value="'high-brown'"/>
                            <t t-set="bg_color" t-value="'low-brown'"/>
                        </t>
                    </div>

                    <div class="col-sm my-3 flex-grow-0">
                        <t t-call="theme_compassion_2025.VignetteComponent">
                            <t t-set="image" t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_11.jpg'"/>
                            <t t-set="title" t-value="'You are sponsoring 4 children'"/>
                            <t t-set="icon" t-value="'pictogram-child-sponsorship'"/>
                            <t t-set="color" t-value="'pure-white'"/>
                            <t t-set="bg_color" t-value="'core-blue'"/>
                        </t>
                    </div>

                    <div class="col-sm my-3 flex-grow-0">
                        <t t-call="theme_compassion_2025.VignetteComponent">
                            <t t-set="image" t-value="'/theme_compassion_2025/static/src/img/snippets/library_image_13.jpg'"/>
                            <t t-set="title" t-value="'Volunteers'"/>
                            <t t-set="subtitle" t-value="'We need letter translators!'"/>
                            <t t-set="icon" t-value="'pictogram-local-empowerment-partnership'"/>
                            <t t-set="color" t-value="'low-green'"/>
                            <t t-set="bg_color" t-value="'high-green'"/>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>