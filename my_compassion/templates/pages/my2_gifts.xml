<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Gifts Page

    Description:
    - This page displays all gifts available for the user, categorized into gifts and funds.
    - It includes a banner, title, and a grid of vignettes representing each gift.
    - Each vignette includes an image, title, and icon, and links to the respective gift or fund page.

    Used in route:
    - /my2/gifts/ (default)
    - /my2/gifts/?type=gift
    - /my2/gifts/?type=fund (same as /my2/gifts/)

    Injected data:
    - my_compassion_gifts (array of 'my_compassion_gift' records): all the gifts of this typ (gift/fund) available.
-->
<odoo>
    <!-- GIFTS DASHBOARD -->
    <template id="my2_gifts_page" name="My Compassion 2 Gifts Page">
        <t t-call="website.layout">
            <div class="container">
                <!-- BANNER -->
                <div class="content-column mt-4">
                    <t t-call="theme_compassion_2025.BannerComponent">
                        <t t-set="title" t-value="page_content['banner_title']" />
                        <t t-set="text" t-value="page_content['banner_text']" />
                        <t t-set="btn_text" t-value="page_content['banner_btn_text']" />
                        <t t-set="btn_link" t-value="page_content['banner_btn_link']" />
                        <t t-set="pictogram" t-value="'gift-donation-general'" />
                    </t>
                </div>
                <!-- TITLE -->
                <div class="content-column mt-4">
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content" t-value="page_content['title']" />
                        <t t-set="color" t-value="'core-blue'" />
                        <t t-set="show_underline" t-value="true" />
                        <t t-set="underline_color" t-value="'low-yellow'" />
                        <t t-set="description" t-value="page_content['description']" />
                    </t>
                </div>
                <!-- VIGNETTES AND ACTIONS -->
                <div class="row mb-4 justify-content-center">
                    <t t-foreach="my_compassion_gifts" t-as="my_compassion_gift">
                        <div class="col-sm my-3 flex-grow-0">
                            <t t-call="theme_compassion_2025.VignetteComponent">
                                <t
                                    t-set="image"
                                    t-value="website.image_url(my_compassion_gift, 'my_compassion_image')"
                                />
                                <t t-set="href" t-value="'/my2/gifts/' + str(my_compassion_gift.id)"/>
                                <t t-set="title" t-value="my_compassion_gift.my_compassion_name" />
                                <t t-set="icon" t-value="'pictogram-' + my_compassion_gift.my_compassion_pictogram" />
                                <t t-set="color" t-value="'pure-white'" />
                                <t t-set="bg_color" t-value="my_compassion_gift.my_compassion_color" />
                                <t t-set="learn_more_text" t-value="'Learn more and donate'" />
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
