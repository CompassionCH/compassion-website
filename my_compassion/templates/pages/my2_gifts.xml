    <!-- DASHBOARD -->
    <template id="my2_fund_page" name="My Compassion 2 Fund Page">
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_fund.css" />
        <t t-call="website.layout">
            <div class="container">
                <!-- BANNER -->
                <div class="dashboard-banner d-none d-lg-block mt-4">
                    <div class="position-absolute m-5 pl-5 pt-2">
                        <h1 class="text-pure-white">
                            Welcome to the new
                            <br />
                            <span class="text-low-yellow">my</span>
                            Compassion
                        </h1>
                    </div>
                    <img src="/theme_compassion_2025/static/src/img/snippets/dashboard_banner.png" class="img-fluid" />
                </div>
                <!-- TITLE -->
                <div class="mt-4">
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content" t-value="'Gift of compassion'" />
                        <t t-set="color" t-value="'core-blue'" />
                        <t t-set="show_underline" t-value="true" />
                        <t t-set="underline_color" t-value="'low-yellow'" />
                        <t t-set="description" t-value="'Make a difference and bring hope to children living in extreme poverty.'" />
                    </t>
                </div>
                <!-- VIGNETTES AND ACTIONS -->
                <div class="dashboard-grid row mb-4 justify-content-center">
                    <t t-foreach="my_compassion_gifts" t-as="my_compassion_gift">
                        <div class="col-sm my-3 flex-grow-0">
                            <t t-call="theme_compassion_2025.VignetteComponent">
                                <t t-set="image" t-value="website.image_url(my_compassion_gift, 'my_compassion_image')"/>
                                <t t-set="title" t-value="my_compassion_gift.my_compassion_name" />
                                <!--<t t-set="subtitle" t-value="'Learn more and donate'" />-->
                                <t t-set="icon" t-value="'pictogram-' + my_compassion_gift.my_compassion_pictogram" />
                                <t t-set="color" t-value="'pure-white'" />
                                <t t-set="bg_color" t-value="my_compassion_gift.my_compassion_color" />
                                <t t-set="href" t-value="'https://www.google.com/'" />
                                <t t-set="learn_more_text" t-value="'Learn more and donate'" />
                            </t>
                        </div>
                    </t>
