<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Gifts Page

    Description:
    - This page displays all gifts available for the user, categorized into gifts and funds.
    - It includes a banner, title, and a grid of vignettes representing each gift.
    - Each vignette includes an image, title, and icon, and links to the respective gift or fund page.

    Used in route:
    - /my2/gifts/ (default)
    - /my2/gifts/?type=gift
    - /my2/gifts/?type=fund (same as /my2/gifts/)

    Injected data:
    - my_compassion_gifts (array of 'my_compassion_gift' records): all the gifts of this typ (gift/fund) available.
-->
<odoo>
    <!-- GIFTS DASHBOARD -->
    <template id="my2_gifts_page" name="My Compassion 2 Gifts Page">
        <t t-call="website.layout">
            <div class="container">
                <!-- HELPER FLAGS -->
                <t t-set="is_gift" t-value="type == 'gift'" />
                <t t-set="is_fund" t-value="type == 'fund'" />
                <!-- BANNER -->
                <div class="container-content mt-4">
                    <t t-call="theme_compassion_2025.BannerComponent">
                        <t t-if="is_gift">
                            <t t-set="title" t-value="'Gift of compassion'" />
                            <t
                                t-set="text"
                                t-value="'Every child deserves a secure home, safe water, and medicine to keep them healthy. That\'s why, when poverty places a child in critical need, we take action.'"
                            />
                            <t t-set="btn_link" t-value="'/my2/gifts?type=fund'" />
                            <t t-set="btn_text" t-value="'Send a donation'" />
                        </t>
                        <t t-elif="is_fund">
                            <t t-set="title" t-value="'Give to your sponsored children'" />
                            <t
                                t-set="text"
                                t-value="'Send a gift to your sponsored child. Compassion staff from their local church will support them in purchasing something they really need.'"
                            />
                            <t t-set="btn_link" t-value="'/my2/gifts?type=gift'" />
                            <t t-set="btn_text" t-value="'Send a gift'" />
                        </t>
                        <t t-set="pictogram" t-value="'gift-donation-general'" />
                    </t>
                </div>
                <!-- TITLE -->
                <div class="container-content mt-4">
                    <t t-call="theme_compassion_2025.TitleComponent">
                        <t t-if="is_gift">
                            <t t-set="title_content" t-value="'Gift to your sponsored children'" />
                            <t
                                t-set="description"
                                t-value="'Send a gift to your sponsored child. Compassion staff from their local church will support them in purchasing something they really need.'"
                            />
                        </t>
                        <t t-elif="is_fund">
                            <t t-set="title_content" t-value="'Gift of compassion'" />
                            <t
                                t-set="description"
                                t-value="'Make a difference and bring hope to children living in extreme poverty.'"
                            />
                        </t>
                        <t t-set="color" t-value="'core-blue'" />
                        <t t-set="show_underline" t-value="true" />
                        <t t-set="underline_color" t-value="'low-yellow'" />
                    </t>
                </div>
                <!-- VIGNETTES AND ACTIONS -->
                <div class="row mb-4 justify-content-center">
                    <t t-foreach="my_compassion_gifts" t-as="my_compassion_gift">
                        <div class="col-sm my-3 flex-grow-0">
                            <t t-call="theme_compassion_2025.VignetteComponent">
                                <t
                                    t-set="image"
                                    t-value="website.image_url(my_compassion_gift, 'my_compassion_image')"
                                />
                                <t t-set="href" t-value="'/my2/gifts/' + str(my_compassion_gift.id)" />
                                <t t-set="title" t-value="my_compassion_gift.my_compassion_name" />
                                <t t-set="icon" t-value="my_compassion_gift.my_compassion_pictogram.class_name" />
                                <t t-set="color" t-value="'pure-white'" />
                                <t t-set="bg_color" t-value="my_compassion_gift.my_compassion_color.class_name" />
                                <t t-set="learn_more_text" t-value="'Learn more and donate'" />
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>
