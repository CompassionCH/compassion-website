<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="my2_magic_login_confirm" name="MyCompassion: magic login">
    <t t-call="web.login_layout">
      <form role="form" method="post">
        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
        <div class="h-100 d-flex justify-content-center flex-column">
          <img
            alt=""
            src="/theme_compassion_2025/static/src/img/snippets/login_picture.jpg"
            class="w-75 img-fluid rounded-circle align-self-center"
          />
          <div
            class="mt-4 w-75 text-center text-core-blue body-large bold align-self-center"
          >
            Welcome to MyCompassion
          </div>
          <div class="mt-3 d-flex flex-column align-items-stretch">
            <button type="submit" class="btn btn-primary">Continue</button>
          </div>
        </div>
      </form>
    </t>
  </template>
</odoo>
