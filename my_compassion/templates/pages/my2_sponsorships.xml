<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Sponsorships Page

    Description:
    This page allows users to browse through the profiles of children waiting for a sponsorship and to sponsor a child.

    Used in route:
    - /my2/sponsorships/
    - /my2/sponsorships/fetch

    Injected data:
    - wizard ('new.sponsorship.wizard' record): The associated new sponsorship wizard record.
    - titles (array of 'res.partner.title' records): The available titles to choose from.
    - countries (array of 'res.country' records): The list of countries to choose from.
    - payment_methods (array of 'account.payment.mode' records): The list of payment methods to choose from.
    - spoken_languages (array of 'res.lang.compassion' records): The list of spoken languages to choose from.
    - lead_sources (array of 'recurring.contract.origin' records): The list of lead sources to choose from.
-->
<odoo>
    <!-- FILTER ITEM -->
    <template id="SponsorshipsFilter" name="Sponsorships filter">
        <div class="sponsorship-filter mx-lg-3 flex-shrink-1 d-flex align-items-center flex-column">
            <div class="body-large bold text-dark-blue mx-lg-4 ">
                <t t-raw="title" />
            </div>
            <t t-raw="0" />
        </div>
    </template>
    <!-- RESULTS CONTENT -->
    <template id="my2_sponsorships_results_content" name="Sponsorships Results Dynamic Content">
        <t t-foreach="children" t-as="child">
            <div class="col flex-grow-0">
                <t t-call="my_compassion.my2_children_card_component">
                    <t t-set="child" t-value="child" />
                    <t t-set="show_sponsor_me" t-value="True" />
                    <t t-set="show_status" t-value="False" />
                </t>
            </div>
        </t>
    </template>
    <!-- SPONSORSHIPS PAGE -->
    <template id="my2_sponsorships_page" name="Sponsorships Page">
        <script type="text/javascript" src="/my_compassion/static/src/js/my2_sponsorships.js" />
        <link rel="stylesheet" href="/my_compassion/static/src/css/my2_sponsorships.css" />
        <t t-call="website.layout">
            <!-- HEADER -->
            <div class="sponsorships-header d-flex flex-column align-items-center px-3">
                <i class="pictogram-child-sponsorship text-low-yellow mt-4" />
                <h2 class="text-pure-white">Sponsor a child</h2>
                <div class="body-large bold text-pure-white text-center mt-3 mb-2">
                    Stand alongside the church to see a child released from poverty
                </div>
            </div>
            <!-- BODY -->
            <div class="sponsorships-body-container d-flex flex-column align-items-center mt-4">
                <!-- FILTERS -->
                <div
                    class="p-4 w-100 bg-high-eggshell d-flex flex-column flex-lg-row align-items-center justify-content-center"
                >
                    <t t-call="my_compassion.SponsorshipsFilter">
                        <t t-set="title" t-value="'I\'d like to sponsor a'" />
                        <div class="gender-select-container d-flex my-2">
                            <input id="gender-boy" type="radio" name="gender" value="boy" />
                            <label class="gender-select-button" for="gender-boy">Boy</label>
                            <input id="gender-girl" type="radio" name="gender" value="girl" />
                            <label class="gender-select-button" for="gender-girl">Girl</label>
                            <input id="gender-either" type="radio" name="gender" value="either" checked="" />
                            <label class="gender-select-button" for="gender-either">Either</label>
                        </div>
                    </t>
                    <t t-call="my_compassion.SponsorshipsFilter">
                        <t t-set="title" t-value="'Between the ages of'" />
                        <div class="w-100 mt-2 mb-3">
                            <div class="range-input-component">
                                <t t-call="theme_compassion_2025.RangeInputLoadingComponent" />
                            </div>
                        </div>
                    </t>
                    <t t-call="my_compassion.SponsorshipsFilter">
                        <t t-set="title" t-value="'Who comes from'" />
                        <div class="my-3 mt-lg-2">
                            <t t-call="theme_compassion_2025.SelectComponent">
                                <option value="">Select country</option>
                                <t t-foreach="countries" t-as="country">
                                    <option t-att-value="country.id">
                                        <t t-esc="country.name" />
                                    </option>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>
                <!-- RESULTS -->
                <div class="w-100 d-flex flex-column">
                    <!-- TOTAL RESULTS -->
                    <div class="body-large bold text-mid-grey mt-4 mb-2 align-self-center">
                        <i class="results-icon icon-users03 text-mid-grey mr-2" />
                        <span id="total-results">0</span>
                        children found
                    </div>
                    <!-- CHILDREN PROFILES -->
                    <div class="sponsorships-results-content row justify-content-center" />
                </div>
                <!-- BUTTONS -->
                <div class="d-flex mt-4 mb-5">
                    <div id="btn-choose" class="mr-3">
                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                            <t t-set="variant" t-value="'compact'" />
                            <t t-set="variation" t-value="'hollow'" />
                            <t t-set="label" t-value="'Choose for me'" />
                            <t t-set="color" t-value="'dark-blue'" />
                            <t t-set="text_color" t-value="'dark-blue'" />
                        </t>
                    </div>
                    <div id="btn-more" class="ml-3">
                        <t t-call="theme_compassion_2025.ThemedButtonComponent">
                            <t t-set="variant" t-value="'compact'" />
                            <t t-set="variation" t-value="'hollow'" />
                            <t t-set="label" t-value="'Show more'" />
                            <t t-set="color" t-value="'dark-blue'" />
                            <t t-set="text_color" t-value="'dark-blue'" />
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
