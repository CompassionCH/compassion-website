<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 User Settings Page

    Description:

    Used in route:
    - /my2/user_settings

    Injected data:

-->
<odoo>
    <template id="my2_user_settings_page" name="My Compassion 2 User Settings Page">
        <link rel="stylesheet"
              href="/my_compassion/static/src/css/user_settings.css"/>
        <t t-call="website.layout">
            <div class="container">

                <!-- ### Child related information (family, project and country) ### -->
                <section class="user_settings_tabs tabs-component">
                    <!-- Mobile Dropdown (Visible on small screens) -->
                    <div class="settings_select d-block d-lg-none">
                        <select class="form-control custom-select"
                                id="user-settings-tabs-mobile">
                            <option value="#personal-information" selected="1">Personal
                                informations</option>
                            <option value="#account-settings">Account settings</option>
                            <option value="#privacy-data">Privacy data</option>
                            <option value="#communication-settings">Communication
                                settings</option>
                        </select>
                    </div>

                    <!-- Desktop Tabs (Visible on medium screens and up) -->
                    <ul class="nav nav-tabs d-none d-lg-flex" id="user-settings-tabs"
                        role="tablist">
                        <li class="nav-item" role="presentation">
                            <a class="nav-link active"
                               id="personal-information-tab-link"
                               data-toggle="tab"
                               href="#personal-information"
                               role="tab"
                               aria-controls="personal-information"
                               aria-selected="true">
                                Personal informations
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link"
                               id="account-settings-tab-link"
                               data-toggle="tab"
                               href="#account-settings"
                               role="tab"
                               aria-controls="account-settings"
                               aria-selected="false">
                                Account settings
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link"
                               id="privacy-data-tab-link"
                               data-toggle="tab"
                               href="#privacy-data"
                               role="tab"
                               aria-controls="privacy-data"
                               aria-selected="false">
                                Privacy data
                            </a>
                        </li>
                        <li class="nav-item" role="presentation">
                            <a class="nav-link"
                               id="communication-settings-tab-link"
                               data-toggle="tab"
                               href="#communication-settings"
                               role="tab"
                               aria-controls="communication-settings"
                               aria-selected="false">
                                Communication settings
                            </a>
                        </li>
                    </ul>
                </section>


                <!-- Tab content -->
                <div class="tab-content d-block col-12"
                     id="UserSettingsTabContent">
                    <!-- Personal information panel -->
                    <div class="tab-pane fade show active" id="personal-information"
                         role="tabpanel"
                         aria-labelledby="personal-information">
                        <div class="p-3 bg-pure-white">
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'title'"/>
                                <t t-set="input_id" t-value="'title'"/>
                                <t t-if="currently_editing_info">
                                    <input id="title" type="text" name="title" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('title') and submitted_info_edited else ''"
                                           t-att-value="partner.title.name if partner.title else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.title.name if partner.title else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'surname'"/>
                                <t t-set="input_id" t-value="'surname'"/>
                                <t t-if="currently_editing_info">
                                    <input id="surname" type="text" name="surname" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('surname') and submitted_info_edited else ''"
                                           t-att-value="partner.lastname if partner.lastname else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.lastname if partner.lastname else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'name'"/>
                                <t t-set="input_id" t-value="'name'"/>
                                <t t-if="currently_editing_info">
                                    <input id="name" type="text" name="name" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('name') and submitted_info_edited else ''"
                                           t-att-value="partner.firstname if partner.firstname else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.firstname if partner.firstname else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'address'"/>
                                <t t-set="input_id" t-value="'address'"/>
                                <t t-if="currently_editing_info">
                                    <input id="address" type="text" name="address" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('address') and submitted_info_edited else ''"
                                           t-att-value="partner.street if partner.street else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.street if partner.street else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'city'"/>
                                <t t-set="input_id" t-value="'city'"/>
                                <t t-if="currently_editing_info">
                                    <input id="city" type="text" name="city" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('city') and submitted_info_edited else ''"
                                           t-att-value="partner.city if partner.city else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.city if partner.city else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'zip'"/>
                                <t t-set="input_id" t-value="'zip'"/>
                                <t t-if="currently_editing_info">
                                    <input id="zip" type="text" name="zip" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('zip') and submitted_info_edited else ''"
                                           t-att-value="partner.zip if partner.zip else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.zip if partner.zip else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'phone'"/>
                                <t t-set="input_id" t-value="'phone'"/>
                                <t t-if="currently_editing_info">
                                    <input id="phone" type="text" name="phone" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('phone') and submitted_info_edited else ''"
                                           t-att-value="partner.phone if partner.phone else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.phone if partner.phone else ''"/>
                                </t>
                            </t>
                            <t t-call="theme_compassion_2025.FormFieldComponent">
                                <t t-set="label" t-value="'email'"/>
                                <t t-set="input_id" t-value="'email'"/>
                                <t t-if="currently_editing_info">
                                    <input id="email" type="text" name="email" t-att-class="'bg-high-orange' if not profile_edits_accepted_fields.get('email') and submitted_info_edited else ''"
                                           t-att-value="partner.email if partner.email else ''" required=""/>
                                </t>
                                <t t-else="">
                                    <t t-esc="partner.email if partner.email else ''"/>
                                </t>
                            </t>
                            <!-- Buttons to edit profile or save/cancel the modifications -->
                            <t t-if="currently_editing_info">
                                <!-- Apply modifications button -->
                                <a id="ApplyModificationsInfoButton">
                                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                        <t t-set="variant" t-value="'default'"/>
                                        <t t-set="variation" t-value="'filled'"/>
                                        <t t-set="label" t-value="'Save settings'"/>
                                        <t t-set="color" t-value="'mid-green'"/>
                                        <t t-set="text_color" t-value="'pure-white'"/>
                                    </t>
                                </a>
                                <!-- Cancel modifications button -->
                                <a t-att-href="'/my2/user_settings'">
                                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                        <t t-set="variant" t-value="'default'"/>
                                        <t t-set="variation" t-value="'filled'"/>
                                        <t t-set="label" t-value="'Cancel'"/>
                                        <t t-set="color" t-value="'low-orange'"/>
                                        <t t-set="text_color" t-value="'pure-white'"/>
                                    </t>
                                </a>

                            </t>
                            <t t-else="">
                                <!-- Edit profile button -->
                                <a t-att-href="'/my2/user_settings?currently_editing_info=true'">
                                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                                        <t t-set="variant" t-value="'default'"/>
                                        <t t-set="variation" t-value="'filled'"/>
                                        <t t-set="label" t-value="'Edit my profile'"/>
                                        <t t-set="color" t-value="'core-blue'"/>
                                        <t t-set="text_color" t-value="'pure-white'"/>
                                    </t>
                                </a>
                            </t>
                        </div>
                    </div>
                    <!-- Account settings panel -->
                    <div class="tab-pane fade" id="account-settings" role="tabpanel"
                         aria-labelledby="account-settings">
                        <div class="p-3 bg-pure-white">
                            Contenuto del Tab 2
                        </div>
                    </div>
                    <!-- Privacy data panel -->
                    <div class="tab-pane fade" id="privacy-data" role="tabpanel"
                         aria-labelledby="privacy-data">
                        <div class="p-3 bg-pure-white">
                            Contenuto del Tab 3
                        </div>
                    </div>
                    <!-- Communication settings panel -->
                    <div class="tab-pane fade" id="communication-settings"
                         role="tabpanel"
                         aria-labelledby="communication-settings">
                        <div class="p-3 bg-pure-white">
                            Contenuto del Tab 4
                        </div>
                    </div>
                </div>

            </div>
        </t>

        <script
                type="text/javascript"
                src="/my_compassion/static/src/js/my2_user_settings.js"
        />
    </template>
</odoo>