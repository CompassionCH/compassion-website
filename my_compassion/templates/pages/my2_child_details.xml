<?xml version="1.0" encoding="utf-8" ?>
<!--
    Page: My Compassion 2 Child Details Page

    Description:
    This page displays detailed information about a sponsored child.

    Used in route:
    - /my2/children/<model("compassion.child"):child>/details

    Injected Data:
    - compassion_child (record): The related child object.
-->
<odoo>
    <template id="my2_child_details_page" name="My Compassion 2 Child Details Page">
        <t t-call="website.layout">
            <div class="container">
                <!-- Calling breadcrumb component -->
                <t t-call="my_compassion.my2_breadcrumbs"/>
                <!-- Child summarized profile -->
                <div class="row mb-2">
                    <div class="col-12">
                        <!-- Using children_profile component -->
                        <t t-call="my_compassion.my2_children_profile_component">
                            <!-- The data we are passing to the children_profile_component -->
                            <t t-set="compassion_child" t-value="compassion_child"/>
                        </t>
                    </div>
                </div>

                <!-- Buttons New Letter and New Gift -->
                <div class="row mb-3">
                    <div class="col-6 text-center">
                        <a t-att-href="'/my2/children/' + str(compassion_child.id) + '/letters'">
                            <button type="button"
                                    class="btn-compassion btn-compassion-white">
                                <span>
                                    Letters
                                </span>
                            </button>
                        </a>
                    </div>
                    <div class="col-6 text-center">
                        <button type="button"
                                class="btn-compassion btn-compassion-white">
                            <span>
                                Gifts
                            </span>
                        </button>
                    </div>
                </div>
                <!-- Child Details Information -->
                <div class="row mb-3">
                    <div class="col-12">
                        <!-- Using details_card component -->
                        <t t-call="my_compassion.my2_details_card_component">
                            <!-- The data we are passing to the card_details component -->
                            <t t-set="card_title" t-value="'General'" />
                            <t t-set="content">
                                <p>
                                    <strong>Birthdate:</strong>
                                    <t t-esc="compassion_child.birthdate" />
                                </p>
                                <p>
                                    <strong>Hobby:</strong>
                                    <t t-esc="compassion_child.hobby_ids[0].name" />
                                </p>
                                <p>
                                    <strong>Education Level:</strong>
                                    <t t-esc="compassion_child.education_level" />
                                </p>
                            </t>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>