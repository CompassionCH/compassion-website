<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="my2_child_timeline_page_terminated" name="My Compassion 2 Child Timeline Page For Terminated Sponsorships">
        <link rel="stylesheet" href="/my_compassion/static/src/css/child_profile.css" />
        <link rel="stylesheet" href="/my_compassion/static/src/css/child_profile_timeline.css" />
        <t t-call="website.layout">
            <div class="container">
                <div class="single-column">
                    <section class="d-flex flex-column flex-md-row pt-4">
                        <div class="child-details-container">
                            <t t-call="theme_compassion_2025.PortraitComponent">
                                <t t-set="title" t-value="compassion_child.preferred_name" />
                                <t
                                    t-set="src"
                                    t-value="'/web/image/compassion.child/' + str(compassion_child.id) + '/portrait'"
                                />
                                <t t-set="alt">
                                    Portrait of
                                    <t t-esc="compassion_child.preferred_name" />
                                </t>
                                <t t-set="size" t-value="'large'" />
                            </t>
                            <div
                                t-if="access_scope == 'sponsor' and compassion_child.my_sponsorship_id.state == 'terminated' and compassion_child.my_sponsorship_id.sds_state != 'sub_waiting'"
                            >
                                <span
                                    class="badge bg-low-yellow"
                                    title="Your sponsorship has ended"
                                    aria-label="Sponsorship ended"
                                >
                                    Sponsorship ended
                                </span>
                            </div>
                            <div
                                t-if="access_scope == 'sponsor' and compassion_child.my_sponsorship_id.state in ('draft', 'waiting', 'mandate')"
                            >
                                <span
                                    class="badge bg-low-yellow"
                                    title="Your sponsorship is being confirmed and will become active soon"
                                    aria-label="Sponsorship pending confirmation"
                                >
                                    Pending activation
                                </span>
                            </div>
                        </div>
                    </section>

                    <t t-if="access_scope == 'sponsor'" t-call="theme_compassion_2025.TitleComponent">
                        <t t-set="title_content">Timeline</t>
                        <t t-set="title_size" t-value="'md'" />
                        <t t-set="color" t-value="'core-blue'" />
                        <t t-set="show_underline" t-value="True" />
                        <t t-set="underline_color" t-value="'low-yellow'" />
                        <t
                            t-set="description"
                            t-value="'Follow the thread of hope and encouragement you’ve woven together.'"
                        />
                    </t>
                </div>
            </div>

            <section
                t-if="access_scope == 'sponsor'"
                class="cd-timeline js-cd-timeline"
                t-att-data-child-id="compassion_child.id"
            >
                <div class="cd-timeline__container">
                    <div class="single-column">
                        <t t-call="my_compassion.SponsorChildTimelineBatchComponent">
                            <t t-set="records" t-value="records" />
                        </t>
                    </div>
                </div>
                <div id="timeline-loader" class="text-center py-5" style="display:none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="sr-only">Loading...</span>
                    </div>
                </div>
            </section>
            </t>

        <script
            t-if="access_scope == 'sponsor'"
            type="text/javascript"
            src="/my_compassion/static/src/js/child_profile_timeline.js"
        />
    </template>
</odoo>