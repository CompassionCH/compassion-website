<?xml version="1.0" encoding="utf-8" ?>
<!--
Page: My Compassion 2 Thank you Page

    Description:
    This page display a thank you message after a user has completed a donation process

    Used in route:
    - /my2/gifts/thankyou

    Injected data:
    - sale_order: The sale order object containing the details of the donation
    - donor_details_needed (bool): a visitor's donation whose payment did not
      tell the donor's name: the name form is shown
    - donor_details_prefill (dict): firstname/lastname to start the form with
    - donor_details_error (bool): the last submission missed a field
-->
<odoo>
  <template id="my2_gifts_thank_you_page" name="My Compassion 2 Thank you Page">
    <t t-set="additional_title">Thank you</t>
    <t t-call="website.layout">
      <div class="container">
        <div class="single-column">
          <div class="mt-3 d-flex justify-content-center align-items-center">
            <h1 class="mb-0">
              <i class="pictogram pictogram-love bg-low-yellow text-center" />
            </h1>
          </div>
          <div class="px-3 d-flex flex-column align-items-center">
            <!-- TITLE -->
            <t t-call="theme_compassion_2025.TitleComponent">
              <t t-set="title_content">Thank you</t>
              <t t-set="color" t-value="'core-blue'" />
              <t t-set="show_underline" t-value="True" />
              <t t-set="underline_color" t-value="'low-yellow'" />
              <t t-set="description">Your generosity changes lives.</t>
            </t>
            <!-- GIFT PACKAGE CONTENT -->
            <div
              id="gift-package-content-wrapper"
              class="mb-4 w-100 d-flex flex-column align-items-stretch"
            >
              <!-- ONE-TIME GIFTS -->
              <t
                t-set="one_time_order_lines"
                t-value="sale_order.order_line.filtered(lambda line: line.frequency == 'one_time')"
              />
              <t t-foreach="one_time_order_lines" t-as="line">
                <t t-call="my_compassion.DonationItemComponent">
                  <t
                    t-set="top_class"
                    t-valuef="mt-3 donation-item donation-item-#{line.id}"
                  />
                  <t
                    t-set="name"
                    t-value="line.product_template_id.my_compassion_name"
                  />
                  <t
                    t-if="line.is_gift"
                    t-set="recipient"
                    t-value="line.gift_recipient_id.preferred_name"
                  />
                  <t t-set="title_color" t-value="'low-black'" />
                  <t t-set="accent_color" t-value="'mid-green'" />
                  <t t-set="price_color" t-value="'low-green'" />
                  <t t-set="recipient_color" t-value="'low-green'" />
                  <t t-set="bg_color" t-value="'mid-eggshell'" />
                  <t t-set="price" t-value="line.price_total" />
                  <t t-set="currency_name" t-value="line.currency_id.name" />
                  <t
                    t-set="image"
                    t-valuef="/web/image/#{line.product_template_id._name}/#{line.product_template_id.id}/my_compassion_image"
                  />
                </t>
              </t>
              <!-- MONTHLY GIFTS -->
              <t
                t-set="monthly_order_lines"
                t-value="sale_order.order_line.filtered(lambda line: line.frequency == 'monthly')"
              />
              <t t-foreach="monthly_order_lines" t-as="line">
                <t t-call="my_compassion.DonationItemComponent">
                  <t
                    t-set="top_class"
                    t-valuef="mt-3 donation-item donation-item-#{line.id}"
                  />
                  <t
                    t-set="name"
                    t-value="line.product_template_id.my_compassion_name"
                  />
                  <t
                    t-if="line.is_gift"
                    t-set="recipient"
                    t-value="line.gift_recipient_id.preferred_name"
                  />
                  <t t-set="title_color" t-value="'dark-blue'" />
                  <t t-set="accent_color" t-value="'dark-blue'" />
                  <t t-set="price_color" t-value="'dark-blue'" />
                  <t t-set="recipient_color" t-value="'dark-blue'" />
                  <t t-set="bg_color" t-value="'light-blue'" />
                  <t t-set="price" t-value="line.price_total" />
                  <t t-set="currency_name" t-value="line.currency_id.name" />
                  <t t-set="monthly" t-value="True" />
                  <t
                    t-set="image"
                    t-valuef="/web/image/#{line.product_template_id._name}/#{line.product_template_id.id}/my_compassion_image"
                  />
                </t>
              </t>
            </div>
            <!-- DONOR NAME (visitor whose payment did not tell it) -->
            <form
              t-if="donor_details_needed"
              class="my2-gifts-donor-details-form w-100 px-4 mb-4"
              action="/my2/gifts/thankyou/details"
              method="POST"
            >
              <input
                type="hidden"
                name="csrf_token"
                t-att-value="request.csrf_token()"
              />
              <div class="h4 mb-1 text-low-black text-center">Who shall we thank?</div>
              <div
                class="mb-3 text-center body-small text-low-black"
              >Your name goes on your donation receipt.</div>
              <div
                t-if="donor_details_error"
                class="mb-3 p-3 rounded-lg bg-low-eggshell text-mid-orange body-small"
                role="alert"
              >Please fill in your first name and surname.</div>
              <t t-call="theme_compassion_2025.FormFieldComponent">
                <t t-set="top_class" t-value="'my-3'" />
                <t t-set="label">Firstname</t>
                <t t-set="input_id" t-value="'donor_firstname'" />
                <input
                  id="donor_firstname"
                  type="text"
                  name="firstname"
                  class="form-control"
                  t-att-value="donor_details_prefill.get('firstname')"
                  data-validate-type="name"
                  required=""
                />
              </t>
              <t t-call="theme_compassion_2025.FormFieldComponent">
                <t t-set="top_class" t-value="'my-3'" />
                <t t-set="label">Surname</t>
                <t t-set="input_id" t-value="'donor_lastname'" />
                <input
                  id="donor_lastname"
                  type="text"
                  name="lastname"
                  class="form-control"
                  t-att-value="donor_details_prefill.get('lastname')"
                  data-validate-type="name"
                  required=""
                />
              </t>
              <div class="d-flex flex-column align-items-stretch">
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                  <t t-set="variant" t-value="'compact'" />
                  <t t-set="variation" t-value="'filled'" />
                  <t t-set="label">Save</t>
                  <t t-set="color" t-value="'mid-green'" />
                  <t t-set="text_color" t-value="'pure-white'" />
                </t>
              </div>
            </form>
            <!-- BACK TO HOME PAGE  -->
            <div
              class="gifts-thank-you-buttons-container w-100 mt-3 mb-5
                                    d-flex flex-column align-items-stretch"
            >
              <t
                t-if="not request.env.user._is_public()"
                t-call="theme_compassion_2025.ThemedButtonComponent"
              >
                <t t-set="variant" t-value="'compact'" />
                <t t-set="variation" t-value="'filled'" />
                <t t-set="label">Back to dashboard</t>
                <t t-set="color" t-value="'dark-blue'" />
                <t t-set="text_color" t-value="'pure-white'" />
                <t t-set="href" t-value="'/my2/dashboard'" />
              </t>
              <t t-else="" t-call="theme_compassion_2025.ThemedButtonComponent">
                <t t-set="variant" t-value="'compact'" />
                <t t-set="variation" t-value="'filled'" />
                <t t-set="label">Make another donation</t>
                <t t-set="color" t-value="'dark-blue'" />
                <t t-set="text_color" t-value="'pure-white'" />
                <t t-set="href" t-value="'/my2/gifts'" />
              </t>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>
</odoo>
