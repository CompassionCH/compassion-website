<?xml version="1.0" encoding="utf-8" ?>
<!--
    These templates inherit from Odoo's "website" templates and adds custom behaviour to it.
-->
<odoo>
    <!-- Make all pages load global.css file -->
     <!-- Define custom asset bundle -->
      <template id="my_compassion_assets" inherit_id="web.assets_frontend" name="My Compassion Assets">
        <xpath expr="." position="inside">
            <!-- JS Dependencies -->
            <script type="text/javascript" src="/web/static/src/js/boot.js"/>
            <script type="text/javascript" src="/web/static/src/js/services/core.js"/>
            <script type="text/javascript" src="/web/static/src/js/core/ajax.js"/>
            <!-- CSS -->
            <link rel="stylesheet" href="/my_compassion/static/src/css/global.css"/>
            <!-- Custom JS -->
            <script type="text/javascript" src="/my_compassion/static/src/js/my2_letters_filter.js"/>
        </xpath>
    </template>


    <!-- Add a meta instruction in all page's header -->
    <template
    id="my_compassion_meta"
    name="Add custom meta"
    inherit_id="website.layout"
  >
        <!-- Adds the mobile first optimization in the head of every page -->
        <xpath expr="//head/meta[last()]" position="after">
            <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
      />
        </xpath>
    </template>
</odoo>
