<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="my_account_menu" name="MyCompassion - hide portal My Account link" inherit_id="portal.my_account_link">
            <xpath expr="//a[@href='/my/home']" position="replace"/>
        </template>
        <!-- Displayed when user sponsors no child on children related views  -->
        <template id="sponsor_a_child" name="My Children">
            <t t-call="portal.frontend_layout">
                <div class="container text-center">
                    <br />
                    <br />
                    <br />
                    You do not support any child yet. You can start a sponsorship by following
                    <a href="https://compassion.ch/parrainer-un-enfant" target="_blank">this link</a>
                    .
                    <br />
                    <br />
                    <br />
                </div>
            </t>
        </template>
        <!-- Utility to create a row, given the key and its corresponding value. Gets the following arguments: -->
        <!--     1. key, the key to fill in on the right, should be passed inside the template call -->
        <!--     2. value, the value to fill in on the left, nothing is displayed if empty -->
        <template id="fill_key_value">
            <div class="row" t-if="value">
                <div class="col-6 border-end">
                    <label>
                        <t t-out="0" />
                    </label>
                </div>
                <div class="col-6">
                    <label>
                        <t t-out="value" />
                    </label>
                </div>
            </div>
        </template>
        <!-- Legal-terms acceptance label, shared by the signup, login,
             personal-info and user-settings privacy-policy checkboxes -->
        <template id="acceptance_full">
            <span class="acceptance_full">
                <a
                    href="/legal"
                >I accept the legal terms, the privacy policy &amp; conditions of this website.</a>
            </span>
        </template>
    </data>
</odoo>
