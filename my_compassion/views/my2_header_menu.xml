<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hide default cart -->
    <template id="remove_native_cart" inherit_id="website_sale.template_header_default" name="Remove Native Cart">
        <xpath expr="//t[@t-call='website_sale.header_cart_link']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
    <template id="my_compassion_dynamic_menu" inherit_id="website.template_header_default">
        <xpath expr="//div[@id='top_menu_collapse']/*[1]" position="before">
            <t t-if="request.session.uid">
                <ul class="navbar-nav">
                    <t t-set="partner" t-value="request.env.user.partner_id" />
                    <li class="nav-item">
                        <a class="nav-link" href="/my2/dashboard">Home</a>
                    </li>
                    <t t-if="partner.is_sponsor">
                        <li class="nav-item">
                            <a class="nav-link" href="/my2/children">My sponsorships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/my2/children/letters">Letters</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/my2/children/letters/new">Write a letter</a>
                        </li>
                    </t>
                    <li class="nav-item">
                        <a class="nav-link" href="/my2/gifts">Give</a>
                    </li>
                    <t t-if="partner.is_donor">
                        <li class="nav-item">
                            <a class="nav-link" href="/my2/donations">My donations</a>
                        </li>
                    </t>
                    <!-- Add cart and language selector to mobile menu -->
                    <li
                        class="nav-item d-flex d-lg-none align-items-center justify-content-between w-100 mt-3 pt-3 border-top"
                    >
                        <ul class="navbar-nav flex-row mb-0">
                            <t t-call="website_sale.header_cart_link">
                                <t t-set="_icon" t-value="True" />
                                <t t-set="_item_class" t-value="'nav-item'" />
                                <t t-set="_link_class" t-value="'nav-link'" />
                            </t>
                        </ul>
                        <div class="d-block d-md-none">
                            <t t-call="portal.language_selector" />
                        </div>
                    </li>
                    <!-- Add cart to desktop menu -->
                    <t t-call="website_sale.header_cart_link">
                        <t t-set="_icon" t-value="True" />
                        <t t-set="_item_class" t-value="'nav-item d-none d-lg-block'" />
                        <t t-set="_link_class" t-value="'nav-link'" />
                    </t>
                </ul>
            </t>
            <t t-else="">
                <ul class="navbar-nav w-100 d-flex d-md-none mt-5">
                    <li class="nav-item d-flex justify-content-end w-100 pt-3 pr-2">
                        <t t-call="portal.language_selector" />
                    </li>
                </ul>
            </t>
        </xpath>
    </template>
    <template
        id="custom_header_cart_link_redirect"
        inherit_id="website_sale.header_cart_link"
        name="Custom Header Cart Link Redirect"
    >
        <!-- Hide the cart when user is not logged in -->
        <xpath expr="//t[@t-set='show_cart']" position="attributes">
            <attribute name="t-value">request.session.uid</attribute>
        </xpath>
        <!-- Modify the behavior of the base Odoo cart for custom redirection and design -->
        <xpath expr="//a[@href='/shop/cart']" position="attributes">
            <attribute name="href">/my2/gift-package</attribute>
        </xpath>
        <xpath expr="//i[hasclass('fa-shopping-cart')]" position="attributes">
            <attribute name="class">icon-gift02 text-low-yellow</attribute>
        </xpath>
        <xpath expr="//sup[hasclass('badge-primary')]" position="attributes">
            <attribute name="class">my_cart_quantity badge bg-core-blue text-white</attribute>
        </xpath>
    </template>
</odoo>
