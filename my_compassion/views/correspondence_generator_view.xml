<odoo>
    <record id="view_correspondence_s2b_generator_form_inherited" model="ir.ui.view">
        <field name="name">correspondence.s2b.generator.form.inherited</field>
        <field name="model">correspondence.s2b.generator</field>
        <field name="inherit_id" ref="sbc_compassion.s2b_generator_form" />
        <field name="arch" type="xml">
            <field name="selection_domain" position="after">
                <field name="user_id" domain="[('partner_id.has_sponsorships', '=', True)]" />
                <field name="partner_id" invisible="1" />
                <field name="child_id" domain="[('sponsor_id', '=', partner_id)]" />
            </field>
            <xpath expr="//field[@name='selection_domain']" position="attributes">
                <attribute name="attrs">{'invisible': [('user_id', '!=', False), ('child_id', '!=', False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
