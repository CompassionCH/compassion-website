<?xml version="1.0" encoding="utf-8"?>
<!-- views/my2_route_selector_form.xml -->
<odoo>
  <record id="view_my2_route_selector_form" model="ir.ui.view">
    <field name="name">my2.route.selector.form</field>
    <field name="model">my2.route.selector</field>
    <field name="arch" type="xml">
      <form string="Select routes">
        <group>
          <field name="route_filter" placeholder="Search routes..."/>
          <field name="option_ids"
                 widget="many2many_checkboxes"
                 domain="[('selector_id','=', id), ('name','ilike', route_filter)]"
                 options="{'no_create': True, 'no_open': True}"/>
        </group>
        <footer>
          <!--<button name="action_select_all_filtered" type="object" string="Select all (filtered)"/>-->
          <button name="action_select_none" type="object" string="Select none" class="btn-secondary"/>
          <separator/>
          <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
