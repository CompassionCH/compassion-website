<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id='my_compassion_correspondence_action' model='ir.actions.act_window'>
        <field name="name">My Compassion prewritten texts</field>
        <field name="res_model">correspondence.prewritten.letter</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem name="My Compassion" id="my_compassion_sponsorship_menu" parent="sbc_compassion.menu_correspondence" />
    <menuitem
        name="Prewritten Texts"
        id="letter_template_menu"
        parent="my_compassion_sponsorship_menu"
        action="my_compassion_correspondence_action"
    />
    <record id="my_compassion_letter_template_tree" model="ir.ui.view">
        <field name="name">Prewritten text tree</field>
        <field name="model">correspondence.prewritten.letter</field>
        <field name="arch" type="xml">
            <tree delete="true" decoration-info="status == 'active'">
                <field name="name" />
                <field name="is_active" widget="boolean_toggle" />
                <field name="status" />
                <field name="start_date" />
                <field name="end_date" />
            </tree>
        </field>
    </record>
    <record id="my_compassion_letter_template_form" model="ir.ui.view">
        <field name="name">Prewritten text form</field>
        <field name="model">correspondence.prewritten.letter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Validity Period">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="is_active" widget="boolean_toggle" />
                        </group>
                    </group>
                    <div t-translation="off">
                        <p>Available keywords:</p>
                        <ul>
                            <li>
                                <b>%child%</b>
                                : Child firstname
                            </li>
                            <li>
                                <b>%firstname%</b>
                                : Sponsor firstname
                            </li>
                            <li>
                                <b>%lastname%</b>
                                : Sponsor lastname
                            </li>
                        </ul>
                    </div>
                    <notebook>
                        <page string="Template Body" name="template_body">
                            <field name="text" placeholder="Start writing your letter template here..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="my_compassion_letter_template_view_search" model="ir.ui.view">
        <field name="name">Prewritten text search</field>
        <field name="model">correspondence.prewritten.letter</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="text" />
                <filter string="Expired" name="Expired templates" domain="[('status','=','expired')]" />
                <filter string="Scheduled" name="scheduled templates" domain="[('is_active','=',True)]" />
                <filter string="Active" name="Active templates" domain="[('status','=','active')]" />
            </search>
        </field>
    </record>
</odoo>
