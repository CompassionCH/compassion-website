<odoo>
  <record id="view_correspondence_s2b_generator_form_inherited" model="ir.ui.view">
    <field name="name">correspondence.s2b.generator.form.inherited</field>
    <field name="model">correspondence.s2b.generator</field>
    <field name="inherit_id" ref="sbc_compassion.s2b_generator_form" />
    <field name="arch" type="xml">
      <xpath expr="//div[@class='oe_title']" position="after">
        <group>
          <field
            name="generation_mode"
            widget="radio"
            options="{'horizontal': true}"
            readonly="state != 'draft'"
          />
        </group>
        <div class="text-muted mb-3" invisible="state != 'draft'">
          <span invisible="generation_mode != 'mass'">
            One letter is generated for every sponsorship matching the
            selection below.
          </span>
          <span invisible="generation_mode != 'single'">
            One single letter is generated, for the chosen user and child.
          </span>
        </div>
      </xpath>
      <field name="selection_domain" position="after">
        <field
          name="partner_id"
          domain="[('sponsored_child_ids', '!=', False)]"
          invisible="generation_mode != 'single'"
          required="generation_mode == 'single'"
          readonly="state != 'draft'"
        />
        <field
          name="child_id"
          domain="partner_id and [('sponsor_id', '=', partner_id)] or [('sponsor_id', '!=', False)]"
          invisible="generation_mode != 'single'"
          required="generation_mode == 'single'"
          readonly="state != 'draft'"
        />
      </field>
      <xpath expr="//field[@name='selection_domain']" position="attributes">
        <attribute name="invisible">generation_mode != 'mass'</attribute>
      </xpath>
      <xpath expr="//field[@name='month']" position="attributes">
        <attribute
          name="invisible"
        >generation_mode != 'mass' or state == 'preview'</attribute>
      </xpath>
    </field>
  </record>
  <record id="correspondence_published_view" model="ir.ui.view">
    <field name="name">correspondence.published.form</field>
    <field name="model">correspondence</field>
    <field name="inherit_id" ref="sbc_compassion.view_correspondence_form" />
    <field name="arch" type="xml">
      <xpath expr="//sheet/h1" position="before">
        <field name="website_published" invisible="1" />
        <div class="oe_button_box" name="button_box">
          <button
            name="website_publish_button"
            type="object"
            class="oe_stat_button"
            icon="fa-globe"
          >
            <field name="is_published" widget="website_publish_button" />
          </button>
        </div>
        <widget
          name="web_ribbon"
          title="Published"
          bg_color="bg-success"
          invisible="not website_published"
        />
        <widget
          name="web_ribbon"
          title="Unpublished"
          bg_color="bg-danger"
          invisible="website_published"
        />
      </xpath>
    </field>
  </record>
</odoo>
