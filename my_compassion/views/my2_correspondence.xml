<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id='my_compassion_correspondence_action' model='ir.actions.act_window'>
        <field name="name">My Compassion correspondence</field>
        <field name="res_model">my2.correspondence.letter.template</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem name="My Compassion" id="my_compassion_sponsorship_menu" parent="sbc_compassion.menu_correspondence" />
    <menuitem
        name="Letters template"
        id="letter_template_menu"
        parent="my_compassion_sponsorship_menu"
        action="my_compassion_correspondence_action"
    />
    <record id="my_compassion_letter_template_tree" model="ir.ui.view">
        <field name="name">Sponsorship letter template tree</field>
        <field name="model">my2.correspondence.letter.template</field>
        <field name="arch" type="xml">
            <tree delete="true">
                <field name="title" />
                <field name="template_description" />
                <field name="scheduled" widget="boolean_toggle" />
                <field name="status" />
                <field name="start_date" />
                <field name="end_date" />
            </tree>
        </field>
    </record>
    <record id="my_compassion_letter_template_form" model="ir.ui.view">
        <field name="name">Sponsorship Letter Template</field>
        <field name="model">my2.correspondence.letter.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="title" />
                        <h1>
                            <field name="title" placeholder="Title" />
                        </h1>
                    </div>
                    <div class="oe_title">
                        <label for="template_description" />
                        <h2>
                            <field name="template_description" placeholder="Description" />
                        </h2>
                    </div>
                    <group>
                        <group string="Validity Period">
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="scheduled" widget="boolean_toggle" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Template Body" name="template_body">
                            <field name="text" placeholder="Start writing your letter template here..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
