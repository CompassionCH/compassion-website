<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_move_form_digital_charge" model="ir.ui.view">
    <field name="name">account.move.form.digital.charge</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="my2_can_charge_digital" invisible="1" />
        <button
          name="action_charge_digital_invoice"
          string="Charge Saved Card"
          type="object"
          class="btn-secondary"
          invisible="not my2_can_charge_digital"
          groups="account.group_account_invoice"
        />
      </xpath>
    </field>
  </record>
</odoo>
