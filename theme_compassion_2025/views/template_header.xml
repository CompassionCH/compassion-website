<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
    <template id="template_header_default" inherit_id="website.template_header_default">
        <!-- Move the hamburger menu to the left -->
        <xpath expr="//t[@t-call='website.navbar_toggler']" position="replace" />
        <xpath expr="//t[@t-call='website.placeholder_header_brand']" position="before">
            <t t-call="website.navbar_toggler">
                <t t-set="_toggler_class" t-value="'mr-4 text-primary'" />
            </t>
        </xpath>
        <!-- Improve the layout of the navbar and add the svg -->
        <xpath expr="//t[@t-set='_nav_class']" position="attributes">
            <attribute name="t-value">
                'flex-grow-1 align-items-left align-items-lg-center border-thread-right'
            </attribute>
        </xpath>
        <!-- Add a linebreak with colors after the navbar -->
        <xpath expr="//nav[@data-name='Navbar']" position="after">
            <div class="d-flex compassion-thread">
                <div class="h-100 w-25 bg-core-blue" />
                <div class="h-100 w-25 bg-high-pink" />
                <div class="h-100 w-25 bg-mid-orange" />
                <div class="h-100 w-25 bg-low-green" />
            </div>
        </xpath>
        <!-- Make the main menu in the center -->
        <xpath expr="//div[@id='top_menu_collapse']" position="after">
            <div class="flex-grow-1" />
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse']" position="before">
            <div class="flex-grow-1" />
        </xpath>
        <!-- Move the login button out of the main menu and adapt its style -->
        <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']" position="replace" />
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="replace" />
        <xpath expr="//t[@t-call='website.placeholder_header_language_selector']" position="before">
            <t t-call="portal.user_dropdown">
                <t t-set="_avatar" t-value="true" />
                <t t-set="_avatar_class" t-value="'border border-secondary'" />
                <t t-set="_item_class" t-value="'nav-item dropdown ml-lg-4'" />
                <t t-set="_link_class" t-value="'nav-link font-weight-bold'" />
            </t>
            <a
                href="/web/login?redirect=/my2/dashboard"
                class="btn btn-sm btn-outline-primary dropdown-toggle"
                role="button"
                groups="base.group_public"
            >
                <i class="fa fa-user align-middle mr-2" />
                <span class="align-middle d-none d-sm-inline">Sign in</span>
            </a>
        </xpath>
    </template>
    <!-- Remove the contact us button from the header -->
    <template id="header_contactus" inherit_id="website.template_header_default_oe_structure_header_default_1">
        <xpath expr="//div[@id='oe_structure_header_default_1']" position="replace" />
    </template>
    <!-- Improve the language selector in the header by applying the Compassion theme-->
    <template id="remove_flags_from_selector" inherit_id="portal.language_selector">
        <!--    <xpath expr="//img[hasclass('o_lang_flag')]" position="replace">-->
        <!--        </xpath>-->
    </template>
    <template id="language_selector_pill_style" inherit_id="portal.language_selector">
        <xpath expr="//div[hasclass('dropdown-menu')]" position="attributes">
            <attribute name="class" add="shadow-sm animation-drop language-selector__dropdown-menu" separator=" " />
        </xpath>
        <!--    Modify the dropdown button to use a custom pill style button-->
        <xpath expr="//button[hasclass('dropdown-toggle')]" position="replace">
            <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent">
                <t t-set="variant" t-value="'compact'" />
                <t t-set="variation" t-value="'p-1 hollow'" />
                <t t-set="label" t-value="active_lang[0].split('_')[0].upper()" />
                <t t-set="icon_left" t-value="'icon-globe01'" />
                <t t-set="icon_left_color" t-value="'core-blue'" />
                <t t-set="icon_right" t-value="'icon-chevron-down'" />
                <t t-set="icon_right_color" t-value="'black'" />
                <t t-set="color" t-value="'core-blue'" />
                <t t-set="text_color" t-value="'black'" />
                <t t-set="radius" t-value="'pill'" />
            </t>
        </xpath>
    </template>
    <!-- Improve the user dropdown in the header -->
    <template id="user_dropdown" inherit_id="portal.user_dropdown">
        <xpath expr="//img" position="attributes">
            <attribute name="width">48</attribute>
            <attribute name="height">48</attribute>
        </xpath>
        <xpath expr="//li[@t-if='is_connected']" position="attributes">
            <attribute name="t-attf-class">#{_item_class} list-unstyled</attribute>
        </xpath>
        <xpath expr="//a[@href='/my/information']" position="replace">
            <a class="dropdown-item" href="/my2/user_settings" role="menuitem">Settings</a>
        </xpath>
    </template>
</odoo>
