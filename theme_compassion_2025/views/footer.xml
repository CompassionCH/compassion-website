<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
    <template id="footer_2025" inherit_id="website.layout">
        <!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="bg-dark-blue">
                <section>
                    <div class="d-flex compassion-thread">
                        <div class="h-100 w-25 bg-core-blue" />
                        <div class="h-100 w-25 bg-high-pink" />
                        <div class="h-100 w-25 bg-mid-orange" />
                        <div class="h-100 w-25 bg-low-green" />
                    </div>
                </section>
                <section class="pt48">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="d-flex flex-column align-items-start col-auto">

                                <div class="py-2 d-flex align-items-start">
                                    <div style="min-width: 30px; font-size: 1.2rem;" class="pt-1">
                                        <i class="icon-marker-pin01 bg-low-yellow text-primary" />
                                    </div>
                                    <a class="text-pure-white"
                                       t-if="res_company.partner_id.contact_address"
                                       t-att-href="'https://www.google.com/maps/search/' + res_company.partner_id.contact_address.replace(' ', '+')"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        <span t-esc="res_company.partner_id.contact_address" />
                                    </a>
                                </div>

                                <div class="py-2 d-flex align-items-center" t-if="res_company.phone">
                                    <div style="min-width: 30px; font-size: 1.2rem;">
                                        <i class="icon-phone bg-low-yellow text-primary" />
                                    </div>
                                    <a class="text-pure-white"
                                       t-att-href="'tel:' + res_company.phone.replace('(0)', '').replace(' ', '').replace('(', '').replace(')', '')">
                                        <span t-esc="res_company.phone" />
                                    </a>
                                </div>

                                <div class="py-2 d-flex align-items-center">
                                    <div style="min-width: 30px; font-size: 1.2rem;">
                                        <i class="icon-mail01 bg-low-yellow text-primary" />
                                    </div>
                                    <a class="text-pure-white" t-att-href="'mailto:' + res_company.email">
                                        <span t-esc="res_company.email" />
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                </section>

                <section class="pt32">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-12 text-center mb-3">
                                <p class="mb-0">
                                    Copyright ©
                                    <span t-esc="datetime.datetime.now().year" />
                                    <span t-esc="res_company.name" />
                                </p>
                            </div>

                            <div class="col-12 d-flex flex-column flex-md-row justify-content-center align-items-center">
                                <div class="mb-3 mb-md-0">
                                    <a class="text-pure-white mr-3" href="https://compassion.ch/protection-des-donnees/" target="_blank">
                                        Policies
                                    </a>
                                    <span class="d-none d-md-inline mr-3">|</span>
                                </div>
                                <div class="d-flex">
                                    <a href="https://www.facebook.com/compassionschweiz" target="_blank" class="mr-3">
                                        <i class="fa fa-facebook-official text-pure-white" />
                                    </a>
                                    <a href="https://www.instagram.com/compassionswiss" target="_blank" class="mr-3">
                                        <i class="fa fa-instagram text-pure-white" />
                                    </a>
                                    <a href="https://www.youtube.com/channel/UChVNRRvihHG0AYPsdEFfasQ" target="_blank" class="mr-3">
                                        <i class="fa fa-youtube-play text-pure-white" />
                                    </a>
                                    <a href="https://vimeo.com/compassionswitzerland" target="_blank" class="mr-3">
                                        <i class="fa fa-vimeo text-pure-white" />
                                    </a>
                                    <a href="https://www.linkedin.com/company/compassion-schweiz-suisse-svizzera" target="_blank">
                                        <i class="fa fa-linkedin text-pure-white" />
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 mt-3">
                                <hr style="border-top: 1px solid rgba(255,255,255,0.1);" />
                            </div>
                        </div>
                    </div>
                </section>

                <section class="pb48"></section>
            </div>
        </xpath>
    </template>
</odoo>