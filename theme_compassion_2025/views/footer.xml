<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
    <template id="footer_2025" inherit_id="website.layout">
        <!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="bg-dark-blue">
                <section>
                    <div class="d-flex compassion-thread">
                        <div class="h-100 w-25 bg-core-blue" />
                        <div class="h-100 w-25 bg-high-pink" />
                        <div class="h-100 w-25 bg-mid-orange" />
                        <div class="h-100 w-25 bg-low-green" />
                    </div>
                </section>
                <section class="pt24">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div
                                class="col-12 d-flex flex-column flex-lg-row justify-content-center align-items-center"
                            >
                                <div
                                    class="py-1 px-lg-4 d-flex flex-column flex-lg-row align-items-center align-items-lg-start justify-content-center"
                                >
                                    <div class="mb-1 mb-lg-0 mr-lg-2" style="font-size: 1.2rem;">
                                        <i class="icon-marker-pin01 bg-low-yellow text-primary" />
                                    </div>
                                    <a
                                        class="text-pure-white text-center text-lg-left"
                                        t-if="res_company.partner_id.contact_address"
                                        t-att-href="'https://www.google.com/maps/search/' + res_company.partner_id.contact_address.replace(' ', '+')"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        style="max-width: 300px;"
                                    >
                                        <span t-esc="res_company.partner_id.contact_address" />
                                    </a>
                                </div>
                                <div
                                    class="py-1 px-lg-4 d-flex flex-column flex-lg-row align-items-center justify-content-center"
                                    t-if="res_company.phone"
                                >
                                    <div class="mb-1 mb-lg-0 mr-lg-2" style="font-size: 1.2rem;">
                                        <i class="icon-phone bg-low-yellow text-primary" />
                                    </div>
                                    <a
                                        class="text-pure-white text-center text-lg-left"
                                        t-att-href="'tel:' + res_company.phone.replace('(0)', '').replace(' ', '').replace('(', '').replace(')', '')"
                                    >
                                        <span t-esc="res_company.phone" />
                                    </a>
                                </div>
                                <div
                                    class="py-1 px-lg-4 d-flex flex-column flex-lg-row align-items-center justify-content-center"
                                >
                                    <div class="mb-1 mb-lg-0 mr-lg-2" style="font-size: 1.2rem;">
                                        <i class="icon-mail01 bg-low-yellow text-primary" />
                                    </div>
                                    <a
                                        class="text-pure-white text-center text-lg-left"
                                        t-att-href="'mailto:' + res_company.email"
                                    >
                                        <span t-esc="res_company.email" />
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="pt16">
                    <div class="container">
                        <div class="row align-items-center">
                            <div class="col-12 text-center mb-2">
                                <p class="mb-0">
                                    Copyright ©
                                    <span t-esc="datetime.datetime.now().year" />
                                    <span t-esc="res_company.name" />
                                </p>
                            </div>
                            <div
                                class="col-12 d-flex flex-column flex-md-row justify-content-center align-items-center"
                            >
                                <div class="mb-2 mb-md-0">
                                    <a
                                        class="text-pure-white mr-3"
                                        href="https://compassion.ch/protection-des-donnees/"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Policies
                                    </a>
                                    <span class="d-none d-md-inline mr-3">|</span>
                                </div>
                                <div class="d-flex ml-1 mt-1">
                                    <a
                                        href="https://www.facebook.com/compassionschweiz"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mr-3"
                                    >
                                        <i class="fa fa-facebook-official text-pure-white" />
                                    </a>
                                    <a
                                        href="https://www.instagram.com/compassionswiss"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mr-3"
                                    >
                                        <i class="fa fa-instagram text-pure-white" />
                                    </a>
                                    <a
                                        href="https://www.youtube.com/channel/UChVNRRvihHG0AYPsdEFfasQ"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mr-3"
                                    >
                                        <i class="fa fa-youtube-play text-pure-white" />
                                    </a>
                                    <a
                                        href="https://vimeo.com/compassionswitzerland"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mr-3"
                                    >
                                        <i class="fa fa-vimeo text-pure-white" />
                                    </a>
                                    <a
                                        href="https://www.linkedin.com/company/compassion-schweiz-suisse-svizzera"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <i class="fa fa-linkedin text-pure-white" />
                                    </a>
                                </div>
                                <div class="mb-2 mb-md-0">
                                    <span class="d-none d-md-inline ml-3">|</span>
                                    <a
                                        class="text-pure-white ml-3"
                                        href="/contactus"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        Contact us
                                    </a>
                                </div>

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 mt-3">
                                <hr style="border-top: 1px solid rgba(255,255,255,0.1);" />
                            </div>
                        </div>
                    </div>
                </section>
                <section class="pb24" />
            </div>
        </xpath>
    </template>
</odoo>
