<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <!-- theme.compassion.colors views -->
        <record id="view_theme_compassion_colors_form" model="ir.ui.view">
            <field name="name">theme.compassion.colors.form</field>
            <field name="model">theme.compassion.colors</field>
            <field name="arch" type="xml">
                <form string="Colors">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="color" widget="color" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_theme_compassion_colors_tree" model="ir.ui.view">
            <field name="name">theme.compassion.colors.tree</field>
            <field name="model">theme.compassion.colors</field>
            <field name="arch" type="xml">
                <list string="Colors">
                    <field name="name" />
                    <field name="color" widget="color" />
                </list>
            </field>
        </record>
        <record id="action_theme_compassion_colors" model="ir.actions.act_window">
            <field name="name">Colors</field>
            <field name="res_model">theme.compassion.colors</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- theme.compassion.icons views -->
        <record id="view_theme_compassion_icons_form" model="ir.ui.view">
            <field name="name">theme.compassion.icons.form</field>
            <field name="model">theme.compassion.icons</field>
            <field name="arch" type="xml">
                <form string="Icons">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="svg_file" widget="image" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_theme_compassion_icons_tree" model="ir.ui.view">
            <field name="name">theme.compassion.icons.tree</field>
            <field name="model">theme.compassion.icons</field>
            <field name="arch" type="xml">
                <list string="Icons">
                    <field name="name" />
                    <field name="svg_file" widget="image" />
                </list>
            </field>
        </record>
        <record id="action_theme_compassion_icons" model="ir.actions.act_window">
            <field name="name">Icons</field>
            <field name="res_model">theme.compassion.icons</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- theme.compassion.pictograms views -->
        <record id="view_theme_compassion_pictograms_form" model="ir.ui.view">
            <field name="name">theme.compassion.pictograms.form</field>
            <field name="model">theme.compassion.pictograms</field>
            <field name="arch" type="xml">
                <form string="Pictograms">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                                <field name="svg_file" widget="image" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_theme_compassion_pictograms_tree" model="ir.ui.view">
            <field name="name">theme.compassion.pictograms.tree</field>
            <field name="model">theme.compassion.pictograms</field>
            <field name="arch" type="xml">
                <list string="Pictograms">
                    <field name="name" />
                    <field name="svg_file" widget="image" />
                </list>
            </field>
        </record>
        <record id="action_theme_compassion_pictograms" model="ir.actions.act_window">
            <field name="name">Pictograms</field>
            <field name="res_model">theme.compassion.pictograms</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- Menu items -->
        <menuitem id="menu_theme_compassion" name="Theme Compassion" parent="website.menu_website_configuration" />
        <menuitem
            id="menu_theme_compassion_colors"
            name="Colors"
            action="action_theme_compassion_colors"
            parent="theme_compassion_2025.menu_theme_compassion"
            sequence="10"
        />
        <menuitem
            id="menu_theme_compassion_icons"
            name="Icons"
            action="action_theme_compassion_icons"
            parent="theme_compassion_2025.menu_theme_compassion"
            sequence="15"
        />
        <menuitem
            id="menu_theme_compassion_pictograms"
            name="Pictograms"
            action="action_theme_compassion_pictograms"
            parent="theme_compassion_2025.menu_theme_compassion"
            sequence="20"
        />
    </data>
</odoo>
