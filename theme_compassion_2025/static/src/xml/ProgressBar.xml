<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: ProgressBar

    Description:
    Renders an animated step progress bar: a striped `.progress` element whose
    flow animation and clip-path reveal are driven by the stylesheet, plus a
    `.progress-text` label for the active step.

    Props:                                                                Default:
    - steps (string[]): step labels; the bar is split equally among them. [4 steps]
    - density (string): stripe density, "low" / "medium" / "high".        [medium]
    - flowSpeed (string): CSS duration for the stripe flow animation.     [4s]
    - step (number): zero-based index of the active step.                 [0]
    - flowing (bool): whether the flow animation runs.                    [true]
-->
<templates xml:space="preserve">
    <t t-name="theme_compassion_2025.ProgressBar">
        <div class="progress-bar-container">
            <div
                t-attf-class="progress mb-3 density-{{ props.density }}{{ state.flowing ? ' is-flowing' : '' }}"
                t-attf-style="--flow-speed: {{ props.flowSpeed }}; clip-path: {{ clipPath }};"
            />
            <p class="progress-text mb-0" t-esc="progressText" />
        </div>
    </t>
</templates>
