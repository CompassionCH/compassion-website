<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component:
        ProgressBarComponent

    Description:
        A lightweight template for rendering the animated progress bar. It defines
        the visual container, the progress stripe element, and the text label area.
        This component is used by `ProgressBarWidget` (defined in JS) to apply
        animation, density levels, flow speed, and step messages dynamically.

    Usage:
        This template is not used directly. It is rendered and controlled by
        `ProgressBarWidget` (see ProgressBar.js), which:
        - injects the density class ("density-low", "density-medium", "density-high")
        - updates the CSS variable "flow-speed"
        - animates the progress fill using clip-path
        - updates the progress text step-by-step

    Props:
        N/A (all configuration is handled in the JavaScript widget via options).

-->
<template>
    <t t-name="theme_compassion_2025.ProgressBarComponent">
        <div class="progress-bar-container">
            <div class="progress mb-3" />
            <p class="progress-text mb-0" />
        </div>
    </t>
</template>
