            <div class="col-12 col-md-9">
              <p class="h3 font-weight-bold mb-1">Chrismas Appeal 2025</p>
              <p class="mb-0">Discover a love worth sharing. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut</p>
            </div>
            <div class="col-12 col-md-2 d-flex justify-content-md-around align-items-md-center">
              <a href="#" class="btn btn-light btn-sm mr-3">button</a>
                <i href="#" class="h5 mb-0 icon-x-circle cursor-pointer text-pure-white"/>
            </div>
          </div>
        </div>
    </t>
</templates>