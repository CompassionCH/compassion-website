<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Password

    Description:
    Displays a password input field with a show/hide toggle icon.

    Props:                                                                Default:
    - required (bool): Whether the password is required for the form.     [false]
-->
<templates xml:space="preserve">
    <t t-name="theme_compassion_2025.PasswordComponent">
        <!-- Component definition -->
        <div class="password-container">
            <input
                t-att-type="state.visible ? 'text' : 'password'"
                t-att-name="props.inputName"
                class="form-control"
                t-att-required="props.required"
                placeholder="Password"
                maxlength="4096"
            />
            <i
                t-att-class="'password-show-toggle text-mid-grey fa ' + (state.visible ? 'fa-eye' : 'fa-eye-slash')"
                t-on-click="onTogglePasswordVisibility"
                aria-hidden="true"
            />
        </div>
    </t>
</templates>
