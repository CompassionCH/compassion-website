<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Password

    Description:
    Displays a password input field with a show/hide toggle icon.

    Props:                                                                Default:
    - required (bool): Whether the password is required for the form.     [false]
-->
<templates>
    <t t-name="theme_compassion_2025.PasswordComponent">
        <!-- Component definition -->
        <div class="password-container">
            <input
                type="password"
                name="password"
                class="form-control"
                t-att-required="widget.required"
                placeholder="Password"
                maxlength="4096"
            />
            <i class="password-show-toggle text-mid-grey fa fa-eye-slash" aria-hidden="true" />
        </div>
    </t>
</templates>
