<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Title Component with optional underline
    Related SCSS directives defined in: theme_compassion_2025/static/src/scss/components/_title.scss
    Props:
    - title_content (string): The title to display.
    - title_size (string): The size of the title ('sm', 'md', 'lg').
    - align_sm (string): The alignment of the title on a small screen ('left', 'center' (default), 'right').
    - color (string): Text color for the title.
    - show_underline (boolean): True/False to show underline.
    - underline_color (string): Color for the underline.
    - description (string): Optional text to display below the title/underline.
-->
<odoo>
    <template id="TitleComponent" name="Title Component">
        <div t-attf-class="title-component title-component--align-sm-#{align_sm or 'center'}">
            <h1 t-attf-class="title-heading title-size-#{title_size or 'md'} text-#{color}">
                <t t-esc="title_content" />
            </h1>
            <t t-if="show_underline">
                <div t-attf-class="title-underline text-#{underline_color}" />
            </t>
            <t t-if="description">
                <p class="title-description">
                    <t t-esc="description" />
                </p>
            </t>
        </div>
    </template>
</odoo>
