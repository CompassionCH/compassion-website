<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Form Field Component

    Description:
    Renders a label for a form field. The input element should be passed as content.

    Props:
    - label (string): The text seen on top of the component.
    - input_id (string): ID of the linked input
    - top_class (string): class for the outer div element wrapping everything
-->
<odoo>
  <template id="FormFieldComponent" name="Form Field Component">
    <div t-attf-class="form-field-component #{top_class or ''}">
      <label
        t-if="label"
        t-att-for="input_id"
        t-attf-class="text-#{label_color or 'core-blue'} body-small bold mb-1"
      >
        <t t-esc="label" />
      </label>
      <t t-out="0" />
    </div>
  </template>
</odoo>
