<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Form Field Component

    Description:
    Renders a label for a form field. The input element should be passed as content.

    Props:
    - label (string): The text seen on top of the component.
    - invalid_hint (string): Hint to show when the input is given the 'is-invalid' class.
    - input_id (string): ID of the linked input
    - top_class (string): class for the outer div element wrapping everything
-->
<odoo>
    <template id="FormFieldComponent" name="Form Field Component">
        <t t-set="final_invalid_hint" t-value="invalid_hint or 'Invalid value.'" />
        <div t-attf-class="form-field-container #{top_class}">
            <t t-if="label">
                <label t-att-for="input_id" t-attf-class="text-#{label_color or 'core-blue'} body-small bold mb-1">
                    <t t-esc="label" />
                </label>
            </t>
            <t t-if="display_content">
                <t t-raw="display_content" />
            </t>
            <t t-if="edit_field">
                <div class="field-edit">
                    <t t-raw="0" />
                    <div class="invalid-feedback text-mid-orange tiny-text mb-1">
                        <t t-esc="final_invalid_hint" />
                    </div>
                </div>
            </t>
            <t t-else="">
                <div class="invalid-feedback text-mid-orange tiny-text mb-1">
                    <t t-esc="final_invalid_hint" />
                </div>
                <t t-raw="0" />
            </t>
        </div>
    </template>
</odoo>
