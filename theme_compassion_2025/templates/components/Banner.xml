<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Banner

    Description:
    Displays a square clickable vignette with an image, title (optionally a subtitle) and icon to redirect the user to
    other pages of the website.

    Props:
    - image (string): Image displayed on the vignette.
    - title (html string): Title of the vignette.
    - subtitle (html string): Subtitle to display under the title (optional).
    - icon (string): Icon class to display on the vignette.
    - color (string): Text and icon color.
    - bg_color (string): Color of the vignette banner.
    - href (string): Href target of the vignette.
-->
<odoo>
    <template id="BannerComponent" name="Banner Component">
        <div class="d-flex bg-low-blue p-2">
            <div class="p-2">
                <i t-attf-class="pictogram-centre-gift text-pure-white h1" />
            </div>
            <div class="d-flex flex-column align-items-start pb-4">
                <t t-call="theme_compassion_2025.TitleComponent">
                    <t t-set="title_content" t-value="'Gift of compassion'"/>
                    <t t-set="color" t-value="'pure-white'" />
                </t>
                <p class="text-pure-white">Every child deserves a secure home, safe water and medicine to keep them healthy. That’s why when poverty places a child in critical need, we take action.</p>
                <t t-call="theme_compassion_2025.ThemedButtonComponent">
                    <t t-set="label" t-value="'Send a gift'" />
                    <t t-set="text_color" t-value="'pure-white'" />
                    <t t-set="color" t-value="'pure-white'" />
                    <t t-set="variation" t-value="'outlined'" />
                    <t t-set="variant" t-value="'compact'" />
                </t>
            </div>
        </div>
    </template>
</odoo>
