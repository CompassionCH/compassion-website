<?xml version="1.0" encoding="utf-8" ?>
<!--
    Component: Theme Button from 2025 Compassion Switzerland Theme

    Description:
    This component renders a themed button with customizable properties

    Will be used in probably multiple places in the website

    See theme_compassion_2025/static/src/scss/components/_buttons.scss for the button styles
    and theme_compassion_2025/static/src/scss/abstracts/_colors.scss for the color variables.

    The variation can be 'hollow' or 'filled', which will determine if the button has a border or a background color.

    Injected data:
    - variant (string): Type of the button, e.g., 'default', 'impact' or 'compact'
        - Impact is used for buttons that have a strong call to action, e.g., 'Donate Now'
        - Compact is used for buttons that are smaller and more subtle or when space is limited
        - Default is used for standard buttons
    - variation (string): Variation of the button, e.g., 'hollow' or 'filled'
    - label (string): Text to display on the button
    - icon (string): FontAwesome icon class to display on the button
    - color (string): Color of the button
    - icon_color (string): Color of the icon
    - text_color (string): Color of the text
    - id (string, optional): The ID to be assigned to the button element.
    - href (string, optional): The URL to link to. If provided, an 'a' tag will be rendered instead of a 'button'.
    - radius (string, optional): Radius of the rounded corners: 'pill' (default) or 'small'
    - data_custom (char, optional): data-custom attribute to be added to the button or link element, e.g., `data-custom="value"`
-->
<odoo>
    <template id="ThemedButtonComponent_Content" name="Button Content">
        <t t-if="icon">
            <span t-attf-class="btn__icon btn__icon--#{variant} text-#{icon_color}">
                <i t-att-class="icon" />
            </span>
        </t>
        <t t-if="label">
            <span>
                <t t-esc="label" />
            </span>
        </t>
    </template>
    <template id="ThemedButtonComponent" name="Button Component">
        <!-- Default property values -->
        <t t-set="radius" t-value="radius or 'pill'" />
        <!-- Determine button style class border or background depending on the variation-->
        <t t-if="variation == 'hollow'">
            <t t-set="style_class" t-value="'border border-2 border-' + color" />
        </t>
        <t t-elif="variation == 'filled'">
            <t t-set="style_class" t-value="'bg-' + color" />
        </t>
        <t t-else="">
            <t t-set="style_class" t-value="'bg-black'" />
        </t>
        <t t-if="href">
            <a
                t-att-href="href"
                t-att-id="id"
                t-attf-class="btn btn--#{variant}-#{variation} btn--radius-#{radius} #{style_class} text-#{text_color}"
                t-att-data-custom="data_custom"
            >
                <t t-call="theme_compassion_2025.ThemedButtonComponent_Content" />
            </a>
        </t>
        <t t-else="">
            <button
                t-att-id="id"
                t-attf-class="btn btn--#{variant}-#{variation} btn--radius-#{radius}
                                                #{style_class} text-#{text_color}"
                t-att-data-custom="data_custom"
            >
                <t t-call="theme_compassion_2025.ThemedButtonComponent_Content" />
            </button>
        </t>
    </template>
</odoo>
