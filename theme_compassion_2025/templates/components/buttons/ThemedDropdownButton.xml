<odoo>
    <template id="ThemedDropdownButtonComponent_Content" name="Button Content">
        <t t-if="icon_left">
            <div t-attf-class="btn__icon #{'btn__icon--' + variant if label else ''} text-#{icon_left_color}">
                <i t-att-class="icon_left"/>
            </div>
        </t>

        <div t-if="label" t-att-id="label_id">
            <t t-esc="label"/>
        </div>

        <t t-if="icon_right">
            <div t-attf-class="btn__icon btn__icon--right text-#{icon_right_color} ml-2">
                <i t-att-class="icon_right"/>
            </div>
        </t>
    </template>

    <template id="ThemedDropdownButtonComponent" name="Button Component">
        <t t-set="radius" t-value="radius or 'pill'"/>
        <t t-set="color" t-value="color or 'primary'"/>

        <t t-if="variation == 'hollow'"
           t-set="style_class"
           t-value="'border border-2 border-%s' % color"/>

        <t t-elif="variation == 'filled'"
           t-set="style_class"
           t-value="'bg-%s' % color"/>

        <t t-elif="variation == 'outlined'"
           t-set="style_class"
           t-value="'bg-%s border border-2 border-%s text-%s-hover' % (color, text_color, color)"/>

        <t t-else=""
           t-set="style_class"
           t-value="'bg-black'"/>

        <t t-set="btn_modifier"
           t-value="'btn--%s-%s%s' % (variant, variation, '-icon-only' if (icon and not label) else '')"/>

        <t t-set="shared_classes"
           t-value="'btn %s btn--radius-%s %s text-%s' % (btn_modifier, radius, style_class, text_color)"/>

        <t t-if="href">
            <a t-att-href="href"
               t-att-id="id"
               t-att-class="shared_classes"
               t-att-data-custom="data_custom">
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content"/>
            </a>
        </t>
        <t t-else="">
            <button t-att-id="id"
                    t-att-class="shared_classes"
                    t-att-data-custom="data_custom"
                    t-att-data-mode="mode"
                    type="button"
                    data-toggle="dropdown"
                    aria-haspopup="true">
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content"/>
            </button>
        </t>
    </template>
</odoo>