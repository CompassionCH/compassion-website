<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <template id="my_information_personal" inherit_id="my_compassion.my_information_personal">
            <xpath expr="//div[hasclass('d-flex', 'mt-4')]" position="replace">
                <div class="d-flex mt-4 align-items-center">
                    <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent">
                        <t t-set="label">Edit my details</t>
                        <t t-set="href">/my/account?redirect=/my/information</t>
                        <t t-set="variant" t-value="'default'" />
                        <t t-set="variation" t-value="'filled'" />
                        <t t-set="color" t-value="'primary'" />
                        <t t-set="text_color" t-value="'white'" />
                        <t t-set="font_size" t-value="'mr-4'" />
                    </t>

                    <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent">
                        <t t-set="label">Change Password</t>
                        <t t-set="href">/my/security?redirect=/my/information</t>
                        <t t-set="variant" t-value="'default'" />
                        <t t-set="variation" t-value="'filled'" />
                        <t t-set="color" t-value="'primary'" />
                        <t t-set="text_color" t-value="'white'" />
                        <t t-set="font_size" t-value="'ml-4'" />
                    </t>
                </div>
            </xpath>
        </template>


        <template id="language_selector_pill_style" inherit_id="portal.language_selector">
            <xpath expr="." position="inside">
                <style>
                    /* 1. The "Curtain" Animation */
                    @keyframes curtainDrop {
                        0% { opacity: 0; max-height: 0; }
                        100% { opacity: 1; max-height: 400px; }
                    }

                    /* 2. Apply Animation */
                    .animation-drop.show {
                        animation: curtainDrop 0.3s ease-out forwards;
                        overflow: hidden;
                        display: block;
                    }

                    /* 3. Hide inner scrollbar */
                    .animation-drop {
                        scrollbar-width: none;
                        -ms-overflow-style: none;
                    }
                    .animation-drop::-webkit-scrollbar {
                        display: none;
                    }

                    /* 4. Specific pill adjustments */
                    .dropdown-language-button {
                        padding: 0.5rem 1rem !important; /* Adjusted padding */
                        line-height: 1 !important;
                        gap: 0.5rem;
                    }
                </style>
            </xpath>

            to fix XML error)
            -->
            <xpath expr="//div[hasclass('dropdown-menu')]" position="attributes">
                <attribute name="class" add="dropdown-menu-right shadow-sm animation-drop" separator=" "/>
            </xpath>

            <xpath expr="//button[hasclass('dropdown-toggle')]" position="replace">
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent">
                    <t t-set="variant" t-value="'compact'" />
                    <t t-set="variation" t-value="'hollow dropdown-language-button'" />

                    <t t-set="label" t-value="active_lang[0].split('_')[0].upper()" />

                    <t t-set="font_size" t-value="'small'" />

                    <t t-set="icon_left" t-value="'icon-globe01'" />
                    <t t-set="icon_left_color" t-value="'core-blue'" />

                    <t t-set="icon_right" t-value="'icon-chevron-down'" />
                    <t t-set="icon_right_color" t-value="'black'" />

                    <t t-set="color" t-value="'core-blue'" />
                    <t t-set="text_color" t-value="'black'" />
                    <t t-set="radius" t-value="'pill'" />
                </t>
            </xpath>
        </template>

    </data>
</odoo>