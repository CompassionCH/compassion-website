<odoo>
    <!--
    Component: Theme Dropdown Button from 2025 Compassion Switzerland Theme

    Description:
    This component renders a themed dropdown button with customizable properties

    Will be used in probably multiple places in the website

    See theme_compassion_2025/static/src/scss/components/_buttons.scss for the button styles
    and theme_compassion_2025/static/src/scss/abstracts/_colors.scss for the color variables.

    The variation can be 'hollow' or 'filled', which will determine if the button has a border or a background color.

    Injected data:
    - variant (string): Type of the button, e.g., 'default', 'impact' or 'compact'
        - Impact is used for buttons that have a strong call to action, e.g., 'Donate Now'
        - Compact is used for buttons that are smaller and more subtle or when space is limited
        - Default is used for standard buttons
    - variation (string): Variation of the button, e.g., 'hollow', 'filled' or 'outlined'
    - label (string): Text to display on the button
    - icon_right (string): FontAwesome icon class to display on the button right to the label
    - icon_right_color (string): Color of the right icon
    - icon_left (string): FontAwesome icon class to display on the button left to the label
    - icon_left_color (string): Color of the left icon
    - color (string): Color of the button
    - text_color (string): Color of the text
    - id (string, optional): The ID to be assigned to the button element.
    - href (string, optional): The URL to link to. If provided, an 'a' tag will be rendered instead of a 'button'.
    - radius (string, optional): Radius of the rounded corners: 'pill' (default) or 'small'
    - data_custom (char, optional): data-custom attribute to be added to the button or link element, e.g., `data-custom="value"`
-->
    <template id="ThemedDropdownButtonComponent_Content" name="Button Content">
        <t t-if="icon_left">
            <span t-attf-class="btn__icon #{'btn__icon--' + variant if label else ''} text-#{icon_left_color}">
                <i t-att-class="icon_left" />
            </span>
        </t>
        <span t-if="label" t-att-id="label_id">
            <t t-esc="label" />
        </span>
        <t t-if="icon_right">
            <span t-attf-class="btn__icon btn__icon--right text-#{icon_right_color} ml-2 transition-icon">
                <i t-att-class="icon_right" />
            </span>
        </t>
    </template>
    <template id="ThemedDropdownButtonComponent" name="Button Component">
        <t t-set="radius" t-value="radius or 'pill'" />
        <t t-set="color" t-value="color or 'primary'" />
        <t t-set="style_class" t-value="'border border-2 border-%s' % color" />
        <t
            t-set="btn_modifier"
            t-value="'btn--%s-%s%s' % (variant, variation, '-icon-only' if (icon and not label) else '')"
        />
        <t
            t-set="shared_classes"
            t-value="'btn %s btn--radius-%s %s text-%s d-flex align-items-center justify-content-center' % (btn_modifier, radius, style_class, text_color)"
        />
        <t t-if="href">
            <a t-att-href="href" t-att-id="id" t-att-class="shared_classes" t-att-data-custom="data_custom">
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content" />
            </a>
        </t>
        <t t-else="">
            <button
                t-att-id="id"
                t-att-class="shared_classes"
                t-att-data-custom="data_custom"
                t-att-data-mode="mode"
                type="button"
                data-toggle="dropdown"
                aria-haspopup="true"
            >
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content" />
            </button>
        </t>
    </template>
</odoo>
