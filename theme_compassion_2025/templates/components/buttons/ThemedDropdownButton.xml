<odoo>
    <!--
    Component: Themed Dropdown Button (2025 Compassion Switzerland Theme)

    Description:
    This component renders a themed button or dropdown toggle with customizable
    styles, colors, icons, and behavior.
    Relevant styles:
    - Button styles: theme_compassion_2025/static/src/scss/components/_buttons.scss
    - Color variables: theme_compassion_2025/static/src/scss/abstracts/_colors.scss

    Options:
    - variant (string): Style variant of the button (e.g., 'default', 'impact', 'compact').
        * default → standard button
        * impact → strong call-to-action (e.g., “Donate Now”)
        * compact → smaller, subtle, or space-restricted buttons
    - variation (string): Button appearance variation (e.g., 'filled', 'hollow', 'outlined').
    - label (string): Text to display inside the button.
    - icon_left (string): icon displayed left of the label.
    - icon_left_color (string): Optional color class for the left icon.
    - icon_right (string): icon displayed right of the label.
    - icon_right_color (string): Optional color class for the right icon.
    - color (string): Button color theme name (default: 'primary').
    - text_color (string): Text color class.
    - radius (string): Border radius style: 'pill' (default) or 'small'.
    - id (string, optional): HTML ID for the button element.
    - href (string, optional): If set, renders an <a> instead of a <button>.
    - data_custom (string, optional): Adds a data-custom="…" attribute.
    - mode (string, optional): Adds a data-mode="…" attribute.
    -->
    <template id="ThemedDropdownButtonComponent_Content" name="Button Content">
        <t t-if="icon_left">
            <span t-attf-class="btn__icon text-#{icon_left_color} mr-1 language-selector__icon">
                <i t-att-class="icon_left" />
            </span>
        </t>
        <span t-if="label" t-att-id="label_id">
            <t t-esc="label" />
        </span>
        <t t-if="icon_right">
            <span t-attf-class="btn__icon text-#{icon_right_color} ml-2 transition-icon language-selector__icon">
                <i t-att-class="icon_right" />
            </span>
        </t>
    </template>
    <template id="ThemedDropdownButtonComponent" name="Button Component">
        <t t-set="radius" t-value="radius or 'pill'" />
        <t t-set="color" t-value="color or 'primary'" />
        <t t-set="style_class" t-value="'border border-2 border-%s' % color" />
        <t
            t-set="btn_modifier"
            t-value="'btn--%s-%s%s' % (variant, variation, '-icon-only' if (icon_left and icon_right and not label) else '')"
        />
        <t
            t-set="shared_classes"
            t-value="'btn %s btn--radius-%s %s text-%s d-flex align-items-center justify-content-center' % (btn_modifier, radius, style_class, text_color)"
        />
        <t t-if="href">
            <a t-att-href="href" t-att-id="id" t-att-class="shared_classes" t-att-data-custom="data_custom">
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content" />
            </a>
        </t>
        <t t-else="">
            <button
                t-att-id="id"
                t-att-class="shared_classes"
                t-att-data-custom="data_custom"
                t-att-data-mode="mode"
                type="button"
                data-toggle="dropdown"
                aria-haspopup="true"
            >
                <t t-call="theme_compassion_2025.ThemedDropdownButtonComponent_Content" />
            </button>
        </t>
    </template>
</odoo>
