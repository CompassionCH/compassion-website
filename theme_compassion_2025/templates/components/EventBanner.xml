<?xml version="1.0" encoding="utf-8"?>
<!--
    Component: Event Banner Component
    Description: Renders a dismissible banner based on provided data.

    Props (passed from JavaScript):
    - id: The unique ID of the banner.
    - color: The background color class (e.g., 'core-blue').
    - pictogram: The Font Awesome icon class (e.g., 'children').
    - text: The main message of the banner.
    - button_action: The URL for the button (if any).

-->
<odoo>
    <template id="EventBannerComponent" name="Event Banner Component">
        <div t-att-data-id="id"
        t-attf-class="event-banner bg-#{background_color} text-low-black mt-3 px-3 py-3 px-md-5 rounded-lg">
            <div class="row no-gutters align-items-center">

                <!-- Mobile Close Button and Pictogram Centered -->
                <div class="col-12 d-md-none mb-2">
                    <div class="d-flex align-items-start">
                        <i href="#" t-attf-class="invisible h3 mb-0 icon-x-circle"/>
                    <div class="flex-fill d-flex justify-content-center">
                        <i t-attf-class="display-4 mb-0 pictogram-#{pictogram} text-#{pictogram_color}"/>
                    </div>
                        <i href="#" t-attf-class="action-close h3 mb-0 icon-x-circle cursor-pointer text-#{button_color}"/>
                  </div>
                </div>

                <!-- Desktop Pictogram and Content -->
                <div class="col-12 col-md-1 d-none d-md-flex align-items-center justify-content-center">
                    <i t-attf-class="display-4 mb-0 pictogram-#{pictogram} text-#{pictogram_color}"/>
                </div>

                <div class="col-12 col-md-7 col-lg-8 col-xl-9 d-flex flex-column align-items-center text-center align-items-md-start text-md-left">
                    <p class="h3 font-weight-bold mb-1 text-low-black">
                        <t t-esc="title"/>
                    </p>
                    <p class="mb-0 text-low-black">
                        <t t-esc="description"/>
                    </p>
                </div>

                <div class="col-12 col-md-4 col-lg-3 col-xl-2 d-flex justify-content-center justify-content-md-around align-items-md-center mt-3 mt-md-0">
                    <t t-call="theme_compassion_2025.ThemedButtonComponent">
                        <t t-set="variant" t-value="'default'"/>
                        <t t-set="variation" t-value="'filled'"/>
                        <t t-set="label" t-value="button_label or 'Learn more'"/>
                        <t t-set="href"  t-value="button_action"/>
                        <t t-set="color" t-value="button_color"/>
                        <t t-set="text_color" t-value="button_text_color or 'dark'"/>
                        <t t-set="radius" t-value="'pill'"/>
                        <t t-set="href" t-value="button_action" />
                        <t t-set="text_color" t-value="'pure-white'" />
                    </t>
                    <!-- Refactor after Icon Button is merged -->
                    <i href="#" t-attf-class="action-close h3 d-none d-md-inline mb-0 icon-x-circle cursor-pointer text-#{button_color}"/>
                </div>

            </div>
        </div>

    </template>
</odoo>

