<odoo>
  <template id="sale_confirmation" inherit_id="website_sale.confirmation">
    <xpath expr="//h3" position="attributes">
      <attribute name="t-att-class">'d-none' if order.is_donation else ''</attribute>
    </xpath>
    <xpath expr="//h3" position="after">
      <h3 t-att-class="'d-none' if not order.is_donation else ''">
                Thank you for your donation!
            </h3>
    </xpath>
    <xpath expr="//a[@href='/shop/print']" position="attributes">
      <attribute name="class" />
      <attribute
        name="t-attf-class"
      >d-none btn btn-primary ms-auto #{'d-md-inline-block' if not order.is_donation else ''}</attribute>
    </xpath>
    <xpath expr="//h5" position="attributes">
      <attribute name="t-att-class">'d-none' if order.is_donation else ''</attribute>
    </xpath>
  </template>
</odoo>
