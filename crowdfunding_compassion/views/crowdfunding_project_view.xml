<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- Form view-->
  <record id="crowdfunding_project_view" model="ir.ui.view">
    <field name="name">Crowdfunding Project View</field>
    <field name="model">crowdfunding.project</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button
            name="validate"
            string="Validate project"
            type="object"
            class="btn-primary"
            invisible="state != 'draft'"
          />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button
              name="open_participants"
              type="object"
              class="oe_stat_button"
              icon="fa-group"
            >
              <div class="o_form_field o_stat_info">
                <span class="o_stat_value">
                  <field name="number_participants" />
                </span>
                <span class="o_stat_text">Participants</span>
              </div>
            </button>
            <button
              name="open_donations"
              type="object"
              class="oe_stat_button"
              icon="fa-money"
            >
              <div class="o_form_field o_stat_info">
                <span class="o_stat_value">
                  <span class="oe_inline">CHF</span>
                  <field name="amount_reached" />
                </span>
                <span class="o_stat_text">Donations</span>
              </div>
            </button>
            <button
              name="open_sponsorships"
              type="object"
              class="oe_stat_button"
              icon="fa-child"
            >
              <div class="o_form_field o_stat_info">
                <span class="o_stat_value">
                  <field name="number_sponsorships_reached" />
                </span>
                <span class="o_stat_text">Sponsorships</span>
              </div>
            </button>
            <field name="website_published" widget="website_redirect_button" />
            <field name="active" invisible="1" />
            <widget
              name="web_ribbon"
              title="Archived"
              bg_color="bg-danger"
              invisible="active"
            />
          </div>
          <div>
            <field name="cover_photo" widget="image" class="oe_avatar" />
            <div class="oe_title">
              <h4>
                <field name="website_id" groups="website.group_website_designer" />
              </h4>
              <h3>
                <field name="type" />
              </h3>
              <h1>
                <field name="name" />
              </h1>
            </div>
          </div>
          <notebook name="project_relation">
            <page string="Details" name="project_description">
              <div class="container-fluid">
                <div class="row">
                  <div class="col">
                    <label for="deadline" />
                    <h3>
                      <field name="deadline" widget="date" />
                    </h3>
                    <label for="project_owner_id" />
                    <h3>
                      <field name="project_owner_id" widget="many2one" />
                    </h3>
                    <field name="owner_participant_id" invisible="1" />
                    <label
                      for="owner_number_sponsorships_goal"
                      invisible="owner_participant_id"
                    />
                    <field
                      name="owner_number_sponsorships_goal"
                      invisible="owner_participant_id"
                    />
                    <label
                      for="owner_number_csp_goal"
                      invisible="owner_participant_id"
                    />
                    <field
                      name="owner_number_csp_goal"
                      invisible="owner_participant_id"
                    />
                    <label
                      for="owner_product_number_goal"
                      invisible="owner_participant_id"
                    />
                    <field
                      name="owner_product_number_goal"
                      invisible="owner_participant_id"
                    />
                    <label for="event_id" invisible="event_id == ''" />
                    <h3>
                      <field name="event_id" widget="many2one" />
                    </h3>
                    <label for="product_id" />
                    <h3>
                      <field name="product_id" widget="many2one" />
                    </h3>
                    <label for="product_price" />
                    <h3>
                      <field name="product_price" />
                    </h3>
                  </div>
                  <div class="col">
                    <label for="product_number_reached" />
                    <h3>
                                            <field name="product_number_reached" />
                                            /
                                            <field name="product_number_goal" />
                                            <field
                      name="product_crowdfunding_impact"
                      style="margin-left: 0.5em; font-weight: normal"
                    />
                                        </h3>
                    <label for="number_sponsorships_reached" />
                    <h3>
                                            <field name="number_sponsorships_reached" />
                                            /
                                            <field name="number_sponsorships_goal" />
                                        </h3>
                    <label for="number_csp_reached" />
                    <h3>
                                            <field name="number_csp_reached" />
                                            /
                                            <field name="number_csp_goal" />
                                        </h3>
                  </div>
                  <div class="col">
                    <label for="presentation_video" />
                    <h3>
                      <field name="presentation_video" widget="char" />
                    </h3>
                    <label for="facebook_url" />
                    <h3>
                      <field name="facebook_url" widget="char" />
                    </h3>
                    <label for="twitter_url" />
                    <h3>
                      <field name="twitter_url" widget="char" />
                    </h3>
                    <label for="instagram_url" />
                    <h3>
                      <field name="instagram_url" widget="char" />
                    </h3>
                    <label for="personal_web_page_url" />
                    <h3>
                      <field name="personal_web_page_url" widget="char" />
                    </h3>
                  </div>
                </div>
                <div class="row">
                  <div class="col">
                    <label for="description" />
                    <p>
                      <field name="description" nolabel="1" />
                    </p>
                  </div>
                </div>
              </div>
            </page>
            <page string="Participants" name="project_participants">
              <field
                name="participant_ids"
                widget="one2many"
                context="{'default_project_id': id}"
              >
                <list>
                  <field name="partner_id" />
                  <field name="product_number_reached" />
                  <field name="number_sponsorships_reached" />
                </list>
              </field>
            </page>
            <page string="Donations">
              <field
                name="invoice_line_ids"
                widget="one2many"
                context="{'default_tree_view': %(crowdfunding_compassion.donation_tree_view)d}"
                domain="[('payment_state','=','paid')]"
              />
            </page>
            <page string="Sponsorships">
              <field name="sponsorship_ids" widget="one2many">
                <list default_order="create_date desc">
                  <field name="create_date" />
                  <field name="partner_id" />
                  <field name="child_id" />
                  <field name="ambassador_id" />
                  <field name="total_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
            <page string="CSP">
              <field name="csp_sponsorship_ids" widget="one2many">
                <list default_order="create_date desc">
                  <field name="create_date" />
                  <field name="partner_id" />
                  <field name="ambassador_id" />
                  <field name="total_amount" />
                  <field name="state" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter />
      </form>
    </field>
  </record>
  <!-- Search view -->
  <record id="crowdfunding_project_search_all" model="ir.ui.view">
    <field name="name">crowdfunding.project.search</field>
    <field name="model">crowdfunding.project</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="type" />
        <field name="create_date" />
        <field name="deadline" />
        <filter
          name="state_active"
          domain="[('state', '=', 'active')]"
          string="Active"
        />
        <filter name="state_draft" domain="[('state', '=', 'draft')]" string="Draft" />
        <filter name="state_done" domain="[('state', '=', 'done')]" string="Done" />
        <group expand="0" string="Group By">
          <filter string="Type project" name="type" context="{'group_by':'type'}" />
          <filter
            string="Created"
            name="create_date"
            context="{'group_by':'create_date'}"
          />
          <filter
            string="Project owner"
            name="project_owner_id"
            context="{'group_by':'project_owner_id'}"
          />
          <filter string="Deadline" name="deadline" context="{'group_by':'deadline'}" />
        </group>
      </search>
    </field>
  </record>
  <!-- List view -->
  <record id="view_crowdfunding_project_tree" model="ir.ui.view">
    <field name="name">crowdfunding.project.list</field>
    <field name="model">crowdfunding.project</field>
    <field name="arch" type="xml">
      <list
        decoration-info="website_published==False or state=='draft'"
        decoration-muted="active==False or state=='done'"
        default_order="deadline desc"
      >
        <field name="cover_photo" widget="image" optional="hide" />
        <field name="name" />
        <field name="website_id" />
        <field name="project_owner_id" />
        <field name="deadline" />
        <field name="product_number_reached" />
        <field name="number_sponsorships_reached" />
        <field name="amount_reached" widget="monetary" />
        <field name="website_published" column_invisible="1" />
        <field name="state" />
        <field name="active" column_invisible="1" />
      </list>
    </field>
  </record>

  <!-- Action opening the list view -->
  <record id="open_view_crowdfunding_project_tree" model="ir.actions.act_window">
    <field name="name">Project</field>
    <field name="res_model">crowdfunding.project</field>
    <field name="view_mode">list,form</field>
    <field
      name="context"
    >{'search_default_state_draft':1,'search_default_state_active':1}</field>
    <field name="path">crowdfunding</field>
  </record>
  <!-- Menu -->
  <menuitem
    id="menu_crowdfunding_project"
    parent="menu_event_crowdfunding"
    name="Projects"
    action="open_view_crowdfunding_project_tree"
    sequence="1"
  />
</odoo>
