<odoo>
  <!-- Invoice Line Form -->
  <record id="donation_tree_view" model="ir.ui.view">
    <field name="name">account.move.line.crowdfunding.list</field>
    <field name="model">account.move.line</field>
    <field name="type">list</field>
    <field name="arch" type="xml">
      <list
        decoration-primary="parent_state == 'draft'"
        decoration-muted="parent_state in ('posted', 'cancel')"
        default_order="due_date desc"
      >
        <field name="due_date" />
        <field name="partner_id" />
        <field name="user_id" />
        <field name="quantity" sum="Total" />
        <field name="price_subtotal" sum="Total" />
        <field name="parent_state" />
        <field name="payment_state" />
        <field name="is_anonymous" />
      </list>
    </field>
  </record>
</odoo>
