<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="new_participant_settings_form" model="ir.ui.view">
    <field name="name">new.participant.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="message_center_compassion.compassion_settings" />
    <field name="arch" type="xml">
      <block name="notification_configuration">
        <setting id="crowdfunging_participant_notify">
          <field name="new_participant_notify_ids" widget="many2many_tags" />
        </setting>
      </block>
    </field>
  </record>
</odoo>
