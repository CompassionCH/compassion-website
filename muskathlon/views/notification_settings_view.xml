<odoo>
  <!-- Configuration View -->
  <record id="view_notification_settings_muskathlon_form" model="ir.ui.view">
    <field name="name">staff.notification.settings.muskathlon.form</field>
    <field name="model">res.config.settings</field>
    <field name="priority" eval="25" />
    <field name="inherit_id" ref="message_center_compassion.compassion_settings" />
    <field name="arch" type="xml">
      <app name="compassion_settings">
        <separator />
        <block title="Muskathlon">
          <setting id="muskathlon_order_notify_id_setting">
            <field name="muskathlon_order_notify_id" />
          </setting>
        </block>
      </app>
    </field>
  </record>
</odoo>
