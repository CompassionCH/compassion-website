#. module: muskathlon
#: model:mail.template,body_html:muskathlon.ambassador_donation_confirmation_template
msgid ""
"<div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    % set invoice_lines = object.get_objects()\n"
"                    % set donations = invoice_lines.get_donations()\n"
"                    % set partner = object.partner_id\n"
"                    % set donors = invoice_lines.mapped('partner_id')\n"
"                    % set muskathlon = partner.registration_ids[:1]\n"
"                </div>\n"
"                <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    ${partner.salutation},\n"
"                    <br>\n"
"                    <br>\n"
"                    Compassion is glad to inform you that you just received a donation of ${object.user_id.company_id.currency_id.symbol} ${donations[0]}.-\n"
"                    % if donations[1]:\n"
"                        for the ${donations[1]}.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    % if len(donors) == 1:\n"
"                        Your donor is ${donors.preferred_name} from ${donors.city}.\n"
"                        % if donors.email and donors.thankyou_preference != 'none':\n"
"                    You can personally thank ${donors.get('him')} if you wish by sending ${donors.get('him')} an e-mail at <a href=\"mailto:${donors.email}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">${donors.email}</a>. In any case, ${donors.get('he')} will receive a thank you letter from us.\n"
"                        % endif\n"
"                    % else:\n"
"                        You received this from the following people. You may contact them by e-mail if you wish to thank them personally.\n"
"                        <ul style=\"margin:0px 0 1rem 0;\">\n"
"                            % for donor in donors:\n"
"                            <li>${donor.preferred_name} from ${donor.city} ${'(<a href=\"{}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">{}</a>)'.format(donor.email, donor.email) if donor.email and donor.thankyou_preference != 'none' else ''}</li>\n"
"                            % endfor\n"
"                        </ul>\n"
"                    % endif\n"
"                    % if muskathlon:\n"
"                        You currently have raised ${object.user_id.company_id.currency_id.symbol} ${muskathlon.amount_raised}.- You can check your barometer at anytime\n"
"                        <a href=\"${muskathlon.website_url}\" style=\"text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);\">on your sport profile page</a>.\n"
"                    % endif\n"
"                    <br>\n"
"                    <br>\n"
"                    Yours sincerely\n"
"                </div>\n"
"            "
msgstr ""
"<div>\n"
"    % set invoice_lines = object.get_objects()\n"
"    % set donations = invoice_lines.get_donations()\n"
"    % set partner = object.partner_id\n"
"    % set plural = partner.title.plural or partner.title.id == 29\n"
"    % set du = 'ihr' if plural else 'du'\n"
"    % set dir = 'euch' if plural else 'dir'\n"
"    % set dich = 'euch' if plural else 'dich'\n"
"    % set dein = 'euer' if plural else 'dein'\n"
"    % set deine = 'eure' if plural else 'deine'\n"
"    % set donors = invoice_lines.mapped('partner_id')\n"
"    % set muskathlon = partner.registration_ids[:1]\n"
"    % set url = 'http://www.muskathlon-philippinen.ch' + (muskathlon.website_url or '')\n"
"    % set amount_raised = '{:.0f}.-'.format(muskathlon.amount_raised or 0.0)\n"
"</div>\n"
"<p>\n"
"    ${partner.salutation}\n"
"</p>\n"
"<p>\n"
"    Wir freuen uns, ${dir} mitzuteilen, dass ${du} gerade eine Spende von ${donations[0]} erhalten ${\"habt\" if\n"
"    plural else \"hast\"}.\n"
"</p>\n"
"<p>\n"
"    % if len(donors) == 1:\n"
"        ${donors.preferred_name} aus ${donors.city} ${donors.get('has')} für ${dich} gespendet.\n"
"\n"
"        % if donors.email and donors.thankyou_letter != 'no':\n"
"            ${\"Ihr könnt\" if plural else \"Du kannst\"} ${donors.get('ihm')} persönlich danken (<a href=\"mailto:${donors.email}\">${donors.email}</a>). ${donors.get('he').title()} ${donors.get('will be')} auch von Compassion einen Dankesbrief erhalten.\n"
"        % endif\n"
"    % else:\n"
"<ul>\n"
"        % for donor in donors:\n"
"            % set email = donor.thankyou_letter != 'no' and donor.email\n"
"    <li>\n"
"            ${donor.preferred_name} aus ${donor.city}\n"
"            % if email:\n"
"                (<a href=\"mailto:${donor.email}\">${donor.email}</a>)\n"
"            % endif\n"
"    </li>\n"
"        % endfor\n"
"</ul>\n"
"    % endif\n"
"</p>\n"
"<p>\n"
"    ${\"Ihr habt\" if plural else \"Du hast\"} bereits CHF ${amount_raised} gesammelt. ${dein.title()} Barometer\n"
"    ${\"könnt ihr\" if plural else \"kannst du\"} jederzeit in\n"
"    <a href=\"${url}\">\n"
"        ${deine}m Profil einsehen.\n"
"    </a>\n"
"</p>\n"
"<p>\n"
"    Wir wünschen ${dir} alles Gute bei den weiteren Vorbereitungen und beim Training für den Muskathlon. Danke für\n"
"    ${deine}n extremen Einsatz gegen extreme Armut!\n"
"</p>\n"
"<p>\n"
"    Herzliche Grüsse vom Compassion Team\n"
"</p>"

