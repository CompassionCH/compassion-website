<odoo>
  <template
    id="my_event_include_forms"
    inherit_id="website_event_compassion.my_event_details"
  >
    <xpath expr="//div[@name='main_section']">
      <t t-call="muskathlon.flight_form" t-if="edit_mode=='flight'" />
      <t t-call="muskathlon.passport_form" t-if="edit_mode=='passport'" />
      <t t-call="muskathlon.criminal_form" t-if="edit_mode=='criminal'" />
    </xpath>
  </template>
  <template id="flight_form">
    <t
      t-set="outbound_flight"
      t-value="registration.flight_ids.filtered(lambda r: r.flight_type == 'outbound')"
    />
    <t
      t-set="return_flight"
      t-value="registration.flight_ids.filtered(lambda r: r.flight_type == 'return')"
    />
    <h3>Outbound flight</h3>
    <t t-call="muskathlon.flight_details">
      <t t-set="flight_type" t-value="'outbound'" />
      <t t-set="flight" t-value="outbound_flight" />
      <t t-set="other_flight" t-value="return_flight" />
    </t>
    <h3>Return flight</h3>
    <t t-call="muskathlon.flight_details">
      <t t-set="flight_type" t-value="'return'" />
      <t t-set="flight" t-value="return_flight" />
      <t t-set="other_flight" t-value="outbound_flight" />
    </t>
  </template>
  <!-- One flight: both are on the same page, their ids are named after the
       flight type. Back to this page until the other flight is given too. -->
  <template id="flight_details">
    <t t-set="form_id" t-value="'%s_flight_form' % flight_type" />
    <span
      class="hidden"
      t-att-data-for="form_id"
      t-att-data-values="{
                'registration_id': registration.id,
                'flight_type': flight_type,
                'flying_company': flight.flying_company,
                'flight_number': flight.flight_number,
                'departure': flight.get_date('departure', 'yyyy-MM-dd HH:mm:ss'),
                'arrival': flight.get_date('arrival', 'yyyy-MM-dd HH:mm:ss'),
                }"
    />
    <section
      class="s_website_form pt16 pb16 o_colored_level"
      data-vcss="001"
      data-snippet="s_website_form"
      data-name="Form"
    >
      <div class="container">
        <form
          action="/website/form/"
          t-att-id="form_id"
          method="post"
          enctype="multipart/form-data"
          class="o_mark_required"
          data-mark="*"
          data-success-mode="redirect"
          t-attf-data-success-page="/my/events/#{slug(registration)}#{'' if other_flight else '/flight'}"
          data-model_name="event.flight"
        >
          <div class="s_website_form_rows row s_col_no_bgcolor">
            <div
              class="form-group s_website_form_field col-12 s_website_form_dnone"
              data-type="selection"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flight_type"
                >
                  <span class="s_website_form_label_content">Flight type</span>
                </label>
                <div class="col-sm">
                  <input
                    type="hidden"
                    class="form-control s_website_form_input"
                    name="flight_type"
                    t-att-value="flight_type"
                    required="true"
                    t-attf-id="#{flight_type}_flight_type"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_dnone"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_registration_id"
                >
                  <span class="s_website_form_label_content">Registration</span>
                </label>
                <div class="col-sm">
                  <input
                    type="hidden"
                    class="form-control s_website_form_input"
                    name="registration_id"
                    t-att-value="registration.id"
                    required="true"
                    t-attf-id="#{flight_type}_registration_id"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_model_required"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flying_company"
                >
                  <span class="s_website_form_label_content">Flying company</span>
                  <span class="s_website_form_mark">*</span>
                </label>
                <div class="col-sm">
                  <input
                    type="text"
                    class="form-control s_website_form_input"
                    name="flying_company"
                    required="true"
                    t-attf-id="#{flight_type}_flying_company"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_model_required"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flight_number"
                >
                  <span class="s_website_form_label_content">Flight number</span>
                  <span class="s_website_form_mark">*</span>
                </label>
                <div class="col-sm">
                  <input
                    type="text"
                    class="form-control s_website_form_input"
                    name="flight_number"
                    required="true"
                    t-attf-id="#{flight_type}_flight_number"
                  />
                </div>
              </div>
            </div>
            <t t-foreach="['departure', 'arrival']" t-as="moment">
              <div
                class="form-group s_website_form_field col-12"
                data-type="datetime"
                data-name="Field"
              >
                <div class="row s_col_no_resize s_col_no_bgcolor">
                  <label
                    class="col-form-label col-sm-auto s_website_form_label"
                    style="width: 200px"
                    t-attf-for="#{flight_type}_#{moment}"
                  >
                    <span
                      class="s_website_form_label_content"
                      t-if="moment == 'departure'"
                    >Departure</span>
                    <span class="s_website_form_label_content" t-else="">Arrival</span>
                  </label>
                  <div class="col-sm">
                    <div
                      class="s_website_form_datetime input-group date"
                      t-attf-id="#{flight_type}_#{moment}_picker"
                      data-target-input="nearest"
                    >
                      <input
                        type="text"
                        class="form-control datetimepicker-input s_website_form_input"
                        t-attf-data-target="##{flight_type}_#{moment}_picker"
                        t-att-name="moment"
                        t-attf-id="#{flight_type}_#{moment}"
                      />
                      <div
                        class="input-group-append"
                        t-attf-data-target="##{flight_type}_#{moment}_picker"
                        data-toggle="datetimepicker"
                      >
                        <div class="input-group-text">
                          <i class="fa fa-calendar" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </t>
            <div
              class="form-group col-12 s_website_form_submit"
              data-name="Submit Button"
            >
              <div style="width: 200px;" class="s_website_form_label" />
              <a
                href="#"
                role="button"
                class="btn btn-primary btn-lg s_website_form_send o_default_snippet_text"
              >
                                Submit
                            </a>
              <span id="s_website_form_result" />
            </div>
          </div>
        </form>
      </div>
    </section>
  </template>
  <template id="passport_form">
