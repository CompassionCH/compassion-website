<odoo>
  <template
    id="my_event_include_forms"
    inherit_id="website_event_compassion.my_event_details"
  >
    <xpath expr="//div[@name='main_section']">
      <t t-call="muskathlon.flight_form" t-if="edit_mode=='flight'" />
      <t t-call="muskathlon.passport_form" t-if="edit_mode=='passport'" />
      <t t-call="muskathlon.criminal_form" t-if="edit_mode=='criminal'" />
    </xpath>
  </template>
  <!-- One page for the outbound flights and one for the return flights
       (flight_type): a journey with connections has several flights of each
       type, given one after the other. -->
  <template id="flight_form">
    <t
      t-set="flights"
      t-value="registration.flight_ids.filtered(lambda f: f.flight_type == flight_type)"
    />
    <h3 t-if="flight_type == 'return'">Return flight</h3>
    <h3 t-else="">Outbound flight</h3>
    <p>
      If your journey has connections, add each flight one after the other.
    </p>
    <div t-if="flights" class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Flying company</th>
            <th>Flight number</th>
            <th>Departure</th>
            <th>Arrival</th>
            <th />
          </tr>
        </thead>
        <tbody>
          <tr t-foreach="flights" t-as="flight">
            <td t-out="flight.flying_company" />
            <td t-out="flight.flight_number" />
            <td>
              <span t-field="flight.departure" />
            </td>
            <td>
              <span t-field="flight.arrival" />
            </td>
            <td class="text-end">
              <form t-attf-action="/my/events/flight/#{flight.id}/remove" method="post">
                <input
                  type="hidden"
                  name="csrf_token"
                  t-att-value="request.csrf_token()"
                />
                <button type="submit" class="btn btn-link text-danger p-0">
                  <i class="fa fa-trash-o" /> Remove
                </button>
              </form>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <h4 t-if="flights">Add a connection flight</h4>
    <h4 t-else="">Add a flight</h4>
    <t t-call="muskathlon.flight_details" />
    <a
      t-attf-href="/my/events/#{slug(registration)}"
      class="btn btn-secondary"
    >Back to my registration</a>
  </template>
  <!-- The form adding one flight of flight_type. Back to the same page
       afterwards, for the next connection. -->
  <template id="flight_details">
    <t t-set="form_id" t-value="'%s_flight_form' % flight_type" />
    <section
      class="s_website_form pt16 pb16 o_colored_level"
      data-vcss="001"
      data-snippet="s_website_form"
      data-name="Form"
    >
      <div class="container">
        <!-- The website form posts to action + force_action. The slash
             goes with force_action: in another language than the default
             one, the action gets a /fr_CH-like prefix and loses its
             trailing slash. -->
        <form
          action="/my/events/form"
          t-att-id="form_id"
          method="post"
          enctype="multipart/form-data"
          class="o_mark_required"
          data-mark="*"
          data-success-mode="redirect"
          t-attf-data-success-page="/my/events/#{slug(registration)}/flight/#{flight_type}"
          data-model_name="event.flight"
          data-force_action="/flight"
        >
          <div class="s_website_form_rows row s_col_no_bgcolor">
            <div
              class="form-group s_website_form_field col-12 s_website_form_dnone"
              data-type="selection"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flight_type"
                >
                  <span class="s_website_form_label_content">Flight type</span>
                </label>
                <div class="col-sm">
                  <input
                    type="hidden"
                    class="form-control s_website_form_input"
                    name="flight_type"
                    t-att-value="flight_type"
                    required="true"
                    t-attf-id="#{flight_type}_flight_type"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_dnone"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_registration_id"
                >
                  <span class="s_website_form_label_content">Registration</span>
                </label>
                <div class="col-sm">
                  <input
                    type="hidden"
                    class="form-control s_website_form_input"
                    name="registration_id"
                    t-att-value="registration.id"
                    required="true"
                    t-attf-id="#{flight_type}_registration_id"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_model_required"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flying_company"
                >
                  <span class="s_website_form_label_content">Flying company</span>
                  <span class="s_website_form_mark">*</span>
                </label>
                <div class="col-sm">
                  <input
                    type="text"
                    class="form-control s_website_form_input"
                    name="flying_company"
                    required="true"
                    t-attf-id="#{flight_type}_flying_company"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_model_required"
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label"
                  style="width: 200px"
                  t-attf-for="#{flight_type}_flight_number"
                >
                  <span class="s_website_form_label_content">Flight number</span>
                  <span class="s_website_form_mark">*</span>
                </label>
                <div class="col-sm">
                  <input
                    type="text"
                    class="form-control s_website_form_input"
                    name="flight_number"
                    required="true"
                    t-attf-id="#{flight_type}_flight_number"
                  />
                </div>
              </div>
            </div>
            <t t-foreach="['departure', 'arrival']" t-as="moment">
              <div
                class="form-group s_website_form_field col-12"
                data-type="datetime"
                data-name="Field"
              >
                <div class="row s_col_no_resize s_col_no_bgcolor">
                  <label
                    class="col-form-label col-sm-auto s_website_form_label"
                    style="width: 200px"
                    t-attf-for="#{flight_type}_#{moment}"
                  >
                    <span
                      class="s_website_form_label_content"
                      t-if="moment == 'departure'"
                    >Departure</span>
                    <span class="s_website_form_label_content" t-else="">Arrival</span>
                  </label>
                  <div class="col-sm">
                    <div
                      class="s_website_form_datetime input-group date"
                      t-attf-id="#{flight_type}_#{moment}_picker"
                      data-target-input="nearest"
                    >
                      <input
                        type="text"
                        class="form-control datetimepicker-input s_website_form_input"
                        t-attf-data-target="##{flight_type}_#{moment}_picker"
                        t-att-name="moment"
                        t-attf-id="#{flight_type}_#{moment}"
                      />
                      <div
                        class="input-group-append"
                        t-attf-data-target="##{flight_type}_#{moment}_picker"
                        data-toggle="datetimepicker"
                      >
                        <div class="input-group-text">
                          <i class="fa fa-calendar" />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </t>
            <div
              class="form-group col-12 s_website_form_submit"
              data-name="Submit Button"
            >
              <div style="width: 200px;" class="s_website_form_label" />
              <a
                href="#"
                role="button"
                class="btn btn-primary btn-lg s_website_form_send o_default_snippet_text"
              >
                                Add this flight
                            </a>
              <span id="s_website_form_result" />
            </div>
          </div>
        </form>
      </div>
    </section>
  </template>
  <template id="passport_form">
    <span
      id="form_values"
      class="hidden"
      data-for="event_registration_form"
      t-att-data-values="{'registration_id': registration.id}"
    />
    <h3>Passport</h3>
    <section
      class="s_website_form pt16 pb16 o_colored_level"
      data-vcss="001"
      data-snippet="s_website_form"
      data-name="Form"
    >
      <div class="container">
        <form
          id="event_registration_form"
          action="/my/events/form"
          method="post"
          enctype="multipart/form-data"
          class="o_mark_required"
          data-mark="*"
          data-success-mode="redirect"
          t-attf-data-success-page="/my/events/#{slug(registration)}"
          data-model_name="event.registration.form"
          data-force_action="/registration_edit"
        >
          <div class="s_website_form_rows row s_col_no_bgcolor">
            <div
              class="form-group s_website_form_field col-12    "
              data-type="binary"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-sm-auto s_website_form_label"
                  style="width: 200px"
                  for="oo6z1lsyc1z"
                >
                  <span class="s_website_form_label_content">Passport Scan:</span>
                </label>
                <div class="col-sm">
                  <input
                    type="file"
                    class="form-control-file s_website_form_input"
                    name="passport"
                    id="oo6z1lsyc1z"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12 s_website_form_dnone  "
              data-type="char"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label "
                  style="width: 200px"
                  for="oh4y43y9th2l"
                >
                  <span class="s_website_form_label_content">Registration</span>
                  <span class="s_website_form_mark">*</span>
                </label>
                <div class="col-sm">
                  <input
                    type="hidden"
                    class="form-control s_website_form_input"
                    name="registration_id"
                    required="true"
                    id="oh4y43y9th2l"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group s_website_form_field col-12    "
              data-type="text"
              data-name="Field"
            >
              <div class="row s_col_no_resize s_col_no_bgcolor">
                <label
                  class="col-form-label col-sm-auto s_website_form_label "
                  style="width: 200px"
                  for="opesesohl01f"
                >
                  <span class="s_website_form_label_content">Comments</span>
                </label>
                <div class="col-sm">
                  <textarea
                    class="form-control s_website_form_input"
                    name="comments"
                    id="opesesohl01f"
                    rows="3"
                  />
                </div>
              </div>
            </div>
            <div
              class="form-group col-12 s_website_form_submit"
              data-name="Submit Button"
            >
              <div style="width: 200px;" class="s_website_form_label" />
              <a
                href="#"
                role="button"
                class="btn btn-primary btn-lg s_website_form_send o_default_snippet_text"
              >
                                Submit
                            </a>
              <span id="s_website_form_result" />
            </div>
          </div>
        </form>
      </div>
    </section>
  </template>
  <template id="criminal_form">
    <span
