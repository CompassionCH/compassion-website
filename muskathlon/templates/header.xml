<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="muskathlon_hide_header_cart" inherit_id="website_sale.header_cart_link">
            <xpath expr="//t[@t-set='show_cart']" position="after">
                <t t-if="website and website.sudo().theme_id and website.sudo().theme_id.name == 'theme_muskathlon'">
                    <t t-set="show_cart" t-value="False" />
                </t>
            </xpath>
        </template>
    </data>
</odoo>
