<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="muskathlon_registration_notification_view" model="ir.ui.view">
            <field name="name">muskathlon.registration.notification.view</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <div>
                    <p>A new participant has registered for the Muskathlon!</p>
                    <p>Here are the registration details:</p>
                    <ul>
                        <li><strong>Name:</strong> <t t-esc="object.partner_id.name"/></li>
                        <li><strong>Email:</strong> <t t-esc="object.partner_id.email"/></li>
                        <li><strong>Phone:</strong> <t t-esc="object.partner_id.phone"/></li>
                        <li><strong>Mobile:</strong> <t t-esc="object.partner_id.mobile"/></li>
                        <li><strong>Date of Birth:</strong> <t t-esc="object.partner_id.birthdate_date"/></li>
                        <li><strong>Address:</strong>
                            <t t-esc="object.partner_id.street"/>,
                            <t t-esc="object.partner_id.zip"/> <t t-esc="object.partner_id.city"/>
                        </li>
                        <li><strong>T-Shirt Size:</strong> <t t-esc="dict(object.fields_get(['t_shirt_size'])['t_shirt_size']['selection']).get(object.t_shirt_size, '')"/></li>
                        <li><strong>Sport Discipline:</strong> <t t-esc="object.sport_discipline_id.name"/></li>
                        <li><strong>Sport Level:</strong> <t t-esc="dict(object.fields_get(['sport_level'])['sport_level']['selection']).get(object.sport_level, '')"/></li>
                        <li t-if="object.sport_level_description"><strong>Sport Description:</strong> <t t-esc="object.sport_level_description"/></li>
                    </ul>
                </div>
            </field>
        </record>
    </data>
</odoo>