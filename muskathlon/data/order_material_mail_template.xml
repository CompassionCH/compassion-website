<odoo>
  <record id="order_material_mail_template" model="mail.template">
    <field name="name">Order material: Muskathlon template</field>
    <field name="model_id" ref="crm.model_crm_lead" />
    <field name="email_from">info@compassion.ch</field>
    <field name="email_to">{{ object.user_id.email }}</field>
    <field
      name="subject"
    >{{ object.partner_id.name }} has made an order for {{ object.event_ids.name }}</field>
    <field name="body_html" type="html">
      <p>
                Hello <t t-out="object.user_id.partner_id.preferred_name" />
                <br />
                <br />
                <a
        t-attf-href="/web#id={{ object.partner_id.id }}&amp;model=res.partner&amp;view_type=form"
        style="text-decoration:none;background-color:transparent;color:rgb(124, 123, 173);"
      >
        <t t-out="object.partner_id.name" />
      </a> &lt;<t t-out="object.partner_id.email" />&gt; ordered :
                <br />
                <t t-out="object.description" />
                <br />
                Adress :
                <br />
                <t t-out="object.partner_id.street" /> <br />
                <t t-out="object.partner_id.zip" /> <t t-out="object.partner_id.city" />
                <t t-out="object.partner_id.country_id.name" />
                The profile picture of the participant is in the attachment files, in case you need it.
                <br />
                <br />
                Thank you
            </p>
    </field>
  </record>
</odoo>
