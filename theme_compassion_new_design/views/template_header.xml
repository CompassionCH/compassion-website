<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
    <template
    id="template_header_default"
    inherit_id="website.template_header_default"
  >
        <!-- Move the hamburger menu to the left -->
        <xpath
      expr="//t[@t-call='website.navbar_toggler']"
      position="replace"
    />
        <xpath
      expr="//t[@t-call='website.placeholder_header_brand']"
      position="before"
    >
            <t t-call="website.navbar_toggler">
                <t t-set="_toggler_class" t-value="'mr-4 text-primary'" />
            </t>
        </xpath>
        <!-- Improve the layout of the navbar and add the svg -->
        <xpath expr="//t[@t-set='_nav_class']" position="attributes">
            <attribute
        name="t-value"
      >'flex-grow-1 align-items-left align-items-lg-center border-thread-right'</attribute>
        </xpath>
        <!-- Add a linebreak with colors after the navbar -->
        <xpath expr="//nav[@data-name='Navbar']" position="after">
            <div style="height: 6px" class="d-flex">
                <div class="h-100 w-25 bg-primary" />
                <div class="h-100 w-25 bg-secondary" />
                <div class="h-100 w-25 bg-o-color-3" />
                <div class="h-100 w-25 bg-o-color-5" />
            </div>
        </xpath>
        <!-- Make the main menu in the center -->
        <xpath expr="//div[@id='top_menu_collapse']" position="after">
            <div class="flex-grow-1" />
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse']" position="before">
            <div class="flex-grow-1" />
        </xpath>

        <!-- Move the login button out of the main menu and adapt its style -->
        <xpath
      expr="//t[@t-call='portal.placeholder_user_sign_in']"
      position="replace"
    />
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="replace" />
        <xpath
      expr="//t[@t-call='website.placeholder_header_language_selector']"
      position="before"
    >
            <t t-call="portal.user_dropdown">
                <t t-set="_avatar" t-value="true" />
                <t t-set="_avatar_class" t-value="'border border-secondary'" />
                <t t-set="_item_class" t-value="'nav-item dropdown ml-lg-4'" />
                <t t-set="_link_class" t-value="'nav-link font-weight-bold'" />
            </t>
            <a
        href="/web/login?redirect=/my2/children"
        class="btn btn-sm btn-outline-primary dropdown-toggle"
        role="button"
        groups="base.group_public"
      >
                <i class="fa fa-user align-middle mr-2" />
                <span class="align-middle d-none d-sm-inline">Sign in</span>
            </a>
        </xpath>

    </template>

    <!-- Remove the contact us button from the header -->
    <template
    id="header_contactus"
    inherit_id="website.template_header_default_oe_structure_header_default_1"
  >
        <xpath
      expr="//div[@id='oe_structure_header_default_1']"
      position="replace"
    />
    </template>

    <!-- Improve the language selector in the header -->
    <template id="language_selector" inherit_id="portal.language_selector">
        <xpath expr="//button" position="attributes">
            <attribute
        name="class"
      >btn btn-sm btn-outline-primary dropdown-toggle</attribute>
        </xpath>
        <xpath expr="//button/span" position="before">
            <i class="fa fa-globe align-middle" />
        </xpath>
        <xpath expr="//button/span" position="attributes">
            <attribute name="class">align-middle d-none d-sm-inline</attribute>
        </xpath>
    </template>

    <!-- Improve the user dropdown in the header -->
    <template id="user_dropdown" inherit_id="portal.user_dropdown">
        <xpath expr="//img" position="attributes">
            <attribute name="width">48</attribute>
            <attribute name="height">48</attribute>
        </xpath>
        <xpath expr="//li[@t-if='is_connected']" position="attributes">
            <attribute
        name="t-attf-class"
      >#{_item_class} list-unstyled</attribute>
        </xpath>
    </template>
</odoo>
