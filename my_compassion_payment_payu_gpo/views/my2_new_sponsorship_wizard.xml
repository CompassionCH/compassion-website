<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <!-- The name on the card is asked with the e-mail, before the payment
       page: its card form then asks only the card. -->
  <template
    id="my2_new_sponsorship_wizard_fast_checkout"
    inherit_id="my_compassion.my2_new_sponsorship_wizard_fast_checkout"
  >
    <xpath expr="//input[@id='email']/.." position="after">
      <t
        t-if="wizard._my2_asks_cardholder_name()"
        t-call="theme_compassion_2025.FormFieldComponent"
      >
        <t t-set="top_class" t-value="'my-3'" />
        <t t-set="label">Name on card</t>
        <t t-set="input_id" t-value="'cardholder_name'" />
        <input
          id="cardholder_name"
          type="text"
          name="cardholder_name"
          class="form-control"
          autocomplete="cc-name"
          maxlength="100"
          t-att-value="wizard.cardholder_name"
          required=""
        />
      </t>
    </xpath>
  </template>
</odoo>
