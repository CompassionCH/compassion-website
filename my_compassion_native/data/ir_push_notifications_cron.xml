<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_birthday_push_notifications" model="ir.cron">
            <field name="name">Daily: Send Child Birthday Push Notifications</field>
            <field name="model_id" ref="model_compassion_child" />
            <field name="state">code</field>
            <field name="code">model._cron_send_birthday_push_notifications()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False" />
            <field
                name="nextcall"
                eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 10:00:00')"
            />
        </record>
    </data>
</odoo>
