<?xml version="1.0" encoding="utf-8" ?>
<!-- oca-hooks:disable=xml-dangerous-qweb-replace-low-priority -->
<odoo>
  <template id="capacitor_viewport_fix" inherit_id="web.layout">
    <xpath expr="//meta[@name='viewport']" position="attributes">
      <attribute name="class">d-none</attribute>
    </xpath>
    <xpath expr="//meta[@name='viewport']" position="after">
      <meta
        name="viewport"
        content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover"
      />
    </xpath>
  </template>
</odoo>
