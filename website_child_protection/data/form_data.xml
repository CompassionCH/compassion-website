<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="model_cms_form_partner_child_protection_charter" model="ir.model">
    <field name="website_form_key">
          child_protection
      </field>
    <field name="website_form_access">
          True
      </field>
    <field name="website_form_label">
          Agree the child protection charter
      </field>
  </record>
  <function model="ir.model.fields" name="formbuilder_whitelist">
    <value>cms.form.partner.child.protection.charter</value>
    <value
      eval="[
            'read_check',
            'validation_check',
            'legal_check',
            'understand_check',
            'partner_uuid',
            ]"
    />
  </function>
</odoo>
