#. module: website_child_protection
#: model_terms:ir.ui.view,arch_db:website_child_protection.child_protection_charter_confirmation_page
msgid "Child Protection Charter"
msgstr "Erklæring om barns beskyttelse"

#. module: website_child_protection
#: model_terms:ir.ui.view,arch_db:website_child_protection.child_protection_charter_text
msgid ""
"Child and Youth Protection Standards: These are the\n"
"                behaviors that are expected toward all children and youth,\n"
"                regardless of their affiliation with programming or status as a\n"
"                participant."
msgstr ""
"Standarder for beskyttelse av barn og unge: Dette er den atferden som "
"forventes overfor alle barn og unge, uavhengig av deres tilknytning til "
"programmet eller deres status som deltaker."

#. module: website_child_protection
#: model:ir.model,name:website_child_protection.model_cms_form_partner_child_protection_charter
msgid "Child protection charter form"
msgstr "Skjema for erklæring om barns beskyttelse"

#. module: website_child_protection
#: model_terms:ir.ui.view,arch_db:website_child_protection.child_protection_charter_text
msgid ""
"Code of Conduct for Child and Youth Protection and\n"
"                Safeguarding"
msgstr "Etiske retningslinjer for beskyttelse og trygghet for barn og unge"

#. module: website_child_protection
#: model_terms:ir.ui.view,arch_db:website_child_protection.child_protection_charter_confirmation_page
msgid "Continue"
msgstr "Fortsett"

#. module: website_child_protection
#: model:ir.model.fields,field_description:website_child_protection.field_cms_form_partner_child_protection_charter__create_uid
msgid "Created by"
msgstr "Opprettet av"

